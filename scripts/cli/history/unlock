#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt history unlock — clear a stale in-progress transaction from .tt/history
#                     WITHOUT reverting the repository state.
#
# Usage:
#   tt history unlock [--force] [--repo PATH]
#
# Options:
#   --force   Required if the history is mid-transaction or a history lock
#             (.tt/history.lock) was left behind. Without it, exits 1.
#   --repo    Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#
# With --force, a leftover history lock is removed rather than waited for: this
# command is how a lock abandoned by a killed process is cleared.
#
# If there is no in-progress transaction, exits silently with code 0 (no-op).
# If the history file does not exist, exits 1 with an error message.
# If the history file is empty, exits silently with code 0 (no-op).
#
# When --force is given and there is an in-progress transaction, the last history
# line is completed by writing the current operation ID as the after-op-id, producing:
#   <before-op-id>:<current-op-id>
# This leaves the repository state unchanged.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: tt history unlock [--force] [--repo PATH]

Clear a stale in-progress transaction from .tt/history without reverting
the repository. Use this when a tt process crashed mid-transaction and
the repository is already in an acceptable state.

If there is no in-progress transaction, this command exits 0 silently (no-op).

A history lock (.tt/history.lock) left behind by a killed tt process blocks
every later command. With --force it is removed; without, it is reported.

To revert the repository to the state before the crashed command instead,
use: tt history undo --force

Options:
  --force   Required to clear an in-progress transaction or a leftover
            history lock. Without it, exits 1 if either is present.
  --repo    Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

Examples:
  tt history unlock           # check for stale lock (no-op if clean)
  tt history unlock --force   # clear stale in-progress transaction and lock

EOF
}

main() {
  local force=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)
        force=true
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        usage >&2; exit 1
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local history_file history_lock
  history_file="$(_history__resolve_file "$repo")" || exit 1
  history_lock="$(_history__resolve_lock "$repo")" || exit 1

  # History file must exist (workspace must be initialized)
  if [[ ! -f "$history_file" ]]; then
    _ui__log "Error: History file not found: $history_file"
    _ui__log "  Has the workspace been initialized? Run: tt workspace init"
    exit 1
  fi

  # A leftover lock is removed rather than waited for: waiting on it would
  # time out, and clearing it is what this command is for.
  if [[ -e "$history_lock" ]]; then
    if [[ "$force" != true ]]; then
      _ui__log "Error: History lock present: $history_lock"
      _ui__log "  Another tt command may be running, or a killed one left it behind."
      _ui__log "  Use --force to remove it."
      exit 1
    fi
    _history__release_lock "$history_lock"
    _ui__log "Removed leftover history lock: $history_lock"
  fi

  _history__acquire_lock "$history_lock" || exit 1
  trap '_history__release_lock "'"$history_lock"'"' EXIT

  # Empty history → nothing to unlock
  if [[ ! -s "$history_file" ]]; then
    exit 0
  fi

  # Read last line
  local last_line
  last_line="$(tail -n 1 "$history_file")"
  if [[ -z "$last_line" ]]; then
    exit 0
  fi

  local before_op after_op
  before_op="${last_line%%:*}"
  after_op="${last_line#*:}"

  # No in-progress transaction → silent no-op
  if [[ -n "$after_op" ]]; then
    exit 0
  fi

  # In-progress transaction detected
  if [[ "$force" != true ]]; then
    _ui__log "Error: In-progress transaction detected."
    _ui__log "  before-op: ${before_op:0:12}..."
    _ui__log "  This may indicate a crashed or killed tt process."
    _ui__log "  Use --force to clear the lock (keeps the current repository state)."
    _ui__log "  Use 'tt history undo --force' to revert to the pre-transaction state."
    exit 1
  fi

  # --force: complete the transaction entry by writing the current op as after-op
  local current_op
  current_op="$(_history__resolve_operation "$repo")" || {
    _ui__log "Error: Could not read the current operation ID."
    exit 1
  }

  if [[ "$(uname)" == "Darwin" ]]; then
    sed -i '' "$ s|^${before_op}:\$|${before_op}:${current_op}|" "$history_file"
  else
    sed -i "$ s|^${before_op}:\$|${before_op}:${current_op}|" "$history_file"
  fi

  _ui__log "Unlocked: in-progress transaction cleared (history marked complete)."
  _ui__log "  Repository state is unchanged."
  _ui__log "  Transaction entry: ${before_op:0:12}:${current_op:0:12}..."
}

main "$@"
