#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt history undo — revert the jj repository to the state before the last mutating tt command.
#
# Usage:
#   history undo [--force] [--repo PATH]
#
# Options:
#   --force   Bypass safety checks (in-progress transactions, op ID mismatch,
#             dirty working copy).
#   --repo    Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#
# The transaction history is stored in .tt/history as lines of:
#   <before-op-id>:<after-op-id>
# An in-progress transaction (crashed/killed command) has an empty after-op-id.
#
# Before undoing, the current outgoing jj operation ID is logged so the user
# can manually restore it with: jj op restore <operation-id>

readonly SCRIPT_NAME="${0##*/}"

usage() {
  local exit_code="${1:-1}"
  if [[ "$exit_code" -eq 0 ]]; then
    cat <<EOF
Usage: tt history undo [--force] [--repo PATH]

Undo the most recent mutating tt command by restoring the jj repository
to the operation state before that command ran.

Multiple invocations go further back in history. There is no redo command;
the outgoing operation ID is logged so you can manually restore it with:
  jj op restore <operation-id>

Options:
  --force   Bypass safety checks:
              - in-progress (stale) transaction lock
              - jj operation ID mismatch (repo modified outside tt)
              - dirty working copy
  --repo    Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

Examples:
  tt history undo           # undo last tt command
  tt undo                   # same (alias)
  tt history undo --force   # force-undo even if op ID mismatches or WC is dirty

EOF
  else
    cat >&2 <<EOF
Usage: tt history undo [--force] [--repo PATH]

Undo the most recent mutating tt command by restoring the jj repository
to the operation state before that command ran.

Options:
  --force   Bypass safety checks (stale lock, op ID mismatch, dirty WC).
  --repo    Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

EOF
  fi
  exit "$exit_code"
}

main() {
  local force=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)
        force=true
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { log "Error: --repo requires an argument"; usage; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage 0
        ;;
      -*)
        log "Error: Unknown option: $1"
        usage
        ;;
      *)
        log "Error: Unexpected argument: $1"
        usage
        ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local history_file="$repo/.tt/history"

  # Check history file exists and has at least one entry
  if [[ ! -f "$history_file" ]] || [[ ! -s "$history_file" ]]; then
    log "Nothing to undo: tt history is empty."
    exit 1
  fi

  # Read last line
  local last_line
  last_line="$(tail -n 1 "$history_file")"
  if [[ -z "$last_line" ]]; then
    log "Nothing to undo: tt history is empty."
    exit 1
  fi

  local before_op after_op
  before_op="${last_line%%:*}"
  after_op="${last_line#*:}"

  # Validate before_op is non-empty
  if [[ -z "$before_op" ]]; then
    log "Error: Malformed history entry: '$last_line'"
    exit 1
  fi

  # Check for in-progress transaction (empty after-op-id)
  local in_progress=false
  if [[ -z "$after_op" ]]; then
    in_progress=true
    if [[ "$force" != true ]]; then
      log "Error: A tt command is currently in progress (incomplete transaction)."
      log "  before-op: ${before_op:0:12}..."
      log "  This may indicate a crashed or killed tt process."
      log "  Use --force to forcibly revert this in-progress transaction."
      exit 1
    fi
    log "Warning: Reverting in-progress transaction (--force)."
  fi

  # Check current jj op matches expected after-op (only for completed transactions)
  if [[ "$in_progress" != true && "$force" != true ]]; then
    local current_op
    current_op="$(jj -R "$repo" op log --no-graph -T id -n 1 2>/dev/null)" || {
      log "Error: Could not read current jj operation ID."
      exit 1
    }
    if [[ "$current_op" != "$after_op" ]]; then
      log "Error: Repository has been modified outside of tt since the last recorded command."
      log "  Expected operation: ${after_op:0:12}..."
      log "  Current operation:  ${current_op:0:12}..."
      log "  Use --force to undo anyway (may lose intermediate changes)."
      exit 1
    fi
  fi

  # Check working copy is clean
  if [[ "$force" != true ]]; then
    if ! is_wc_clean "$repo"; then
      log "Error: Working copy has uncommitted changes."
      log "  Commit or discard changes first, or use --force."
      exit 1
    fi
  fi

  # Log the outgoing operation ID for manual redo
  if [[ "$in_progress" != true && -n "$after_op" ]]; then
    log "Outgoing jj operation (to redo manually):"
    log "  jj op restore $after_op"
  fi

  # Capture current op ID for safety trap (in case jj op restore itself fails)
  local pre_undo_op
  pre_undo_op="$(jj -R "$repo" op log --no-graph -T id -n 1 2>/dev/null)" || pre_undo_op=""

  # Set safety trap: if the undo itself fails, restore back to where we were
  # (history line is NOT removed until after successful restore)
  if [[ -n "$pre_undo_op" ]]; then
    trap 'log "Error: undo failed; restoring to pre-undo state"; jj -R "'"$repo"'" op restore "'"$pre_undo_op"'" 2>/dev/null || true' ERR
  fi

  # Restore jj to before-op state (pop history line only after success)
  jj -R "$repo" op restore "$before_op"

  # Pop the last line from the history file (only reached on success)
  if [[ "$(uname)" == "Darwin" ]]; then
    sed -i '' '$ d' "$history_file"
  else
    sed -i '$ d' "$history_file"
  fi

  # Patch the now-last history entry's after-op to the current (post-restore) jj op.
  #
  # Why: `jj op restore` creates a NEW operation — the repo state matches the
  # target, but the operation ID differs. Without this patch the history chain
  # breaks (the now-last entry's after-op still points to the *original* op,
  # not the restore op), so a subsequent `tt undo` would fail its safety check.
  if [[ -f "$history_file" && -s "$history_file" ]]; then
    local new_current_op
    new_current_op="$(jj -R "$repo" op log --no-graph -T id -n 1 2>/dev/null)" || true
    if [[ -n "$new_current_op" ]]; then
      local prev_line
      prev_line="$(tail -n 1 "$history_file")"
      if [[ -n "$prev_line" ]]; then
        local prev_before="${prev_line%%:*}"
        local prev_after="${prev_line#*:}"
        if [[ -n "$prev_after" && "$prev_after" != "$new_current_op" ]]; then
          if [[ "$(uname)" == "Darwin" ]]; then
            sed -i '' "$ s|^${prev_before}:${prev_after}\$|${prev_before}:${new_current_op}|" "$history_file"
          else
            sed -i "$ s|^${prev_before}:${prev_after}\$|${prev_before}:${new_current_op}|" "$history_file"
          fi
        fi
      fi
    fi
  fi

  trap - ERR

  log "Undone: jj repository restored to operation ${before_op:0:12}..."
}

main "$@"
