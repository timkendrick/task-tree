#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt worktree list — List all worktrees and their corresponding tt task IDs.
# The canonical repository is not a worktree and is not listed.
#
# Usage:
#   list [--task <task-id>] [--quiet] [--repo PATH]
#
# Options:
#   --task <task-id>  Filter to worktrees matching the given task or project ID.
#   --quiet           Machine-readable: print worktree names only, one per line.
#   --repo PATH       Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   -h, --help        Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--task <task-id>] [--quiet] [--repo PATH]

List all worktrees of the current repository and their corresponding
tt task or project IDs. The canonical repository is not a worktree and is
not listed.

Output columns:
  (marker)  *  marks the current worktree
  NAME      worktree name
  TASK ID   tt task or project ID checked out in the worktree, or (none)
  PATH      filesystem path to the worktree root (~-abbreviated), or (none)

Options:
  --task <task-id>  Filter to only worktrees whose TASK ID matches <task-id>
  --quiet           Print worktree names only (one per line); no header or table
  --repo PATH       Repository root (overrides TT_REPO; default: walk up from CWD to find .jj)
  -h, --help        Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}
  ${COMMAND_NAME:-$SCRIPT_NAME} --task task/foo-abc12345
  ${COMMAND_NAME:-$SCRIPT_NAME} --task task/foo-abc12345 --quiet
  ${COMMAND_NAME:-$SCRIPT_NAME} --repo /path/to/repo

EOF
}

main() {
  local repo=''
  local task_filter=''
  local quiet=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_filter="$2"; shift 2 ;;
      --quiet)
        quiet=true; shift ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Validate --task filter if provided
  if [[ -n "$task_filter" ]]; then
    if ! _task__check_is_task_branch "$task_filter" "$task_prefix" && \
       ! _task__check_is_project_branch "$task_filter" "$project_prefix"; then
      _ui__log "Error: '$task_filter' is not a recognized task or project ID"
      _ui__log "  Expected prefix '$task_prefix' or '$project_prefix' with 8-hex suffix"
      exit 1
    fi
  fi

  # Determine current worktree root (to mark with *)
  local current_ws_root
  current_ws_root="$(_worktree__resolve_current "$repo")" || current_ws_root=""

  local ws_data
  ws_data="$(_worktree__list "$repo")" || ws_data=''

  local rows=''
  local names=''
  while IFS=$'\t' read -r ws_name ws_path task_id; do
    [[ -z "$ws_name" ]] && continue

    if [[ -z "$ws_path" ]]; then
      ws_path='(none)'
    fi

    if [[ -z "$task_id" ]]; then
      task_id='(none)'
    fi

    if [[ -n "$task_filter" && "$task_id" != "$task_filter" ]]; then
      continue
    fi

    local display_path="$ws_path"
    if [[ "$ws_path" != '(none)' ]]; then
      display_path="${ws_path/#$HOME/~}"
    fi

    local flag=''
    if [[ -n "$current_ws_root" && "$ws_path" == "$current_ws_root" ]]; then
      flag='*'
    fi

    names+="$ws_name"$'\n'
    rows+="$flag"$'\t'"$ws_name"$'\t'"$task_id"$'\t'"$display_path"$'\n'
  done <<< "$ws_data"

  if [[ "$quiet" == true ]]; then
    printf '%s' "$names"
    return 0
  fi

  printf '\tNAME\tTASK ID\tPATH\n%s' "$rows" | _format__table --marker
}

main "$@"
