#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt worktree show — Output the path of the named dedicated worktree
#
# This is a subcommand in the worktree namespace, so the usage examples
# should show the full command path (tt worktree show), not just show.
#
# Usage:
#   tt worktree show --name <worktree-name> [--repo PATH]
#
# Options:
#   --name <worktree-name>  worktree name
#   --repo PATH             Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   -h, --help              Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} --name <worktree-name> [--repo PATH]

Output the path of the named dedicated worktree.

Options:
  --name <worktree-name>  wortree name (required)
  --repo PATH             Repository root (overrides TT_REPO; default: walk up from CWD to find .jj)
  -h, --help              Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} --name task/foo-abc12345
  ${COMMAND_NAME:-$SCRIPT_NAME} --name project/bar-def12345

EOF
}

main() {
  local name=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        name="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  if [[ -z "$name" ]]; then
    usage >&2; exit 1
  fi

  repo="$(resolve_repo "$repo")"

  local ws_path
  if ! ws_path="$(resolve_workspace_path "$repo" "$name")"; then
    log "Error: No worktree named '$name'"
    exit 1
  fi

  # An unusable path must be rejected before the repository root comparison:
  # resolve_path_symlinks cd's into the path, so it fails on a missing directory.
  if [[ -z "$ws_path" || ! -d "$ws_path" ]]; then
    log "Error: Worktree '$name' has an invalid path"
    exit 1
  fi
  ws_path="$(resolve_path_symlinks "$ws_path")"

  # $repo is whichever workspace resolve_repo landed on, which is NOT necessarily
  # the canonical repo: invoked from inside a dedicated worktree without TT_REPO
  # set, find_repo_root walks up to the worktree's own .jj and returns the
  # worktree. Resolve to the canonical repo before comparing.
  local canonical_repo
  if ! canonical_repo="$(resolve_canonical_repo_path "$repo")"; then
    log "Error: Could not resolve the repository root for '$repo'"
    exit 1
  fi

  if [[ "$ws_path" == "$canonical_repo" ]]; then
    log "Error: Worktree '$name' is the repository root, not a dedicated worktree"
    exit 1
  fi

  printf '%s\n' "$ws_path"
}

main "$@"
