#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt worktree show — Output the dedicated worktree path for a given task/project ID.
#
# Only dedicated worktrees are reported: if the task has no dedicated worktree
# (including when it is checked out in the main workspace), this exits 1.
#
# This is a subcommand in the worktree namespace, so the usage examples
# should show the full command path (tt worktree show), not just show.
#
# Usage:
#   tt worktree show --task <task-id> [--repo PATH]
#
# Options:
#   --task <task-id>   Task or project branch name (e.g., task/foo-abc12345, project/bar-def12345)
#   --repo PATH        Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   -h, --help         Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} --task <task-id> [--repo PATH]

Output the dedicated worktree path for the given task or project ID.
Exits with an error if the task has no dedicated worktree, including when the
task is checked out in the main workspace.

Options:
  --task <task-id>  Task or project ID (e.g., task/foo-abc12345, project/bar-def12345) (required)
  --repo PATH       Repository root (overrides TT_REPO; default: walk up from CWD to find .jj)
  -h, --help        Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} --task task/foo-abc12345
  ${COMMAND_NAME:-$SCRIPT_NAME} --task project/bar-def12345

EOF
}

main() {
  local task_id=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  if [[ -z "$task_id" ]]; then
    usage >&2; exit 1
  fi

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Validate task_id format (must be a task or project branch)
  if ! is_task_branch "$task_id" "$task_prefix" && ! is_project_branch "$task_id" "$project_prefix"; then
    log "Error: '$task_id' is not a recognized task or project ID"
    log "  Expected prefix '$task_prefix' or '$project_prefix' with 8-hex suffix"
    exit 1
  fi

  # Verify the bookmark exists in the repository
  if ! jj -R "$repo" --ignore-working-copy log -r "$task_id" --no-graph -T '' 2>/dev/null; then
    log "Error: Task or project '$task_id' not found in repository"
    exit 1
  fi

  # Find the dedicated worktree for this branch. The repo root is never a valid
  # result: it means the task is checked out in the main workspace, not a
  # dedicated worktree. Compare canonical paths so a symlinked repo root (e.g.
  # /var -> /private/var on macOS) does not defeat the comparison.
  local worktree
  worktree="$(find_worktrees_for_branch "$repo" "$task_id" "$task_prefix" "$project_prefix" | head -1)"
  if [[ -n "$worktree" && -d "$worktree" ]]; then
    worktree="$(resolve_path_symlinks "$worktree")"
  fi
  if [[ -z "$worktree" || "$worktree" == "$repo" ]]; then
    log "Error: No dedicated worktree for '$task_id'"
    log "  Run 'tt task checkout $task_id --worktree' to create one."
    exit 1
  fi

  printf '%s\n' "$worktree"
}

main "$@"
