#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt worktree active — Print the currently-active worktree path.
#
# Resolves and prints the path that the HEAD symlink in the virtual workspace
# directory currently points to. This is the worktree most recently activated
# by tt task checkout or tt workspace switch.
#
# Usage:
#   tt worktree active [--repo PATH]
#
# Options:
#   --repo PATH   Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   -h, --help    Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--repo PATH]

Print the currently-active worktree path.

Resolves and prints the path that the HEAD symlink in the virtual workspace
directory currently points to. This is the worktree most recently activated
by tt task checkout or tt workspace switch.

Options:
  --repo PATH   Repository root (overrides TT_REPO; default: walk up from CWD to find .jj)
  -h, --help    Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}
  ${COMMAND_NAME:-$SCRIPT_NAME} --repo /path/to/repo

EOF
}

main() {
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local ws_dir
  if ! ws_dir="$(get_workspace_dir "$repo")"; then
    log "Error: No workspace directory configured. Run 'tt workspace init' first."
    exit 1
  fi

  local active
  if ! active="$(get_active_worktree "$ws_dir")"; then
    log "Error: No active worktree (HEAD symlink missing or unreadable in '$ws_dir')."
    exit 1
  fi

  printf '%s\n' "$active"
}

main "$@"
