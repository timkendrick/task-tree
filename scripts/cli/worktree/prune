#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt worktree prune — Delete every worktree whose task is DONE.
#
# Usage:
#   prune [--dry-run] [--force] [--repo PATH]
#
# Each DONE worktree is deleted via `tt worktree delete`, so its safety checks
# apply. Prints each deleted worktree path to stdout.
#
# Options:
#   --dry-run              Print the worktrees that would be deleted without deleting them.
#   --force                Pass --force to each `tt worktree delete`.
#   --repo PATH            Repository root.
#   -h, --help             Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--dry-run] [--force] [--repo PATH]

Delete every worktree whose checked-out task has status DONE. Each worktree is
deleted as by \`tt worktree delete\`, so the same safety checks apply. Worktrees
that fail to delete are reported and skipped; the command exits non-zero if any
deletion failed. Prints each deleted worktree path to stdout.

Options:
  --dry-run              Print the worktrees that would be deleted, without deleting them.
  --force                Pass --force to each deletion (skips the dirty WC, commits
                         after bookmark, files in use and current worktree checks).
                         Worktrees whose task is not DONE are still kept.
  --repo PATH            Repository root (overrides TT_REPO; default: find .jj).
  -h, --help             Show this help.

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}
  ${COMMAND_NAME:-$SCRIPT_NAME} --dry-run

EOF
}

main() {
  local dry_run=false
  local force=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=true; shift ;;
      --force)
        force=true; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  local ws_data
  ws_data="$(_worktree__list "$repo")" || ws_data=''

  # Collect every target before deleting any, since each deletion changes the
  # worktree list being read.
  local -a done_paths=()
  local ws_name ws_path task_id task_status
  while IFS=$'\t' read -r ws_name ws_path task_id; do
    [[ -z "$ws_name" || -z "$ws_path" || -z "$task_id" ]] && continue
    task_status="$(_task__read_status "$repo" "$task_id" "$task_id" "$task_prefix" "$project_prefix")" \
      || task_status=''
    [[ "$task_status" == "DONE" ]] || continue
    done_paths+=("$ws_path")
  done <<< "$ws_data"

  if [[ ${#done_paths[@]} -eq 0 ]]; then
    _ui__log "No DONE worktrees to prune"
    return 0
  fi

  local -a delete_args=(--repo "$repo")
  if [[ "$force" == true ]]; then
    delete_args+=(--force)
  fi

  local failed=0
  local path
  for path in "${done_paths[@]}"; do
    if [[ "$dry_run" == true ]]; then
      printf '%s\n' "$path"
      continue
    fi
    if COMMAND_NAME="tt worktree delete" "$SCRIPT_DIR/delete" "$path" "${delete_args[@]}" >&2; then
      printf '%s\n' "$path"
    else
      _ui__log "Error: Failed to delete worktree '$path'"
      failed=$((failed + 1))
    fi
  done

  if [[ $failed -gt 0 ]]; then
    _ui__log "Error: $failed worktree(s) could not be pruned"
    exit 1
  fi
}

main "$@"
