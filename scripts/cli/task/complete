#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task complete — Mark the current task as DONE.
#
# Usage:
#   complete [--force] [--repo PATH] [--workspace-dir PATH]
#
# Options:
#   --force              Proceed even if not all subtasks are checked off.
#   --repo PATH          Repository root (default: walk up from CWD to find .jj).
#   --workspace-dir PATH Virtual project dir (for hooks).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat >&2 <<EOF
Usage: ${SCRIPT_NAME} [--force] [--repo PATH] [--workspace-dir PATH]

Mark the current task as DONE.

Options:
  --force               Proceed even if subtasks are not all complete.
  --repo PATH           Repository root (default: walk up from CWD to find .jj).
  --workspace-dir PATH  Virtual project dir (for hooks).

EOF
  exit 1
}

main() {
  local force=false
  local repo=''
  local workspace_dir=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)      force=true; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { log "Error: --repo requires an argument"; usage; }
        repo="$2"; shift 2 ;;
      --workspace-dir)
        [[ $# -lt 2 ]] && { log "Error: --workspace-dir requires an argument"; usage; }
        workspace_dir="$2"; shift 2 ;;
      -h|--help) usage ;;
      *)
        log "Error: Unknown option: $1"; usage ;;
    esac
  done

  # Resolve repo root
  if [[ -z "$repo" ]]; then
    if ! repo="$(find_repo_root)"; then
      log "Error: No enclosing jj repository. Use --repo to specify."
      exit 1
    fi
  fi
  if [[ ! -d "$repo/.jj" ]]; then
    log "Error: Not a jj repository: $repo"
    exit 1
  fi

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  if [[ -z "$workspace_dir" ]]; then
    workspace_dir="$(get_workspace_dir "$repo")" || true
  fi

  # Precondition: WC must be clean
  if ! is_wc_clean "$repo"; then
    log "Error: Working copy has uncommitted changes. Commit or discard first."
    exit 1
  fi

  # Precondition: must be on a task or project branch
  local resolve_output
  resolve_output="$(resolve_current "$repo" "$task_prefix" "$project_prefix")"
  local task_file bookmark
  task_file="$(printf '%s' "$resolve_output" | sed -n '2p')"
  bookmark="$(printf '%s' "$resolve_output" | sed -n '3p')"

  if [[ -z "$bookmark" ]]; then
    log "Error: Not on a task or project branch."
    exit 1
  fi

  # Read task file content from bookmark
  local task_content
  task_content="$(jj -R "$repo" file show -r "$bookmark" -- "$task_file" 2>/dev/null)" || {
    log "Error: Could not read task file '$task_file' from bookmark '$bookmark'."
    exit 1
  }

  local task_title task_status
  task_title="$(parse_frontmatter_field "$task_content" "title")"
  task_status="$(parse_frontmatter_field "$task_content" "status")"

  # If already DONE, nothing to do
  if [[ "$task_status" == "DONE" ]]; then
    log "Task is already DONE: $bookmark"
    exit 0
  fi

  # Precondition: all subtasks must be [x] unless --force
  if [[ "$force" != true ]]; then
    local incomplete_subs
    incomplete_subs="$(printf '%s' "$task_content" | awk '
      /^---$/ { in_fm = !in_fm; next }
      in_fm && /^subtask:[ \t]*\[[ -]\]/ { print; found=1 }
    ')" || true
    if [[ -n "$incomplete_subs" ]]; then
      log "Error: Not all subtasks are complete. Use --force to proceed anyway."
      log "  Incomplete subtasks:"
      printf '%s\n' "$incomplete_subs" | while IFS= read -r line; do
        log "    $line"
      done
      exit 1
    fi
  fi

  local current_worktree
  current_worktree="$(jj -R "$repo" workspace root 2>/dev/null || printf '%s' "$repo")"

  # Run pre-complete hook (blocking)
  run_hook "$repo" "pre-complete" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark"

  # Update status: IN-PROGRESS -> DONE in task file
  local tmpfile
  tmpfile="$(mktemp)"
  awk '
    /^---$/ { n++; print; next }
    n == 1 && /^status:/ { print "status: DONE"; next }
    { print }
  ' "$current_worktree/$task_file" > "$tmpfile"
  mv "$tmpfile" "$current_worktree/$task_file"

  # Commit, advance bookmark, leave clean WC
  jj -R "$repo" commit -m "Complete task: $task_title ($bookmark)"
  jj -R "$repo" bookmark set "$bookmark" -r '@-'
  jj -R "$repo" new '@'

  local commit_id
  commit_id="$(jj -R "$repo" log -r "${bookmark}" --no-graph -T 'commit_id' 2>/dev/null)" || true

  # Run post-complete hook (non-blocking)
  run_hook "$repo" "post-complete" false "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_COMMIT=${commit_id}"

  log "Completed: $bookmark"
}

main "$@"
