#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task complete — Mark the current task (or a given task) as DONE.
#
# Usage:
#   complete [<task-id>] [--force] [--repo PATH]
#
# Options:
#   <task-id>            Task ID to complete. Default: current task.
#   --force              Proceed even if not all subtasks are checked off.
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--force] [--repo PATH]

Mark the current task (or a given task) as DONE.

Options:
  <task-id>             Task ID to complete (default: current task).
  --force               Proceed even if subtasks are not all complete.
  --repo PATH           Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

EOF
}

main() {
  local force=false
  local repo=''
  local task_id_arg=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)      force=true; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  local bookmark task_file

  if [[ -z "$task_id_arg" ]]; then
    { read -r task_file; read -r bookmark; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")

    if [[ -z "$bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch."
      exit 1
    fi
  else
    bookmark="$task_id_arg"
    local suffix
    if _task__check_is_task_branch "$bookmark" "$task_prefix"; then
      suffix="${bookmark#$task_prefix}"
    elif _task__check_is_project_branch "$bookmark" "$project_prefix"; then
      suffix="${bookmark#$project_prefix}"
    else
      _ui__log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    fi
    if ! _task__check_branch_exists "$repo" "$bookmark"; then
      _ui__log "Error: Branch '$bookmark' not found in repository."
      exit 1
    fi
    task_file="$(_path__task_file "$suffix")"
  fi

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1
  _worktree__ensure_canonical_current "$repo" || exit 1

  # Resolve the current worktree (where the user is running from); hooks run here
  local current_worktree
  current_worktree="$(_worktree__resolve_current "$repo")"

  # Read task metadata from bookmark
  local task_fields task_title task_status subtask_count subtask subtasks=() i
  task_fields="$(_task__read_fields "$repo" "$bookmark" "$bookmark" \
    "$task_prefix" "$project_prefix" title status 'subtask[]')" || {
    _ui__log "Error: Could not read task file '$task_file' from bookmark '$bookmark'."
    exit 1
  }
  { IFS= read -r task_title; IFS= read -r task_status; IFS= read -r subtask_count
    for (( i = 0; i < subtask_count; i++ )); do
      IFS= read -r subtask; subtasks+=("$subtask")
    done
  } <<< "$task_fields" || true

  # If already DONE, nothing to do
  if [[ "$task_status" == "DONE" ]]; then
    _ui__log "Task is already DONE: $bookmark"
    exit 0
  fi

  # Precondition: all subtasks must be [x] unless --force
  if [[ "$force" != true ]]; then
    local incomplete_subs
    incomplete_subs="$(printf '%s\n' ${subtasks[@]+"${subtasks[@]}"} \
      | awk '/^\[[ \-]\]/ { print "subtask: " $0 }')" || true
    if [[ -n "$incomplete_subs" ]]; then
      _ui__log "Error: Not all subtasks are complete. Use --force to proceed anyway."
      _ui__log "  Incomplete subtasks:"
      printf '%s\n' "$incomplete_subs" | while IFS= read -r line; do
        _ui__log "    $line"
      done
      exit 1
    fi
  fi

  # Writer invoked by _task__commit_on_branch with the staging root: flips the
  # staged task file's status field to DONE.
  complete_writer() {
    local root="$1"
    _frontmatter__set_status "$root/$task_file" "DONE"
  }

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  # Run pre-complete hook (blocking)
  _hook__run "$repo" "pre-complete" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark"

  # Commit the status change onto the task branch
  local commit_id
  commit_id="$(_task__commit_on_branch "$repo" "$bookmark" \
    "$(_commit__format_message "task" "complete" "$bookmark" "$task_title")" \
    --modify "$task_file" -- complete_writer)"

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$bookmark"

  # Run post-complete hook (non-blocking)
  _hook__run "$repo" "post-complete" false "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_COMMIT=${commit_id}"

  _ui__log "Completed: $bookmark"
}

main "$@"
