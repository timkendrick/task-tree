#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"
# shellcheck source=../lib/select.sh
. "$SCRIPT_DIR/../lib/select.sh"

# tt task select — Interactively select an active task or project
#
# Usage:
#   select [--repo PATH] [-h|--help]
#
# Options:
#   --repo PATH        Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   -h, --help         Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--repo PATH]

Interactively select an active (non-completed) task or project. Requires an interactive terminal.
The selected task ID is printed to stdout.

Options:
  --repo PATH        Repository root (overrides TT_REPO; default: find .jj).
  -h, --help         Show this help.

EOF
}

main() {
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  # Check that /dev/tty is available (interactive terminal)
  if ! [ -t 2 ] || ! [ -e /dev/tty ]; then
    echo "Error: tt task select requires an interactive terminal" >&2
    exit 1
  fi

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # List all bookmarks from jj
  local all_bookmarks
  all_bookmarks="$(jj -R "$repo" --ignore-working-copy log -r 'bookmarks()' \
    -T 'local_bookmarks.map(|b| b.name()).join("\n") ++ "\n"' \
    --no-graph 2>/dev/null)" || true

  # Filter to task/project branches only, exclude DONE tasks
  local active_items=""
  while IFS= read -r b; do
    [[ -z "$b" ]] && continue
    
    # Check if this is a task or project branch
    if ! is_task_branch "$b" "$task_prefix" && ! is_project_branch "$b" "$project_prefix"; then
      continue
    fi
    
    # Get task file path
    local suffix
    if is_task_branch "$b" "$task_prefix"; then
      suffix="${b#$task_prefix}"
    else
      suffix="${b#$project_prefix}"
    fi
    local tf
    tf="$(task_file_path "$suffix")"
    
    # Read task file content
    local content
    content="$(jj_show_at_revision "$repo" "$b" "$tf")" || continue
    
    # Check status - exclude DONE tasks
    local status
    status="$(parse_frontmatter_field "$content" "status")"
    [[ "$status" == "DONE" ]] && continue
    
    # Add to active items
    active_items+="$b"$'\n'
  done <<< "$all_bookmarks"

  # Check if we have any active items
  if [[ -z "$active_items" ]]; then
    echo "Error: No active tasks or projects found" >&2
    exit 1
  fi

  # Sort alphabetically and pipe to select_value
  printf '%s' "$active_items" | sort | select_value
}

main "$@"