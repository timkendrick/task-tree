#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task edit — Edit title, body, and/or labels of a task.
#
# Usage:
#   edit [<task-id>] [--title TITLE] [--label LABEL ...] [--delete-label LABEL ...]
#
# Options:
#   <task-id>             Target task ID (default: current branch)
#   --title TITLE         New title (preserves existing if omitted)
#   --label LABEL         Append a label (repeatable)
#   --delete-label LABEL  Remove a label if present (repeatable, silent no-op if absent)
#   --repo PATH           Repository root (overrides TT_REPO; default: walk up to .jj)
#
# Body is read from stdin (via pipe or redirect) if stdin is not a terminal.
# With no flags and stdin is a terminal, opens editor pre-populated with current body.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [options...]

Edit title, body, and/or labels of a task.

Options:
  <task-id>              Task ID to edit (default: current task).
  --title TITLE          New title (preserves existing if omitted).
  --label LABEL          Append a label (repeatable).
  --delete-label LABEL   Remove a label if present (repeatable, silent no-op if absent).
  --repo PATH            Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

Body is read from stdin (via pipe or redirect) if stdin is not a terminal;
otherwise if none of --title, --label, or --delete-label are given, opens
an editor pre-populated with the current body text (interactive mode).

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}                                       # interactive: opens editor with current body
  ${COMMAND_NAME:-$SCRIPT_NAME} --title "New title"                   # preserve body (terminal stdin)
  echo "New description" | ${COMMAND_NAME:-$SCRIPT_NAME}              # stdin pipe, edit current task
  ${COMMAND_NAME:-$SCRIPT_NAME} < ./description.md                    # stdin redirect, edit current task
  echo "New description" | ${COMMAND_NAME:-$SCRIPT_NAME} task/abc-123 # stdin pipe, edit specific task
  ${COMMAND_NAME:-$SCRIPT_NAME} --title "Updated" < ./description.md  # stdin + explicit title

EOF
}

main() {
  local task_id_arg=''
  local new_title=''
  local has_title=false
  local -a add_labels=()
  local -a delete_labels=()
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        new_title="$2"; has_title=true; shift 2 ;;
      --label)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        add_labels+=("$2"); shift 2 ;;
      --delete-label)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        delete_labels+=("$2"); shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve bookmark and task_file
  local bookmark task_file
  if [[ -z "$task_id_arg" ]]; then
    { read -r task_file; read -r bookmark; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")

    if [[ -z "$bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch."
      exit 1
    fi
  else
    bookmark="$task_id_arg"
    local suffix
    suffix="$(_task__resolve_suffix "$bookmark" "$task_prefix" "$project_prefix")" || {
      _ui__log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    }
    if ! _task__check_branch_exists "$repo" "$bookmark"; then
      _ui__log "Error: Branch '$bookmark' not found in repository."
      exit 1
    fi
    task_file="$(_path__task_file "$suffix")"
  fi

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1
  _worktree__ensure_canonical_current "$repo" || exit 1
  local current_worktree
  current_worktree="$(_worktree__resolve_current "$repo")"
  _worktree__ensure_metadata_unmodified "$current_worktree" || exit 1
  if [[ -z "$task_id_arg" ]]; then
    _worktree__ensure_no_uncheckpointed_commits "$current_worktree" "$bookmark" \
      "or pass the task ID explicitly to skip this check" || exit 1
  fi

  # Read the current title, created timestamp, labels and body from the bookmark
  local fields current_title current_created label_count label current_body='' i
  local -a current_labels=()
  fields="$(_task__read_fields "$repo" "$bookmark" "$bookmark" "$task_prefix" "$project_prefix" \
    title created 'label[]' '...')" || {
    _ui__log "Error: Could not read task file '$task_file' from bookmark '$bookmark'."
    exit 1
  }
  { IFS= read -r current_title; IFS= read -r current_created; IFS= read -r label_count
    for (( i = 0; i < label_count; i++ )); do
      IFS= read -r label; [[ -n "$label" ]] && current_labels+=("$label")
    done
    IFS= read -r -d '' current_body
  } <<< "$fields" || true
  current_body="${current_body%$'\n'}"

  # A task file without a created timestamp (old format) gets one now
  local new_created=''
  if [[ -z "$current_created" ]]; then
    new_created="$(_string__generate_timestamp)"
  fi

  # Determine interactive mode: no metadata flags and stdin is a terminal → open editor
  # If stdin is not a terminal, read body from stdin even when no flags are given.
  local interactive=false
  if [[ "$has_title" == false && ${#add_labels[@]} -eq 0 && ${#delete_labels[@]} -eq 0 && -t 0 ]]; then
    interactive=true
  fi

  # Determine final values
  local final_title final_body
  final_title="${new_title:-$current_title}"

  if [[ "$interactive" == true ]]; then
    # Interactive mode with terminal stdin: open editor pre-populated with current body
    local edited_body
    edited_body="$(printf '%s' "${current_body}" | _ui__prompt)" || {
      _ui__log "Error: Editor exited with non-zero status."
      exit 1
    }
    final_body="$edited_body"
  elif [[ ! -t 0 ]]; then
    # Non-terminal stdin (pipe or redirect): read body from stdin
    final_body="$(</dev/stdin)"
  else
    # Terminal stdin but not interactive mode (metadata flags given): preserve current body
    final_body="$current_body"
  fi

  # Apply label changes
  local -a final_labels=()
  for lbl in "${current_labels[@]+"${current_labels[@]}"}"; do
    local skip=false
    for del in "${delete_labels[@]+"${delete_labels[@]}"}"; do
      if [[ "$lbl" == "$del" ]]; then
        skip=true
        break
      fi
    done
    [[ "$skip" == false ]] && final_labels+=("$lbl")
  done
  for lbl in "${add_labels[@]+"${add_labels[@]}"}"; do
    final_labels+=("$lbl")
  done

  local labels_changed=false
  if [[ ${#final_labels[@]} -ne ${#current_labels[@]} ]]; then
    labels_changed=true
  else
    for (( i = 0; i < ${#final_labels[@]}; i++ )); do
      [[ "${final_labels[i]}" == "${current_labels[i]}" ]] || labels_changed=true
    done
  fi

  # Check for a no-op BEFORE beginning the transaction (avoids orphaned
  # in-progress entries).
  if [[ "$final_title" == "$current_title" && "$final_body" == "$current_body" \
    && "$labels_changed" == false && -z "$new_created" ]]; then
    _ui__log "No changes to task $bookmark."
    printf '%s\n' "$bookmark"
    return 0
  fi

  # Generate the updated timestamp once so all write calls in this invocation are consistent.
  local updated
  updated="$(_string__generate_timestamp)"

  # Writer invoked by _task__commit_on_branch with the staging root: rewrites
  # only the fields that changed, and the updated timestamp.
  task_edit_writer() {
    local file="$1/$task_file"
    if [[ "$final_title" != "$current_title" ]]; then
      _task__set_field "$file" title "$(_frontmatter__quote "$final_title")"
    fi
    if [[ "$labels_changed" == true ]]; then
      _task__set_labels "$file" ${final_labels[@]+"${final_labels[@]}"}
    fi
    [[ -n "$new_created" ]] && _task__set_field "$file" created "$new_created"
    _task__set_field "$file" updated "$updated"
    if [[ "$final_body" != "$current_body" ]]; then
      _frontmatter__set_body "$file" "$final_body"
    fi
  }

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  _task__commit_on_branch "$repo" "$bookmark" \
    "$(_commit__format_message "task" "edit" "$bookmark" "$final_title")" \
    --modify "$task_file" -- task_edit_writer >/dev/null

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$bookmark"

  printf '%s\n' "$bookmark"
}

main "$@"
