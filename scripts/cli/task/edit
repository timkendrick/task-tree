#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task edit — Edit title, body, and/or labels of a task.
#
# Usage:
#   edit [<task-id>] [--title TITLE] [--label LABEL ...] [--delete-label LABEL ...]
#
# Options:
#   <task-id>             Target task ID (default: current branch)
#   --title TITLE         New title (preserves existing if omitted)
#   --label LABEL         Append a label (repeatable)
#   --delete-label LABEL  Remove a label if present (repeatable, silent no-op if absent)
#   --worktree PATH       Specify worktree when multiple exist for the task
#   --repo PATH           Repository root (default: walk up to .jj)
#
# Body is read from stdin (via pipe or redirect) if stdin is not a terminal.
# With no flags and stdin is a terminal, opens editor pre-populated with current body.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat >&2 <<EOF
Usage: ${SCRIPT_NAME} [<task-id>] [options...]

Edit title, body, and/or labels of a task.

Options:
  <task-id>              Task ID to edit (default: current task).
  --title TITLE          New title (preserves existing if omitted).
  --label LABEL          Append a label (repeatable).
  --delete-label LABEL   Remove a label if present (repeatable, silent no-op if absent).
  --worktree PATH        Worktree path when multiple exist for the task.
  --repo PATH            Repository root (default: walk up from CWD to find .jj).

Body is read from stdin (via pipe or redirect) if stdin is not a terminal;
otherwise if none of --title, --label, or --delete-label are given, opens
an editor pre-populated with the current body text (interactive mode).

Examples:
  ${SCRIPT_NAME}                                       # interactive: opens editor with current body
  ${SCRIPT_NAME} --title "New title"                   # preserve body (terminal stdin)
  echo "New description" | ${SCRIPT_NAME}              # stdin pipe, edit current task
  ${SCRIPT_NAME} < ./description.md                    # stdin redirect, edit current task
  echo "New description" | ${SCRIPT_NAME} task/abc-123 # stdin pipe, edit specific task
  ${SCRIPT_NAME} --title "Updated" < ./description.md  # stdin + explicit title

EOF
  exit 1
}

# Usage: rewrite_task_file FILE TITLE STATUS BODY CREATED LABELS... SUBTASKS... CONTEXTS...
#
# Rewrites the task file with new frontmatter + body.
# LABELS, SUBTASKS, CONTEXTS are passed as arrays via nameref (bash 4.3+), so we
# instead collect them via additional positional args prefixed with "label:", "subtask:", "context:".
#
# Simplified signature: rewrite_task_file FILE TITLE STATUS BODY CREATED
# plus arrays passed as caller-managed env vars REWRITE_LABELS, REWRITE_SUBTASKS, REWRITE_CONTEXTS.
rewrite_task_file() {
  local file="$1"
  local title="$2"
  local status="$3"
  local body="$4"
  local created="$5"
  # REWRITE_LABELS, REWRITE_SUBTASKS, REWRITE_CONTEXTS are caller-set env arrays (via 'local -a' + export trick)
  # We read them via indirect references below.

  local updated
  updated="$(generate_timestamp)"

  {
    echo '---'
    echo "title: \"${title//\"/\\\"}\""
    echo "status: $status"
    echo "created: $created"
    echo "updated: $updated"
    for label in "${REWRITE_LABELS[@]+"${REWRITE_LABELS[@]}"}"; do
      echo "label: $label"
    done
    for subtask in "${REWRITE_SUBTASKS[@]+"${REWRITE_SUBTASKS[@]}"}"; do
      echo "subtask: $subtask"
    done
    for ctx in "${REWRITE_CONTEXTS[@]+"${REWRITE_CONTEXTS[@]}"}"; do
      echo "context: $ctx"
    done
    echo '---'
    if [[ -n "$body" ]]; then
      printf '%s\n' "$body"
    fi
  } > "$file"
}

main() {
  local task_id_arg=''
  local new_title=''
  local has_title=false
  local -a add_labels=()
  local -a delete_labels=()
  local worktree_arg=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)
        [[ $# -lt 2 ]] && { log "Error: --title requires an argument"; usage; }
        new_title="$2"; has_title=true; shift 2 ;;
      --label)
        [[ $# -lt 2 ]] && { log "Error: --label requires an argument"; usage; }
        add_labels+=("$2"); shift 2 ;;
      --delete-label)
        [[ $# -lt 2 ]] && { log "Error: --delete-label requires an argument"; usage; }
        delete_labels+=("$2"); shift 2 ;;
      --worktree)
        [[ $# -lt 2 ]] && { log "Error: --worktree requires an argument"; usage; }
        worktree_arg="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { log "Error: --repo requires an argument"; usage; }
        repo="$2"; shift 2 ;;
      -h|--help) usage ;;
      -*)
        log "Error: Unknown option: $1"; usage ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          log "Error: Unexpected argument: $1"; usage
        fi ;;
    esac
  done

  # Resolve repo root
  if [[ -z "$repo" ]]; then
    if ! repo="$(find_repo_root)"; then
      log "Error: No enclosing jj repository. Use --repo to specify."
      exit 1
    fi
  fi
  if [[ ! -d "$repo/.jj" ]]; then
    log "Error: Not a jj repository: $repo"
    exit 1
  fi

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Resolve bookmark and task_file
  local bookmark task_file
  if [[ -z "$task_id_arg" ]]; then
    local resolve_output
    resolve_output="$(resolve_current "$repo" "$task_prefix" "$project_prefix")"
    task_file="$(printf '%s' "$resolve_output" | sed -n '2p')"
    bookmark="$(printf '%s' "$resolve_output" | sed -n '3p')"

    if [[ -z "$bookmark" ]]; then
      log "Error: Not on a task or project branch."
      exit 1
    fi
  else
    bookmark="$task_id_arg"
    local suffix
    if is_task_branch "$bookmark" "$task_prefix"; then
      suffix="${bookmark#$task_prefix}"
    elif is_project_branch "$bookmark" "$project_prefix"; then
      suffix="${bookmark#$project_prefix}"
    else
      log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    fi
    if ! jj -R "$repo" log -r "$bookmark" --no-graph -T '' 2>/dev/null; then
      log "Error: Branch '$bookmark' not found in repository."
      exit 1
    fi
    task_file="$(task_file_path "$suffix")"
  fi

  # Resolve worktree
  local current_worktree
  current_worktree="$(resolve_current_worktree "$repo")"

  local target_worktree
  if ! target_worktree="$(resolve_task_worktree "$repo" "$bookmark" "$task_prefix" "$project_prefix" \
      "$current_worktree" "$worktree_arg")"; then
    exit 1
  fi

  # Precondition: WC must be clean
  if ! is_wc_clean "$target_worktree"; then
    log "Error: Working copy has uncommitted changes. Commit or discard first."
    exit 1
  fi

  # Read current task file content from bookmark
  local task_content
  task_content="$(jj -R "$repo" file show -r "$bookmark" -- "$task_file" 2>/dev/null)" || {
    log "Error: Could not read task file '$task_file' from bookmark '$bookmark'."
    exit 1
  }

  # Parse current values from frontmatter
  local current_title current_status current_created current_body
  current_title="$(parse_quoted_frontmatter_field "$task_content" "title")"
  current_status="$(parse_frontmatter_field "$task_content" "status")"
  current_created="$(parse_frontmatter_field "$task_content" "created")"

  # Body is everything after the second ---
  current_body="$(parse_body "$task_content")"

  # Parse current labels (multiple label: lines)
  local -a current_labels=()
  while IFS= read -r lbl; do
    [[ -n "$lbl" ]] && current_labels+=("$lbl")
  done < <(printf '%s' "$task_content" | awk '/^---$/{n++; if(n==2)exit} n==1 && /^label:/{sub(/^label:[[:space:]]*/,""); print}')

  # Parse current subtask lines (preserve as-is, full "[ ] task/..." string)
  local -a current_subtasks=()
  while IFS= read -r st; do
    [[ -n "$st" ]] && current_subtasks+=("$st")
  done < <(printf '%s' "$task_content" | awk '/^---$/{n++; if(n==2)exit} n==1 && /^subtask:/{sub(/^subtask:[[:space:]]*/,""); print}')

  # Parse current context references (preserve as-is)
  local -a current_contexts=()
  while IFS= read -r ctx; do
    [[ -n "$ctx" ]] && current_contexts+=("$ctx")
  done < <(printf '%s' "$task_content" | awk '/^---$/{n++; if(n==2)exit} n==1 && /^context:/{sub(/^context:[[:space:]]*/,""); print}')

  # If created is empty (old format task file), generate one now
  if [[ -z "$current_created" ]]; then
    current_created="$(generate_timestamp)"
  fi

  # Determine interactive mode: no metadata flags and stdin is a terminal → open editor
  # If stdin is not a terminal, read body from stdin even when no flags are given.
  local interactive=false
  if [[ "$has_title" == false && ${#add_labels[@]} -eq 0 && ${#delete_labels[@]} -eq 0 && -t 0 ]]; then
    interactive=true
  fi

  # Determine final values
  local final_title final_body
  final_title="${new_title:-$current_title}"

  if [[ "$interactive" == true ]]; then
    # Interactive mode with terminal stdin: open editor pre-populated with current body
    local edited_body
    edited_body="$(printf '%s' "${current_body}" | prompt)" || {
      log "Error: Editor exited with non-zero status."
      exit 1
    }
    final_body="$edited_body"
  elif [[ ! -t 0 ]]; then
    # Non-terminal stdin (pipe or redirect): read body from stdin
    final_body="$(cat)"
  else
    # Terminal stdin but not interactive mode (metadata flags given): preserve current body
    final_body="$current_body"
  fi

  # Apply label changes
  local -a final_labels=()
  for lbl in "${current_labels[@]+"${current_labels[@]}"}"; do
    local skip=false
    for del in "${delete_labels[@]+"${delete_labels[@]}"}"; do
      if [[ "$lbl" == "$del" ]]; then
        skip=true
        break
      fi
    done
    [[ "$skip" == false ]] && final_labels+=("$lbl")
  done
  for lbl in "${add_labels[@]+"${add_labels[@]}"}"; do
    final_labels+=("$lbl")
  done

  # Determine if the target task is the current branch in the current worktree.
  # If not, we must commit directly on the target branch via jj edit+new, since
  # committing in the current worktree and then moving the target bookmark sideways
  # would be refused by jj.
  local current_bookmark
  current_bookmark="$(resolve_current "$repo" "$task_prefix" "$project_prefix" | sed -n '3p')"
  local cross_branch=false
  if [[ "$target_worktree" == "$current_worktree" && "$current_bookmark" != "$bookmark" ]]; then
    cross_branch=true
  fi

  # Export arrays for rewrite_task_file
  export REWRITE_LABELS=("${final_labels[@]+"${final_labels[@]}"}")
  export REWRITE_SUBTASKS=("${current_subtasks[@]+"${current_subtasks[@]}"}")
  export REWRITE_CONTEXTS=("${current_contexts[@]+"${current_contexts[@]}"}")

  if [[ "$cross_branch" == true ]]; then
    # Cross-branch edit: commit directly on the target branch using jj operations.
    # Since @ is empty (is_wc_clean guarantees this), save the parent commit_id so
    # we can restore the WC after the edit with `jj new -r <parent>`.
    local original_parent_rev
    original_parent_rev="$(jj -R "$repo" log -r '@-' --no-graph -T 'commit_id' 2>/dev/null)"

    # Write the task file into a temp location first to check for changes,
    # before beginning the transaction (avoids orphaned in-progress entries on no-op).
    local tmpfile
    tmpfile="$(mktemp)"
    rewrite_task_file "$tmpfile" \
      "$final_title" "$current_status" "$final_body" "$current_created"
    local current_file_content
    current_file_content="$(jj -R "$repo" file show -r "$bookmark" -- "$task_file" 2>/dev/null)" || true
    local new_file_content
    new_file_content="$(cat "$tmpfile")"
    rm -f "$tmpfile"

    if [[ "$current_file_content" == "$new_file_content" ]]; then
      log "No changes to task $bookmark."
      printf '%s\n' "$bookmark"
      unset REWRITE_LABELS REWRITE_SUBTASKS REWRITE_CONTEXTS
      return 0
    fi

    # Begin transaction (records before-op for undo)
    tt_begin_transaction "$repo"

    # Switch WC to the target bookmark, create a new empty change on top of it,
    # write the task file, commit, advance the bookmark, then return to the original parent.
    jj -R "$repo" edit "$bookmark"
    jj -R "$repo" new

    # Write updated task file now that we're on the target branch
    rewrite_task_file "$repo/$task_file" \
      "$final_title" "$current_status" "$final_body" "$current_created"

    jj -R "$repo" commit -m "Edit task: $final_title ($bookmark)"
    jj -R "$repo" bookmark set "$bookmark" -r '@-'

    # Return to the original working copy position
    jj -R "$repo" new -r "$original_parent_rev"
  else
    # Same-branch edit: write to the target worktree filesystem and commit normally.
    rewrite_task_file "$target_worktree/$task_file" \
      "$final_title" "$current_status" "$final_body" "$current_created"

    # Only commit if the task file actually changed
    if is_wc_clean "$target_worktree"; then
      log "No changes to task $bookmark."
      printf '%s\n' "$bookmark"
      unset REWRITE_LABELS REWRITE_SUBTASKS REWRITE_CONTEXTS
      return 0
    fi

    # Begin transaction (records before-op for undo)
    tt_begin_transaction "$repo"

    jj -R "$target_worktree" commit -m "Edit task: $final_title ($bookmark)"
    jj -R "$target_worktree" bookmark set "$bookmark" -r '@-'
  fi

  # Commit transaction (records after-op for undo)
  tt_commit_transaction "$repo"

  unset REWRITE_LABELS REWRITE_SUBTASKS REWRITE_CONTEXTS
  printf '%s\n' "$bookmark"
}

main "$@"
