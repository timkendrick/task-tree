#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task current — Print the current task or project ID.
#
# Usage: current [--repo PATH] [-h|--help]

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--repo PATH]

Print the current task or project branch name to stdout.

Options:
  --repo PATH  Repository root (overrides TT_REPO; default: find .jj).
  -h, --help   Show this help.

EOF
}

main() {
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) usage >&2; exit 1 ;;
      *)  usage >&2; exit 1 ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  local current_branch
  if ! current_branch="$(resolve_current_bookmark "$repo" "$task_prefix" "$project_prefix")"; then
    log "Error: Not on a task or project branch."
    exit 1
  fi
  if [[ -z "$current_branch" ]]; then
    log "Error: Not on a task or project branch."
    exit 1
  fi

  printf '%s\n' "$current_branch"
}

main "$@"
