#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# Rename a task's slug (human-readable part) while preserving the hex suffix.
#
# Usage:
#   rename --slug <new-slug> [--task <task-id>] [--repo PATH]
#
# Options:
#   --slug SLUG            New slug (required)
#   --task TASK-ID         Task to rename (default: current task)
#   --repo PATH            Repository root (overrides TT_REPO; default: walk up to find .jj)
#

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} --slug <new-slug> [--task <task-id>] [--repo PATH]

Rename a task's slug (the human-readable part of the task ID), preserving the hex suffix.
For example: task/old-name-abc123 → task/new-name-abc123.

Renames the branch bookmark, the task directory, and updates the parent's subtask reference.
Requires a clean working copy. If the task has no parent (e.g., a project), only the
bookmark and directory are renamed. Silently succeeds if the new slug matches the
current slug. Errors if the new ID would conflict with an existing bookmark.

Options:
  --slug SLUG            New slug (required)
  --task TASK-ID         Task to rename (default: current task)
  --repo PATH            Repository root (overrides TT_REPO; default: walk up to find .jj)

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug new-name
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug new-name --task task/old-name-abc123

EOF
}

main() {
  local slug=''
  local task_id=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --slug)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        slug="$2"
        shift 2
        ;;
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id="$2"
        shift 2
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  # --slug is required
  if [[ -z "$slug" ]]; then
    usage >&2; exit 1
  fi

  # Validate slug format
  if ! _string__validate_slug "$slug"; then
    exit 1
  fi

  repo="$(_workspace__resolve_repo "$repo")"

  # Resolve task prefix and project prefix from config
  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve target task
  local old_id old_slug old_hex
  if [[ -n "$task_id" ]]; then
    # Explicit --task provided
    old_id="$task_id"
  else
    # Use current task
    old_id="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$old_id" ]]; then
      _ui__log "Error: No current task found. Use --task to specify."
      exit 1
    fi
  fi

  # Validate old_id is a valid task or project branch
  if ! _task__check_is_task_branch "$old_id" "$task_prefix" && ! _task__check_is_project_branch "$old_id" "$project_prefix"; then
    _ui__log "Error: Invalid task ID: $old_id"
    exit 1
  fi

  # Extract old slug and hex from the ID
  local prefix
  if _task__check_is_task_branch "$old_id" "$task_prefix"; then
    prefix="$task_prefix"
  else
    prefix="$project_prefix"
  fi
  local suffix="${old_id#$prefix}"  # e.g., "old-name-abc123"
  old_slug="${suffix%-*}"           # e.g., "old-name"
  old_hex="${suffix##*-}"           # e.g., "abc123"

  # Check for no-op: if new slug is same as old slug, succeed silently
  if [[ "$slug" == "$old_slug" ]]; then
    exit 0
  fi

  # Construct new task ID
  local new_id="${prefix}${slug}-${old_hex}"
  local new_suffix="${slug}-${old_hex}"

  # Pre-validate: check if new ID already exists as a bookmark
  if _task__check_branch_exists "$repo" "$new_id"; then
    _ui__log "Error: Task or project '$new_id' already exists. Choose a different slug."
    exit 1
  fi

  local current_worktree
  current_worktree="$(_worktree__resolve_current "$repo")"

  # Precondition: the working copy must be clean. A rename rewrites every
  # commit that carries the task directory, and the invoking worktree's
  # working-copy commit is one of them: it is carried through the rewrite, so
  # uncommitted edits would be replayed onto a tree they were never written
  # against.
  if ! _worktree__check_clean "$current_worktree"; then
    _ui__log "Error: Working copy is not clean. Commit or discard changes first."
    exit 1
  fi

  # Find parent branch (optional - may not exist for projects)
  local parent_bookmark
  parent_bookmark="$(_task__find_parent_branch "$repo" "$old_id" "$task_prefix" "$project_prefix")" || true

  # Find parent task file path
  local parent_task_file=''
  if [[ -n "$parent_bookmark" ]]; then
    local parent_suffix
    if _task__check_is_task_branch "$parent_bookmark" "$task_prefix"; then
      parent_suffix="${parent_bookmark#$task_prefix}"
    else
      parent_suffix="${parent_bookmark#$project_prefix}"
    fi
    parent_task_file="$(_path__task_file "$parent_suffix")"
  fi

  local old_dir new_dir old_task_file
  old_dir="$(_path__task_dir "$suffix")"
  new_dir="$(_path__task_dir "$new_suffix")"
  old_task_file="$(_path__task_file "$suffix")"

  # Get task title for commit message
  local task_content='' task_title=''
  task_content="$(_task__read_file "$repo" "$old_id" "$old_task_file")" || task_content=''
  task_title="$(printf '%s\n' "$task_content" \
    | awk '/^title:/ { for(i=2;i<=NF;i++) printf "%s ", $i; print ""; exit }')"

  if [[ -z "$task_title" ]]; then
    task_title="($old_id)"
  else
    task_title="${task_title% }"  # Remove trailing space
  fi

  local rename_message
  rename_message="$(_commit__format_message "task" "rename" "$new_id" "$task_title")"

  # ---------------------------------------------------------------------------
  # Determine the region of history the rename has to rewrite: the commit that
  # introduced the task directory, plus every visible commit descended from it.
  #
  # Anchoring on the introducing commit is what makes the set complete. The
  # directory is recorded in every one of those commits and in no other, so
  # each of them has to change; and because the set is closed under descent it
  # necessarily contains the parent branch's tip (which advanced past the fork
  # point), the task's own commits, any commits made past the task bookmark,
  # sibling branches that inherited the task's stub, and the invoking
  # worktree's working-copy commit — which must be included, or it would keep
  # a diff that puts the old paths straight back on the next checkpoint.
  # ---------------------------------------------------------------------------
  local introduction
  introduction="$(_task__find_directory_introduction "$repo" "$old_dir")" || introduction=''
  if [[ -z "$introduction" ]]; then
    _ui__log "Error: Could not resolve a unique creation boundary for '$old_id'."
    exit 1
  fi

  # ---------------------------------------------------------------------------
  # Refuse when another worktree is parked inside the rewrite range.
  #
  # A rename is the one task operation that has to rewrite commits it does not
  # own, so it cannot limit itself to the invoking worktree's own line the way
  # every other branch write does. It carries its own worktree across the
  # rewrite, but another worktree's uncommitted work exists only on that
  # worktree's disk, and rewriting the commit under it would destroy the work.
  # There is no flag for this: overriding it is never the right answer.
  #
  # Runs before the transaction begins, and reads other worktrees without
  # snapshotting them, so a refusal leaves the repository and every other
  # worktree exactly as they were.
  # ---------------------------------------------------------------------------
  local blocking_worktrees
  blocking_worktrees="$(_worktree__list_holding_descendants "$repo" "$introduction")"
  if [[ -n "$blocking_worktrees" ]]; then
    _ui__log "Error: Cannot rename while other worktrees hold commits in the rewrite range:"
    local blocked_path blocked_task
    while IFS=$'\t' read -r blocked_path blocked_task; do
      [[ -z "$blocked_path" ]] && continue
      _ui__log "  $blocked_path ($blocked_task)"
    done <<< "$blocking_worktrees"
    _ui__log ""
    _ui__log "Rewriting these would discard uncommitted work in those worktrees. Resolve each first:"
    _ui__log "  tt worktree sync <path>"
    _ui__log "  tt worktree delete <path>"
    _ui__log ""
    _ui__log "There is no override: rewriting a worktree's commits from outside it"
    _ui__log "destroys any uncommitted work it holds."
    exit 1
  fi

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1
  _worktree__ensure_canonical_current "$repo" || exit 1

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  local rewrite_range
  rewrite_range="$(_task__list_rewrite_range "$repo" "$introduction")"

  # Writer invoked by _task__commit_detached with a staging root, for the
  # revision named by its second argument. Stages that revision's share of the
  # rename: the task directory's files under their new path, the repo-root task
  # symlink when it points into the old directory, and the parent's subtask
  # entry repointed at the new task ID. The old directory itself is removed
  # through the --delete-prefix flag rather than by omission, since a file
  # missing from the staging root is not a deletion.
  rename_stage_writer() {
    local root="$1" rev="$2"

    # Listed into a variable before the loop, so a failed listing aborts the
    # writer: read from a process substitution it would look like an empty
    # directory, and the commit would drop the task's files instead of moving
    # them.
    local listing path rel
    listing="$(_task__list_files "$repo" "$rev" "$old_dir")" || return 1
    while IFS= read -r path; do
      [[ -z "$path" ]] && continue
      rel="${path#"$old_dir"/}"
      mkdir -p "$root/$new_dir/$(_path__dirname "$rel")" || return 1
      _task__read_file "$repo" "$rev" "$path" > "$root/$new_dir/$rel" || return 1
    done <<< "$listing"

    local link_target
    if link_target="$(_task__read_symlink "$repo" "$rev" "$TT_TASK_SYMLINK_FILENAME")"; then
      if [[ "$link_target" == "$old_dir"/* ]]; then
        ln -s "${new_dir}/${link_target#"$old_dir"/}" \
          "$root/$TT_TASK_SYMLINK_FILENAME" || return 1
      fi
    fi

    # Every commit in the range that carries a copy of the parent task file
    # gets the entry rewritten, not just the parent branch's own tip: the task
    # branch and its siblings inherited that copy and would otherwise keep
    # pointing at a task ID that no longer exists.
    if [[ -n "$parent_task_file" ]]; then
      mkdir -p "$root/$(_path__dirname "$parent_task_file")" || return 1
      if _task__read_file "$repo" "$rev" "$parent_task_file" > "$root/$parent_task_file"; then
        _frontmatter__rename_subtask "$root/$parent_task_file" "$old_id" "$new_id"
      else
        rm -f "$root/$parent_task_file"
      fi
    fi
  }

  # ---------------------------------------------------------------------------
  # Phase 1: compute every target tree up front, from the history as it stands.
  #
  # Each commit's renamed tree is built and parked in the repository as a
  # detached staging commit, recorded against the change ID of the commit it
  # belongs to. Nothing existing is modified yet, so every read here sees the
  # original objects: no step of the rewrite below can observe state that the
  # rewrite itself has already disturbed. bash 3.2 has no associative arrays,
  # so the mapping lives as one file per change ID in a scratch directory.
  #
  # Both phases and the bookmark rename run inside a subshell that owns that
  # directory, so its EXIT trap removes it on every path out without competing
  # for the trap the enclosing transaction installs. A failure inside leaves
  # the subshell alone, so the exit status is propagated explicitly.
  # ---------------------------------------------------------------------------
  (
    scratch="$(mktemp -d)" || exit 1
    trap 'rm -rf "$scratch"' EXIT
    mkdir -p "$scratch/map" || exit 1

    _ui__log "Planning rename: $old_id -> $new_id"

    local change_id staging_commit staging_change
    while IFS= read -r change_id; do
      [[ -z "$change_id" ]] && continue
      staging_commit="$(_task__commit_detached "$repo" "$change_id" "$rename_message" \
        --delete-prefix "$old_dir" -- rename_stage_writer "$change_id")" || exit 1
      # Record the staging commit by change ID too: rewriting the range below
      # rebases the staging commits along with everything else, so their commit
      # IDs do not survive to the point where they are consumed.
      staging_change="$(_task__resolve_change "$repo" "$staging_commit")" || exit 1
      printf '%s\n' "$staging_change" > "$scratch/map/$change_id"
    done <<< "$rewrite_range"

    # ---------------------------------------------------------------------------
    # Phase 2: replace each commit's tree with the one computed for it, oldest
    # first, addressing commits by change ID because each replacement rebases the
    # rest of the range and invalidates their commit IDs. Every commit keeps its
    # identity, description and position; only what it records changes. No diff
    # is ever replayed, so nothing can conflict.
    # ---------------------------------------------------------------------------
    _ui__log "Rewriting task history..."

    while IFS= read -r change_id; do
      [[ -z "$change_id" ]] && continue
      staging_change="$(cat "$scratch/map/$change_id")"
      _task__replace_tree "$repo" "$staging_change" "$change_id" || exit 1
    done <<< "$rewrite_range"

    _ui__log "Renaming bookmark..."
    _task__rename_branch "$repo" "$old_id" "$new_id"

    # Retire the staging commits. Abandoning them is what removes them: they are
    # already unreferenced by this point, and an unreferenced commit stays a
    # visible head until it is abandoned.
    while IFS= read -r change_id; do
      [[ -z "$change_id" ]] && continue
      staging_change="$(cat "$scratch/map/$change_id")"
      _task__discard_commit "$repo" "$staging_change" || true
    done <<< "$rewrite_range"
  ) || exit 1

  # The rewrite above was a bare graph mutation, so the invoking worktree's
  # files are still those of the pre-rename tree; bring them forward now, while
  # its working-copy commit is guaranteed clean.
  _worktree__refresh_current "$repo"

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  # Both bookmarks moved to rewritten commits, so a worktree that was already
  # sitting behind either of them is now behind a different commit again. A
  # worktree INSIDE the rewritten range cannot appear here — the refusal above
  # rules that out — so anything reported is a worktree that was already out of
  # sync before the rename.
  _worktree__report_unsynced "$repo" "$new_id"
  if [[ -n "$parent_bookmark" ]]; then
    _worktree__report_unsynced "$repo" "$parent_bookmark"
  fi

  # Success message
  printf 'Task renamed: %s > %s\n' "$old_id" "$new_id"
}

main "$@"
