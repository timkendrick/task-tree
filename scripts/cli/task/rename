#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# Rename a task's slug (human-readable part) while preserving the hex suffix.
#
# Usage:
#   rename --slug <new-slug> [--task <task-id>] [--repo PATH]
#
# Options:
#   --slug SLUG            New slug (required)
#   --task TASK-ID         Task to rename (default: current task)
#   --repo PATH            Repository root (overrides TT_REPO; default: walk up to find .jj)
#

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} --slug <new-slug> [--task <task-id>] [--repo PATH]

Rename a task's slug (the human-readable part of the task ID), preserving the hex suffix.
For example: task/old-name-abc123 → task/new-name-abc123.

Renames the jj bookmark, the task directory, and updates the parent's subtask reference.
Requires a clean working copy. If the task has no parent (e.g., a project), only the
bookmark and directory are renamed. Silently succeeds if the new slug matches the
current slug. Errors if the new ID would conflict with an existing bookmark.

Options:
  --slug SLUG            New slug (required)
  --task TASK-ID         Task to rename (default: current task)
  --repo PATH            Repository root (overrides TT_REPO; default: walk up to find .jj)

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug new-name
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug new-name --task task/old-name-abc123

EOF
}

main() {
  local slug=''
  local task_id=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --slug)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        slug="$2"
        shift 2
        ;;
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id="$2"
        shift 2
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  # --slug is required
  if [[ -z "$slug" ]]; then
    usage >&2; exit 1
  fi

  # Validate slug format
  if ! validate_slug "$slug"; then
    exit 1
  fi

  repo="$(resolve_repo "$repo")"

  local -a jj_opts=(-R "$repo")

  # Resolve task prefix and project prefix from config
  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Resolve target task
  local old_id old_slug old_hex
  if [[ -n "$task_id" ]]; then
    # Explicit --task provided
    old_id="$task_id"
  else
    # Use current task
    local resolve_output
    resolve_output="$(resolve_current "$repo" "$task_prefix" "$project_prefix")"
    old_id="$(printf '%s' "$resolve_output" | sed -n '3p')"
    if [[ -z "$old_id" ]]; then
      log "Error: No current task found. Use --task to specify."
      exit 1
    fi
  fi

  # Validate old_id is a valid task or project branch
  if ! is_task_branch "$old_id" "$task_prefix" && ! is_project_branch "$old_id" "$project_prefix"; then
    log "Error: Invalid task ID: $old_id"
    exit 1
  fi

  # Extract old slug and hex from the ID
  local prefix
  if is_task_branch "$old_id" "$task_prefix"; then
    prefix="$task_prefix"
  else
    prefix="$project_prefix"
  fi
  local suffix="${old_id#$prefix}"  # e.g., "old-name-abc123"
  old_slug="${suffix%-*}"           # e.g., "old-name"
  old_hex="${suffix##*-}"           # e.g., "abc123"

  # Check for no-op: if new slug is same as old slug, succeed silently
  if [[ "$slug" == "$old_slug" ]]; then
    exit 0
  fi

  # Construct new task ID
  local new_id="${prefix}${slug}-${old_hex}"

  # Pre-validate: check if new ID already exists as a bookmark
  if jj "${jj_opts[@]}" --ignore-working-copy log -r "$new_id" -n 1 --no-graph -T '' 2>/dev/null; then
    log "Error: Task or project '$new_id' already exists. Choose a different slug."
    exit 1
  fi

  # Check for clean working copy
  if ! is_wc_clean "$repo"; then
    log "Error: Working copy is not clean. Commit or discard changes first."
    exit 1
  fi

  # Find parent branch (optional - may not exist for projects)
  local parent_bookmark
  parent_bookmark="$(find_parent_branch "$repo" "$old_id" "$task_prefix" "$project_prefix")" || true

  # Find parent task file path
  local parent_task_file
  if [[ -n "$parent_bookmark" ]]; then
    local parent_suffix
    if is_task_branch "$parent_bookmark" "$task_prefix"; then
      parent_suffix="${parent_bookmark#$task_prefix}"
    else
      parent_suffix="${parent_bookmark#$project_prefix}"
    fi
    parent_task_file="$(task_file_path "$parent_suffix")"
  fi

  # Get task title for commit message
  local task_title
  task_title="$(jj_show_at_revision "$repo" "$old_id" "$(task_file_path "$suffix")" \
    | awk '/^title:/ { for(i=2;i<=NF;i++) printf "%s ", $i; print ""; exit }')"

  if [[ -z "$task_title" ]]; then
    task_title="($old_id)"
  else
    task_title="${task_title% }"  # Remove trailing space
  fi

  local old_dir="${repo}/$(task_dir_path "$suffix")"
  local new_dir="${repo}/$(task_dir_path "${slug}-${old_hex}")"
  local old_rel="$(task_dir_path "$suffix")"

  # Begin transaction (records before-op for undo)
  tt_begin_transaction "$repo"

  # ---------------------------------------------------------------------------
  # Step 0: Pre-save all file content under <old-dir>/ for every commit in the
  # task's unmerged range, before any jj operations modify the tree.
  #
  # Use --at-operation to read pre-rename content even after auto-rebase
  # introduces conflict markers. Use `{ head -1; cat >/dev/null; }` to drain
  # the pipe without triggering SIGPIPE / pipefail.
  # ---------------------------------------------------------------------------
  local pre_op saved_dir range
  pre_op=$(jj "${jj_opts[@]}" op log --no-graph -T 'id ++ "\n"' | { head -1; cat > /dev/null; })
  saved_dir=$(mktemp -d)

  if [[ -n "$parent_bookmark" ]]; then
    range=$(jj "${jj_opts[@]}" log -r "::${old_id} ~ ::${parent_bookmark}" \
        --no-graph -T 'change_id ++ "\n"' | tail -r)
  else
    # No parent: range is the full ancestry of the task branch
    range=$(jj "${jj_opts[@]}" log -r "::${old_id}" \
        --no-graph -T 'change_id ++ "\n"' | tail -r)
  fi

  local change_id
  while IFS= read -r change_id; do
    local file_list
    file_list=$(jj "${jj_opts[@]}" --at-operation "$pre_op" file list -r "$change_id" 2>/dev/null \
        | grep "^${old_rel}/" || true)
    if [[ -n "$file_list" ]]; then
      while IFS= read -r fpath; do
        local rel="${fpath#${old_rel}/}"
        mkdir -p "$saved_dir/$change_id/$(dirname "$rel")"
        jj_show_at_op "$repo" "$pre_op" "$change_id" "$fpath" \
            > "$saved_dir/$change_id/$rel"
      done <<< "$file_list"
    fi
  done <<< "$range"

  # ---------------------------------------------------------------------------
  # Step 1: Edit the parent branch commit in place — rename <old-dir> to
  # <new-dir>, update the subtask: reference, commit. jj's auto-rebase fires
  # immediately after, producing conflicts on task-range commits that modified
  # files under <old-dir>/.
  # ---------------------------------------------------------------------------
  if [[ -n "$parent_bookmark" && -n "$parent_task_file" ]]; then
    log "Updating parent branch..."
    jj "${jj_opts[@]}" edit "${parent_bookmark}"

    if [[ ! -d "$old_dir" ]]; then
      log "Error: Task directory not found on parent branch: $old_dir"
      exit 1
    fi

    # Rename the entire task directory tree
    mv "$old_dir" "$new_dir"

    # Update subtask: reference in the parent's own TASK.md
    local parent_path="$repo/$parent_task_file"
    if [[ -f "$parent_path" ]]; then
      local tmpfile
      tmpfile="$(mktemp)"
      sed "s|^\(subtask:[[:space:]]*\[.\][[:space:]]*\)${old_id}$|\1${new_id}|" "$parent_path" > "$tmpfile"
      mv "$tmpfile" "$parent_path"
    fi

    # Commit: jj snapshots the mv automatically; re-use existing message
    local parent_msg
    parent_msg=$(jj "${jj_opts[@]}" log -r @ --no-graph -T 'description.first_line()')
    jj "${jj_opts[@]}" commit -m "$parent_msg"
    jj "${jj_opts[@]}" bookmark set "${parent_bookmark}" -r @-
    jj "${jj_opts[@]}" new "${parent_bookmark}"
  fi

  # ---------------------------------------------------------------------------
  # Step 2: Rename the jj bookmark.
  # ---------------------------------------------------------------------------
  log "Renaming bookmark..."
  jj "${jj_opts[@]}" bookmark rename "$old_id" "$new_id"

  # ---------------------------------------------------------------------------
  # Step 3: Sweep the task range oldest-to-newest, writing pre-saved content
  # back to <new-dir>/ and removing <old-dir>/. Each `jj edit` call snapshots
  # the previous commit's changes and triggers auto-rebase of descendants.
  # ---------------------------------------------------------------------------
  log "Rewriting task branch range..."

  if [[ -n "$parent_bookmark" ]]; then
    range=$(jj "${jj_opts[@]}" log -r "::${new_id} ~ ::${parent_bookmark}" \
        --no-graph -T 'change_id ++ "\n"' | tail -r)
  else
    range=$(jj "${jj_opts[@]}" log -r "::${new_id}" \
        --no-graph -T 'change_id ++ "\n"' | tail -r)
  fi

  while IFS= read -r change_id; do
    jj "${jj_opts[@]}" edit "$change_id"

    # Write pre-saved file content to the new directory location
    if [[ -d "$saved_dir/$change_id" ]]; then
      local saved_file
      while IFS= read -r saved_file; do
        local rel="${saved_file#$saved_dir/$change_id/}"
        local dest="$new_dir/$rel"
        mkdir -p "$(dirname "$dest")"
        cp "$saved_file" "$dest"
      done < <(find "$saved_dir/$change_id" -type f)
    fi

    # Remove <old-dir> (which may exist as a conflict-marker directory after
    # auto-rebase, or as a plain directory if this commit introduced it)
    rm -rf "$old_dir"

    # Update root TASK.md symlink if it points to the old path
    local task_md_link="${repo}/TASK.md"
    if [[ -L "$task_md_link" ]]; then
      local link_target
      link_target="$(readlink "$task_md_link")"
      if [[ "$link_target" == *"$suffix"* ]]; then
        local new_target
        new_target="${link_target//$suffix/${slug}-${old_hex}}"
        rm "$task_md_link"
        ln -s "$new_target" "$task_md_link"
      fi
    fi

    # jj snapshots the above changes when the next jj command (next `jj edit`)
    # runs, which also triggers auto-rebase of all descendants.
  done <<< "$range"

  rm -rf "$saved_dir"

  # ---------------------------------------------------------------------------
  # Step 4: Leave the working copy as an empty child of the renamed task tip.
  # ---------------------------------------------------------------------------
  log "Switching to renamed task..."
  jj "${jj_opts[@]}" new "${new_id}"

  # Commit transaction (records after-op for undo)
  tt_commit_transaction "$repo"

  # Success message
  printf 'Task renamed: %s > %s\n' "$old_id" "$new_id"
}

main "$@"
