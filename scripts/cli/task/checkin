#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task checkin — Merge a task branch's work into its parent branch.
#
# Usage:
#   checkin [<task-id>] [--context <markdown>|-] [--complete] [--rebase | --merge]
#           [--force] [--delete] [--switch] [--retain-worktree]
#           [--repo PATH]
#           [--propagate] [--propagate-rebase | --propagate-merge]
#           [--propagate-shallow] [--propagate-force] [--propagate-dry-run]
#           [--propagate-to <child-id>]
#
# Options:
#   <task-id>               Task branch to check in (default: current branch).
#   --context <markdown>    Create a context file on the parent task with handoff notes.
#   --context -             Read context from stdin.
#   --complete              Run `tt task complete` first if status is not DONE.
#   --rebase                Rebase child onto parent before checkin.
#   --merge                 Merge parent into child before checkin.
#   --force                 Proceed even if conflicts occur.
#   --delete                Remove child task file and subtask entry (requires DONE),
#                           along with the task's dedicated worktree if it has one.
#   --retain-worktree       With --delete, keep the task's dedicated worktree.
#   --switch                Point the HEAD symlink at the parent worktree after checkin.
#   --repo PATH             Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   --propagate             Run `tt task propagate --from <parent>` after checkin.
#   --propagate-rebase      Propagate strategy: rebase (default).
#   --propagate-merge       Propagate strategy: merge.
#   --propagate-shallow     Propagate direct children only (no recursion).
#   --propagate-force       Propagate even if conflicts occur.
#   --propagate-dry-run     Show propagation plan without applying changes.
#   --propagate-to <id>     Limit propagation to this child (repeatable).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [options...]

Merge the current task branch (or <task-id>) into its parent branch.
Only valid on task branches. For project branches, use 'tt task publish'.

Options:
  <task-id>                 Task branch to check in (default: current branch).
  --context <markdown>      Create a context file on the parent task with handoff notes.
  --context -               Read context from stdin. If no --context is given and stdin is
                            a TTY, opens an editor for context input (empty input = no context).
  --complete                Run complete first if status is not DONE.
  --rebase                  Rebase child onto parent before checkin.
  --merge                   Merge parent into child before checkin.
  --force                   Proceed despite conflicts.
  --delete                  Remove child task file (requires DONE status), along
                            with the task's dedicated worktree if it has one.
  --switch                  Point the HEAD symlink at the parent worktree after checkin.
                            Falls back to the canonical repository root when the parent
                            task is not checked out in any worktree. Without this flag
                            the HEAD symlink is left untouched.
  --repo PATH               Repository root (overrides TT_REPO; default: find .jj).
  --propagate               Propagate parent tip to siblings after checkin.
  --propagate-rebase        Propagate strategy: rebase (default).
  --propagate-merge         Propagate strategy: merge.
  --propagate-shallow       Direct children only (no recursion).
  --propagate-force         Propagate despite conflicts.
  --propagate-dry-run       Show propagation plan without applying.
  --propagate-to CHILD_ID   Limit propagation to specific child (repeatable).
  --retain-worktree         With --delete, keep the task's dedicated worktree
                            instead of removing it. No effect without --delete.
  -h, --help                Show this help.

EOF
}

main() {
  local context_text=''
  local context_mode='arg'  # 'arg' | 'stdin' | 'editor'
  local do_complete=false
  local strategy=''
  local force=false
  local delete=false
  local do_switch=false
  local task_id_arg=''
  local repo=''
  local do_propagate=false
  local propagate_strategy=''
  local propagate_shallow=false
  local propagate_force=false
  local propagate_dry_run=false
  local -a propagate_to=()
  local retain_worktree=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        if [[ "$2" == '-' ]]; then
          context_mode='stdin'
        else
          context_text="$2"
          context_mode='arg'
        fi
        shift 2 ;;
      --complete)   do_complete=true; shift ;;
      --rebase)
        [[ -n "$strategy" && "$strategy" != rebase ]] && { usage >&2; exit 1; }
        strategy='rebase'; shift ;;
      --merge)
        [[ -n "$strategy" && "$strategy" != merge ]] && { usage >&2; exit 1; }
        strategy='merge'; shift ;;
      --force)      force=true; shift ;;
      --delete)     delete=true; shift ;;
      --switch)     do_switch=true; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      --propagate)       do_propagate=true; shift ;;
      --propagate-rebase)
        [[ -n "$propagate_strategy" && "$propagate_strategy" != rebase ]] && \
          { usage >&2; exit 1; }
        propagate_strategy='rebase'; shift ;;
      --propagate-merge)
        [[ -n "$propagate_strategy" && "$propagate_strategy" != merge ]] && \
          { usage >&2; exit 1; }
        propagate_strategy='merge'; shift ;;
      --propagate-shallow) propagate_shallow=true; shift ;;
      --propagate-force)   propagate_force=true; shift ;;
      --propagate-dry-run) propagate_dry_run=true; shift ;;
      --propagate-to)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        propagate_to+=("$2"); shift 2 ;;
      --retain-worktree) retain_worktree=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done


  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  local current_worktree
  current_worktree="$(_worktree__resolve_current "$repo")"

  # --- Resolve branch and task file ---
  local task_file child_bookmark child_slug

  if [[ -n "$task_id_arg" ]]; then
    child_bookmark="$task_id_arg"
    if _task__check_is_project_branch "$child_bookmark" "$project_prefix"; then
      _ui__log "Error: 'tt task checkin' requires a task branch."
      _ui__log "  '$child_bookmark' is a project branch."
      _ui__log "  Use 'tt task publish --target <branch>' to publish project branches."
      exit 1
    fi
    if ! _task__check_is_task_branch "$child_bookmark" "$task_prefix"; then
      _ui__log "Error: '$task_id_arg' is not a task branch."
      exit 1
    fi
    if ! _task__check_branch_exists "$repo" "$child_bookmark"; then
      _ui__log "Error: Branch '$child_bookmark' not found in repository."
      exit 1
    fi
    child_slug="${child_bookmark#"$task_prefix"}"
    task_file="$(_path__task_file "$child_slug")"
  else
    { read -r _rev; read -r task_file; read -r child_bookmark; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")
    if [[ -z "$child_bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch."
      exit 1
    fi
    if _task__check_is_project_branch "$child_bookmark" "$project_prefix"; then
      _ui__log "Error: 'tt task checkin' requires a task branch."
      _ui__log "  Current branch '$child_bookmark' is a project branch."
      _ui__log "  Use 'tt task publish --target <branch>' to publish project branches."
      exit 1
    fi
    child_slug="${child_bookmark#"$task_prefix"}"
  fi

  local task_id="$child_bookmark"

  # --- Same-branch preconditions (implicit current branch only) ---
  # Checking in the branch the invoking worktree sits on requires everything
  # in that worktree to be recorded first: a clean working copy (no pending
  # edits that would silently be left out of the checkin) and a bookmark that
  # tracks every commit up to @-. Both are skipped when <task-id> was passed
  # explicitly — the checkin then targets a branch as it stands, and the
  # invoking worktree's state is not part of what is being merged.
  if [[ -z "$task_id_arg" ]]; then
    if ! _worktree__check_clean "$current_worktree"; then
      _ui__log "Error: Working copy has uncommitted changes. Commit or discard first."
      exit 1
    fi
    _task__assert_bookmark_current "$current_worktree" "$child_bookmark"
  fi

  # --- Record the child branch's worktrees (--delete cleanup) ---
  # Resolved before any mutation: once the checkin merge lands (and before
  # the delegated delete removes the child bookmark), a worktree left behind
  # on an older child tip can no longer be attributed to the child branch
  # reliably. The list is only consumed by the post-delete cleanup at the end.
  local child_worktrees=''
  if [[ "$delete" == true ]] && [[ "$retain_worktree" != true ]]; then
    child_worktrees="$(_worktree__find_for_branch "$repo" "$child_bookmark" \
      "$task_prefix" "$project_prefix")"
  fi

  # --- Read current task state from bookmark ---
  local task_content task_title task_status
  task_content="$(_task__read_file "$repo" "$child_bookmark" "$task_file")" || {
    _ui__log "Error: Could not read task file '$task_file' from '$child_bookmark'."
    exit 1
  }
  task_title="$(_frontmatter__parse_quoted_field "$task_content" "title")"
  task_status="$(_frontmatter__parse_field "$task_content" "status")"

  # Validate --delete requires DONE. With --complete the task is marked DONE later in
  # this command, so the check is deferred until after the complete step has run.
  if [[ "$delete" == true ]] && [[ "$do_complete" != true ]] && [[ "$task_status" != "DONE" ]]; then
    _ui__log "Error: --delete requires task status to be DONE (current: $task_status)."
    _ui__log "  Use --complete to mark done first, or use --complete --delete together."
    exit 1
  fi

  # --- Find parent branch ---
  local parent_bookmark
  parent_bookmark="$(_task__find_parent_branch "$repo" "$task_id" "$task_prefix" "$project_prefix")" || {
    local rc=$?
    [[ $rc -eq 1 ]] && _ui__log "Error: No parent branch found containing subtask entry for '$task_id'."
    exit 1
  }

  # Derive parent slug and task file
  local parent_slug parent_task_file
  if _task__check_is_task_branch "$parent_bookmark" "$task_prefix"; then
    parent_slug="${parent_bookmark#"$task_prefix"}"
  else
    parent_slug="${parent_bookmark#"$project_prefix"}"
  fi
  parent_task_file="$(_path__task_file "$parent_slug")"

  # Resolve context: stdin or interactive editor
  if [[ "$context_mode" == 'stdin' ]]; then
    context_text="$(cat)"
  elif [[ "$context_mode" == 'arg' ]] && [[ -z "$context_text" ]] && [[ -t 0 ]]; then
    # No --context arg, interactive session: open editor with hint
    local template
    template="$(printf '\n# Task: %s\n# Optional handoff context' "$task_id")"
    context_text="$(_ui__prompt <<< "$template")" || {
      _ui__log "Error: Editor exited with non-zero status."
      exit 1
    }
  fi
  # Trim whitespace; treat blank input as "no context"
  local trimmed_context
  trimmed_context="$(printf '%s' "$context_text" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  if [[ ! "$trimmed_context" =~ [^[:space:]] ]]; then
    context_text=''
  else
    context_text="$trimmed_context"
  fi


  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1

  # Begin transaction early so that --complete and --propagate sub-commands
  # are nested within this transaction (their _history__begin_transaction calls
  # become no-ops, keeping a single history entry for the whole checkin).
  _history__begin_transaction "$repo"

  # --- Optional: run complete first ---
  if [[ "$do_complete" == true ]]; then
    local task_content_check
    task_content_check="$(_task__read_file "$repo" "$child_bookmark" "$task_file")" || true
    local status_check
    status_check="$(_frontmatter__parse_field "$task_content_check" "status")"
    if [[ "$status_check" != "DONE" ]]; then
      _ui__log "Running complete for $child_bookmark..."
      "$SCRIPT_DIR/complete" --repo "$repo" \
        ${task_id_arg:+"$task_id_arg"} \
        ${force:+--force}
    fi

    # Re-read the task file: `complete` advanced the child bookmark, and the refreshed
    # status drives the parent's subtask checkbox, the --delete precondition and the
    # final log message.
    task_content="$(_task__read_file "$repo" "$child_bookmark" "$task_file")" || {
      _ui__log "Error: Could not read task file '$task_file' from '$child_bookmark'."
      exit 1
    }
    task_title="$(_frontmatter__parse_quoted_field "$task_content" "title")"
    task_status="$(_frontmatter__parse_field "$task_content" "status")"

    if [[ "$delete" == true ]] && [[ "$task_status" != "DONE" ]]; then
      _ui__log "Error: --delete requires task status to be DONE (current: $task_status)."
      exit 1
    fi
  fi

  _ui__log "Checking in: $child_bookmark -> $parent_bookmark"

  # --- Optional: rebase/merge propagation ---
  if [[ -n "$strategy" ]]; then
    _ui__log "Propagating parent ($strategy) into child before checkin..."
    "$SCRIPT_DIR/propagate" \
      --from "$parent_bookmark" \
      --to "$child_bookmark" \
      --"$strategy" \
      ${force:+--force} \
      --repo "$repo"
    # Re-check the same-branch clean precondition after propagation, which
    # may have rewritten the line the invoking worktree sits on.
    if [[ -z "$task_id_arg" ]] && ! _worktree__check_clean "$current_worktree"; then
      _ui__log "Error: Working copy not clean after propagation."
      exit 1
    fi
  fi

  # --- Validate unmerged range: must not touch other task files ---
  local diff_output
  diff_output="$(_task__list_unmerged_changes "$repo" "$parent_bookmark" "$child_bookmark" \
    "$(_path__task_root)")" || true

  if [[ -n "$diff_output" ]]; then
    # Build the set of allowed task directories: own dir + all descendants.
    local task_dir
    task_dir="$(_path__task_dir "$child_slug")"

    local -a allowed_dirs=("$task_dir")
    local descendant_dirs
    descendant_dirs="$(_task__collect_descendant_dirs \
      "$repo" "$child_bookmark" "$child_bookmark" "$task_prefix" "$project_prefix")" || true
    while IFS= read -r d; do
      [[ -n "$d" ]] && allowed_dirs+=("$d")
    done <<< "$descendant_dirs"

    while IFS= read -r changed_path; do
      [[ -z "$changed_path" ]] && continue
      local allowed=false
      local allowed_dir
      for allowed_dir in "${allowed_dirs[@]}"; do
        if [[ "$changed_path" == "$allowed_dir"/* || "$changed_path" == "$allowed_dir/TASK.md" ]]; then
          allowed=true
          break
        fi
      done
      if [[ "$allowed" != true ]]; then
        _ui__log "Error: Unmerged range touches unexpected task file: $changed_path"
        _ui__log "  Only files under descendant task directories of '$child_bookmark' may differ from parent."
        exit 1
      fi
    done <<< "$diff_output"
  fi

  # --- Resolve the parent branch's workspace (hook context and --switch) ---
  # Nothing is written through this workspace — the handoff and merge below
  # are bare commits — but the receive hooks name it in their environment and
  # --switch points the HEAD symlink at it. With no worktree checked out on
  # the parent branch, fall back to the canonical repository root rather than
  # $repo: when checkin runs from inside the child's own worktree, $repo
  # resolves to that worktree, which a complete checkin deletes further below.
  # Several parent worktrees are only a problem for --switch, which needs a
  # single HEAD target; hooks then also get the canonical root.
  local receive_ws
  local worktrees
  worktrees="$(_worktree__find_for_branch "$repo" "$parent_bookmark" "$task_prefix" "$project_prefix")"
  local wt_count
  wt_count="$(printf '%s' "$worktrees" | grep -c . 2>/dev/null || true)"

  case "$wt_count" in
    0) receive_ws="$(_worktree__resolve_repository_root "$repo")" ;;
    1) receive_ws="$worktrees" ;;
    *)
      if [[ "$do_switch" == true ]]; then
        _ui__log "Error: Multiple parent workspaces found for '$parent_bookmark'; cannot resolve a --switch target."
        printf '%s\n' "$worktrees" | while IFS= read -r p; do _ui__log "  $p"; done
        exit 1
      fi
      receive_ws="$(_worktree__resolve_repository_root "$repo")"
      ;;
  esac

  # --- Run pre-checkin hook ---
  _hook__run "$repo" "pre-checkin" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$task_id" \
    "TT_TASK_BRANCH=$task_id" \
    "TT_PARENT_TASK_ID=$parent_bookmark" \
    "TT_PARENT_BRANCH=$parent_bookmark"

  # --- Build the handoff content ---

  # Build updated parent task file content
  local parent_task_content
  parent_task_content="$(_task__read_file "$repo" "$parent_bookmark" "$parent_task_file")" || {
    _ui__log "Error: Could not read parent task file '$parent_task_file' from '$parent_bookmark'."
    exit 1
  }

  # Update the subtask entry in the parent task file to reflect the child's status.
  local updated_parent_content new_cb
  new_cb="$(_format__status_checkbox "$task_status")"
  updated_parent_content="$(printf '%s' "$parent_task_content" | awk -v id="$task_id" -v cb="$new_cb" '
    BEGIN { sep = 0 }
    /^---$/ { sep++; print; next }
    sep == 1 && /^subtask:[[:space:]]*\[[ \-x]\]/ {
      rest = $0
      sub(/^subtask:[[:space:]]*\[[[:space:]\-x]\][[:space:]]*/, "", rest)
      split(rest, parts, /[[:space:]]/)
      if (parts[1] == id) {
        sub(/\[[ \-x]\]/, cb)
      }
      print; next
    }
    { print }
  ')"

  # If --context is provided, a context file is created on the parent task
  local ctx_id='' ctx_file='' ctx_title='' ctx_ts=''
  if [[ -n "$context_text" ]]; then
    ctx_title="Handoff: ${task_title}"
    local ctx_slug
    ctx_slug="$(_string__to_slug "$ctx_title")"
    local ctx_hex
    ctx_hex="$(_string__generate_hex)"
    ctx_id="context/${ctx_slug}-${ctx_hex}"
    ctx_file="$(_path__task_context "$parent_slug" "$ctx_id")"
    ctx_ts="$(_string__generate_timestamp)"
  fi

  # Writer invoked by _task__commit_handoff with the staging root. Stages the
  # complete handoff file set on top of the child branch tip:
  #   - the repo-root TASK.md symlink reverted to the parent's task file
  #     (staged as a real symlink; the bare write records it as a symlink entry)
  #   - the parent task file rewritten with the child's subtask checkbox (and
  #     the context: entry inserted in canonical position when one was made)
  #   - the handoff context file itself, when --context was given
  checkin_handoff_writer() {
    local root="$1"
    ln -s "$(_path__task_file "$parent_slug")" "$root/$TT_TASK_SYMLINK_FILENAME"
    mkdir -p "$root/$(dirname "$parent_task_file")"
    printf '%s\n' "$updated_parent_content" > "$root/$parent_task_file"
    if [[ -n "$ctx_id" ]]; then
      mkdir -p "$root/$(dirname "$ctx_file")"
      _frontmatter__write_context_file "$root/$ctx_file" "$ctx_title" "$context_text" "$ctx_ts" "$ctx_ts"
      _frontmatter__append_context "$root/$parent_task_file" "$ctx_id"
    fi
  }

  # Pin the parent tip before the merge: it anchors the merge's first parent
  # and the worktree reattachment below.
  local old_parent_tip
  old_parent_tip="$(_task__resolve_revision "$repo" "$parent_bookmark")" || {
    _ui__log "Error: Could not resolve branch '$parent_bookmark'."
    exit 1
  }

  # --- Create the handoff commit (child bookmark does NOT advance) ---
  local handoff_commit
  handoff_commit="$(_task__commit_handoff "$repo" "$child_bookmark" \
    "$(_commit__format_message "task" "handoff" "$task_id" "$task_title")" \
    -- checkin_handoff_writer)"

  if [[ -n "$ctx_id" ]]; then
    _ui__log "Created context file: $ctx_file"
  fi

  # --- Run pre-receive hook ---
  _hook__run "$repo" "pre-receive" true "$receive_ws" "${workspace_dir:-}" \
    "TT_TASK_ID=$parent_bookmark" \
    "TT_TASK_BRANCH=$parent_bookmark" \
    "TT_INCOMING_TASK_ID=$task_id" \
    "TT_INCOMING_BRANCH=$task_id"

  # --- Create the merge commit and advance the parent bookmark ---
  # Parents: parent tip first, handoff second (the order full-range discovery
  # relies on). The merge carries no file writes of its own.
  local merge_commit
  merge_commit="$(_task__merge_branch "$repo" \
    "$(_commit__format_message "task" "checkin" "$task_id" "$task_title")" \
    "$old_parent_tip" "$handoff_commit")"

  # Check for conflicts (unless --force)
  # On conflict, exit 1 triggers the ERR trap → _history__rollback_transaction →
  # backend operation restore, which cleanly reverts this transaction's writes.
  if [[ "$force" != true ]] && _task__check_conflicts "$repo" "$merge_commit"; then
    _ui__log "Error: Merge conflicts detected. Resolve conflicts or use --force."
    exit 1
  fi

  # Follow the advance with the current worktree only when it sits on the
  # PARENT branch (a worktree on the child branch — typically the one this
  # command runs from — stays put: checkin affects the target branch, not the
  # invoking worktree). Must run before the bookmark moves off old_parent_tip.
  _worktree__reattach_current_on_branch "$repo" "$parent_bookmark" \
    "$old_parent_tip" "$merge_commit"

  _task__advance_branch "$repo" "$parent_bookmark" "$merge_commit"

  # --- Run post-receive hook ---
  _hook__run "$repo" "post-receive" false "$receive_ws" "${workspace_dir:-}" \
    "TT_TASK_ID=$parent_bookmark" \
    "TT_TASK_BRANCH=$parent_bookmark" \
    "TT_INCOMING_TASK_ID=$task_id" \
    "TT_INCOMING_BRANCH=$task_id"

  # --- Post-checkin worktree switch ---
  # Only performed when --switch is given; otherwise HEAD is left untouched.
  # receive_ws is the parent's worktree when it has one, and the canonical
  # repository root otherwise, so HEAD can never be left pointing at the child
  # worktree that a complete checkin deletes below.
  if [[ "$do_switch" == true ]]; then
    _worktree__switch "$repo" "${workspace_dir:-}" "$parent_bookmark" \
      "$receive_ws" "$current_worktree" "$task_id"
  fi

  if [[ "$task_status" != "DONE" ]]; then
    _ui__log "Partial checkin complete: $task_id -> $parent_bookmark"
  else
    _ui__log "Checkin complete: $task_id -> $parent_bookmark"
  fi

  # Commit transaction now — before any worktree deletion — because the
  # history file lives in $repo, which may be the child worktree that is
  # about to be removed.  All backend operations that should be recorded are
  # already complete at this point.
  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$parent_bookmark"

  # --- Delegate --delete to tt task delete (second commit on parent branch) ---
  if [[ "$delete" == true ]]; then
    _ui__log "Running delete for $task_id..."
    "$SCRIPT_DIR/delete" "$task_id" --force \
      --repo "$repo"
  fi

  # --- Optional: propagate parent tip to remaining siblings ---
  if [[ "$do_propagate" == true ]]; then
    _ui__log "Propagating from parent: $parent_bookmark"
    local -a propagate_args=(
      --from "$parent_bookmark"
      --repo "$repo"
    )
    [[ -n "$propagate_strategy" ]] && propagate_args+=(--"$propagate_strategy")
    [[ "$propagate_shallow" == true ]]   && propagate_args+=(--shallow)
    [[ "$propagate_force" == true ]]     && propagate_args+=(--force)
    [[ "$propagate_dry_run" == true ]]   && propagate_args+=(--dry-run)
    for t in "${propagate_to[@]+"${propagate_to[@]}"}"; do
      propagate_args+=(--to "$t")
    done
    "$SCRIPT_DIR/propagate" "${propagate_args[@]}"
  fi

  # --- Post-checkin worktree cleanup ---
  # Only with --delete: the task is being removed from the repository, so its
  # dedicated worktrees (recorded above, before the delete removed the
  # branch) are forgotten from the repository model and deleted from disk.
  # Suppressed by --retain-worktree. A checkin without --delete never removes
  # a worktree; use `tt worktree delete` for that. The canonical repository
  # root is never removed, so a checkin run from the primary workspace with
  # its working copy on the child branch cleans up nothing here. The root
  # comparison must canonicalize both sides: when checkin runs from inside
  # the child's own worktree, $repo resolves to that worktree.
  # IMPORTANT: This MUST be the last thing main() does. After _worktree__delete,
  # the script's own files may have been deleted from disk (if the checkin
  # was run from within the child worktree), so no further commands should run.
  if [[ -n "$child_worktrees" ]]; then
    local canon_repo
    canon_repo="$(_path__resolve_symlinks "$(_worktree__resolve_repository_root "$repo")")"
    local child_worktree canon_child ws_name
    while IFS= read -r child_worktree; do
      [[ -z "$child_worktree" ]] && continue
      canon_child="$(realpath "$child_worktree" 2>/dev/null)" || canon_child="$child_worktree"
      [[ "$canon_child" == "$canon_repo" ]] && continue
      # The delegated `tt task delete` deregisters the workspaces of every
      # task in the deleted subtree but leaves their files on disk, so the
      # workspace name usually no longer resolves by this point; remove the
      # files directly in that case.
      if ws_name="$(_worktree__resolve_name "$repo" "$child_worktree")"; then
        _worktree__delete "$repo" "$ws_name" "$child_worktree"
      else
        rm -rf "$child_worktree"
      fi
      # Do NOT execute any further commands after the current worktree is
      # removed: the script's own files may have been deleted from disk.
    done <<< "$child_worktrees"
  fi
}

main "$@"
