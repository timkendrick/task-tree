#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# Create a task file and jj bookmark (branch) for bootstrapping task-tree.
#
# For project tasks: use --project to create a top-level project branch.
# For all other tasks (default): branches from current branch or --parent.
#
# Usage:
#   create [options...]
#   create --title <title> [options...]
#   create --slug <slug> --title <title> [options...]
#
# Options:
#   --title TITLE          Task title (prompted if missing and stdin is a TTY)
#   --slug SLUG            Human-readable slug (prompted with suggested default if missing)
#   --body "TEXT"          Task body/description (prompted if missing and stdin is a TTY)
#   --parent TASK-ID       Parent task ID (default: current branch); mutually exclusive with --project
#   --project              Create a parentless project task; mutually exclusive with --parent
#   --target COMMIT-REV    (with --project) Fork project branch from this revision (default: current @)
#   --label LABEL          Add a label (repeatable)
#   --repo PATH            Repository root (default: walk up to find .jj)
#   --dry-run              Show what would be done without making changes
#   --force                Overwrite child branch if it already exists
#   --propagate            After creation, propagate parent's new commit to sibling branches
#   --rebase               (with --propagate) Rebase descendants onto parent tip (default)
#   --merge                (with --propagate) Merge parent tip into descendants
#   --shallow              (with --propagate) Propagate to direct children only
#   --checkout             After creation, run checkout on the newly created task
#   --worktree[=<path>]    (with --checkout) Use or create a dedicated jj workspace for the task
#

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat >&2 <<EOF
Usage: ${SCRIPT_NAME} [options...]

Create a task file and jj bookmark for task-tree bootstrap.

Options:
  --title TITLE         Task title/summary (prompted if missing and interactive)
  --slug SLUG           Human-readable slug (prompted with suggested default if missing)
  --body TEXT           Task body/description (prompted if missing and interactive)
  --parent TASK-ID      Parent task ID (default: current branch); mutually exclusive with --project
  --project             Create a parentless project task; mutually exclusive with --parent
  --target COMMIT-REV   (with --project) Fork project branch from this revision (default: current @)
  --label LABEL         Add a label (repeatable)
  --repo PATH           Repository root (default: walk up to find .jj)
  --dry-run             Show what would be done, do not execute
  --force               Overwrite child/project branch if it already exists
  --propagate           After creation, propagate parent's new commit to sibling branches
  --rebase              (with --propagate) Rebase descendants onto parent tip (default)
  --merge               (with --propagate) Merge parent tip into descendants
  --shallow             (with --propagate) Propagate to direct children only
  --checkout            After creation, run checkout on the newly created task
  --worktree[=<path>]   (with --checkout) Use or create a dedicated jj workspace for the task

Examples:
  ${SCRIPT_NAME}                                    # prompts for title, slug, body
  ${SCRIPT_NAME} --title "Phase 0: Test harness" --body "Set up the test harness"
  ${SCRIPT_NAME} --slug tt-task-list --title "tt task list" --parent task/phase-0-abc123de --label tdd --body "Implement tt task list"
  ${SCRIPT_NAME} --project --title "Main app" --body "Primary application"
  ${SCRIPT_NAME} --project --title "Main app" --target abc123 --body "Fork from specific revision"
  ${SCRIPT_NAME} --title "New feature" --body "Add new feature" --propagate --shallow
  ${SCRIPT_NAME} --slug my-task --title "My task" --checkout
  ${SCRIPT_NAME} --slug my-task --title "My task" --checkout --worktree

EOF
  exit 1
}

# Usage: resolve_parent PARENT_ARG REPO TASK_PREFIX PROJECT_PREFIX
#
# Resolve the parent for task creation: either from explicit --parent or from current branch.
# Outputs three lines to stdout:
#   line 1: parent_rev      — commit ID to branch from
#   line 2: parent_task_file — path to parent task file, or empty (top-level task)
#   line 3: parent_bookmark — bookmark name to update after adding subtask, or empty
#
# When PARENT_ARG is non-empty: resolves that task-id/bookmark. If it's a task or project
#   branch, derives task file path from the ID and outputs the bookmark to update.
#
# When PARENT_ARG is empty: calls resolve_current to use the current branch.
#
# Exits 1 if parent not found.
resolve_parent() {
  local parent_arg="$1"
  local repo="$2"
  local task_prefix="$3"
  local project_prefix="$4"
  local jj_opts=(-R "$repo")

  if [[ -n "$parent_arg" ]]; then
    # Explicit --parent <task-id>
    local parent_task_id="$parent_arg"
    local parent_rev
    if ! parent_rev="$(jj "${jj_opts[@]}" log -r "$parent_task_id" -n 1 --no-graph -T 'commit_id' 2>/dev/null)"; then
      log "Error: Parent task not found: $parent_task_id"
      exit 1
    fi
    if is_task_branch "$parent_task_id" "$task_prefix"; then
      local suffix="${parent_task_id#$task_prefix}"
      printf '%s\n%s\n%s\n' "$parent_rev" "$(task_file_path "$suffix")" "$parent_task_id"
    elif is_project_branch "$parent_task_id" "$project_prefix"; then
      local suffix="${parent_task_id#$project_prefix}"
      printf '%s\n%s\n%s\n' "$parent_rev" "$(task_file_path "$suffix")" "$parent_task_id"
    else
      printf '%s\n\n\n' "$parent_rev"
    fi
  else
    resolve_current "$repo" "$task_prefix" "$project_prefix"
  fi
}

# Usage: write_task_stub REPO TASK_SUFFIX
#
# Write a minimal task file stub in the directory format.
# Creates .tt/task/<suffix>/TASK.md with status, created, updated timestamps.
write_task_stub() {
  local repo="$1"
  local suffix="$2"
  local dir
  dir="$(task_dir_path "$suffix")"
  local file
  file="$(task_file_path "$suffix")"
  local ts
  ts="$(generate_timestamp)"
  mkdir -p "$repo/$dir"
  printf -- '---\nstatus: TODO\ncreated: %s\nupdated: %s\n---\n' "$ts" "$ts" > "$repo/$file"
  log "Created task file: $file"
}

# Usage: add_subtask_to_frontmatter PARENT_PATH TASK_ID
#
# Add a subtask line before the closing --- of YAML frontmatter in the parent task file.
add_subtask_to_frontmatter() {
  local parent_path="$1"
  local task_id="$2"
  local tmpfile
  tmpfile="$(mktemp)"
  awk -v task_id="$task_id" '
    /^---$/ { sep++; if (sep == 2) { print "subtask: [ ] " task_id } }
    { print }
  ' "$parent_path" > "$tmpfile"
  mv "$tmpfile" "$parent_path"
}

main() {
  local slug=''
  local slug_explicit=false
  local title=''
  local body=''
  local has_body=false
  local -a labels=()
  local is_project=false
  local target=''
  local parent=''
  local repo=''
  local dry_run=false
  local force=false
  local propagate=false
  local propagate_strategy='rebase'
  local propagate_shallow=false
  local checkout=false
  local checkout_worktree=false
  local checkout_worktree_path=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --slug)
        [[ $# -lt 2 ]] && { log "Error: --slug requires an argument"; usage; }
        slug="$2"
        slug_explicit=true
        shift 2
        ;;
      --title)
        [[ $# -lt 2 ]] && { log "Error: --title requires an argument"; usage; }
        title="$2"
        shift 2
        ;;
      --body|--description)
        [[ $# -lt 2 ]] && { log "Error: $1 requires an argument"; usage; }
        body="$2"
        has_body=true
        shift 2
        ;;
      --label)
        [[ $# -lt 2 ]] && { log "Error: --label requires an argument"; usage; }
        labels+=("$2")
        shift 2
        ;;
      --project)
        is_project=true
        shift
        ;;
      --target)
        [[ $# -lt 2 ]] && { log "Error: --target requires an argument"; usage; }
        target="$2"
        shift 2
        ;;
      --parent)
        [[ $# -lt 2 ]] && { log "Error: --parent requires an argument"; usage; }
        parent="$2"
        shift 2
        ;;
      --repo)
        [[ $# -lt 2 ]] && { log "Error: --repo requires an argument"; usage; }
        repo="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=true
        shift
        ;;
      --force)
        force=true
        shift
        ;;
      --propagate)
        propagate=true
        shift
        ;;
      --rebase)
        propagate_strategy='rebase'
        shift
        ;;
      --merge)
        propagate_strategy='merge'
        shift
        ;;
      --shallow)
        propagate_shallow=true
        shift
        ;;
      --checkout)
        checkout=true
        shift
        ;;
      --worktree)
        checkout_worktree=true
        shift
        ;;
      --worktree=*)
        checkout_worktree=true
        checkout_worktree_path="${1#--worktree=}"
        shift
        ;;
      -h|--help)
        usage
        ;;
      *)
        log "Error: Unknown option: $1"
        usage
        ;;
    esac
  done

  if [[ -z "$title" ]]; then
    if [[ -t 0 ]]; then
      read -e -p "Enter a title: " title
    fi
    if [[ -z "$title" ]]; then
      log "Error: Title is required (use --title or enter when prompted)"
      usage
    fi
  fi

  local default_slug
  default_slug="$(title_to_slug "$title")"
  if [[ "$slug_explicit" == false ]]; then
    if [[ -z "$default_slug" ]]; then
      log "Error: Could not generate slug from title: $title"
      exit 1
    fi
    if [[ -t 0 ]]; then
      local prompted_slug
      read -e -p "Enter a task identifier (defaults to $default_slug): " prompted_slug
      slug="${prompted_slug:-$default_slug}"
    else
      slug="$default_slug"
    fi
  fi
  if ! validate_slug "$slug"; then
    exit 1
  fi

  if [[ "$has_body" == false ]]; then
    if [[ -t 0 ]]; then
      body="$(prompt_raw </dev/null)"
    fi
  fi

  if [[ "$is_project" == true && -n "$parent" ]]; then
    log "Error: --project and --parent are mutually exclusive"
    exit 1
  fi

  if [[ -n "$target" && "$is_project" == false ]]; then
    log "Error: --target is only valid with --project"
    exit 1
  fi

  if [[ "$checkout_worktree" == true && "$checkout" == false ]]; then
    log "Error: --worktree is only valid with --checkout"
    exit 1
  fi

  # Resolve repo root: walk up from current directory to find .jj
  if [[ -z "$repo" ]]; then
    if ! repo="$(find_repo_root)"; then
      log "Error: No enclosing jj repository (no .jj directory found). Use --repo to specify."
      exit 1
    fi
  fi

  if [[ ! -d "$repo/.jj" ]]; then
    log "Error: Not a jj repository: $repo"
    exit 1
  fi

  local -a jj_opts=(-R "$repo")

  # Resolve task prefix and project prefix from config
  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Choose the active prefix based on mode
  local active_prefix
  if [[ "$is_project" == true ]]; then
    active_prefix="$project_prefix"
  else
    active_prefix="$task_prefix"
  fi

  # Resolve parent: from --parent or default (current branch); not used for --project
  local resolve_output
  local parent_rev=''
  local parent_task_file=''
  local parent_bookmark=''
  if [[ "$is_project" == false ]]; then
    resolve_output="$(resolve_parent "$parent" "$repo" "$task_prefix" "$project_prefix")"
    parent_rev="$(printf '%s' "$resolve_output" | head -n 1)"
    parent_task_file="$(printf '%s' "$resolve_output" | sed -n '2p')"
    parent_bookmark="$(printf '%s' "$resolve_output" | sed -n '3p')"
  else
    # --project mode: fork from --target if given, else current @
    if [[ -n "$target" ]]; then
      if ! parent_rev="$(jj "${jj_opts[@]}" log -r "$target" -n 1 --no-graph -T 'commit_id' 2>/dev/null)"; then
        log "Error: --target revision not found: $target"
        exit 1
      fi
    else
      parent_rev="$(jj "${jj_opts[@]}" log -r '@' -n 1 --no-graph -T 'commit_id')"
    fi
  fi

  # Generate task ID
  local task_hex
  task_hex="$(generate_hex)"
  local task_id="${active_prefix}${slug}-${task_hex}"
  local task_suffix="${slug}-${task_hex}"
  local task_file
  task_file="$(task_file_path "$task_suffix")"

  if [[ "$dry_run" == true ]]; then
    log "Dry run: would create task $task_id"
    log "  Task file: $task_file"
    log "  Title: $title"
    log "  Mode: $( [[ "$is_project" == true ]] && echo project || echo task )"
    log "  Parent rev: $parent_rev"
    [[ -n "$parent_task_file" ]] && log "  Parent task file: $parent_task_file"
    log "  JJ bookmark: $task_id"
    exit 0
  fi

  # Refuse to create a child under a completed (DONE) parent task.
  if [[ -n "$parent_task_file" ]]; then
    local parent_status
    parent_status="$(jj "${jj_opts[@]}" file show "$parent_task_file" --revision "$parent_bookmark" 2>/dev/null \
      | awk '/^status:/ { print $2; exit }')"
    if [[ "$parent_status" == "DONE" ]]; then
      log "Error: Parent task '$parent_bookmark' has status DONE. Completed tasks are immutable; create new tasks under a different parent."
      exit 1
    fi
  fi

  # Capture revision user had checked out; restore it on exit so we leave them where they were.
  # Use inline trap to capture values at definition time (locals are gone when EXIT runs).
  local original_rev
  original_rev="$(get_worktree_current_rev "$repo")"
  # If the working copy is currently on the parent branch (it's our closest ancestor bookmark),
  # leave it at the updated parent tip after task creation rather than restoring to the now-stale
  # original revision. Otherwise, restore as normal.
  local current_bookmark
  current_bookmark="$(resolve_current "$repo" "$task_prefix" "$project_prefix" | sed -n '3p')"
  if [[ -n "$parent_bookmark" ]] && [[ "$current_bookmark" == "$parent_bookmark" ]]; then
    trap 'jj -R "'"$repo"'" new "'"$parent_bookmark"'" 2>/dev/null || true' EXIT
  else
    trap '[[ -n "'"$original_rev"'" ]] && jj -R "'"$repo"'" edit "'"$original_rev"'" 2>/dev/null || true' EXIT
  fi

  # Check whether the target bookmark already exists; refuse unless --force
  local bookmark_existed=false
  if jj "${jj_opts[@]}" log -r "$task_id" -n 1 --no-graph -T '' 2>/dev/null; then
    if [[ "$force" == false ]]; then
      log "Error: Branch '$task_id' already exists. Use --force to overwrite."
      exit 1
    fi
    bookmark_existed=true
    log "Warning: Branch '$task_id' already exists; overwriting (--force)."
  fi

  jj "${jj_opts[@]}" new "$parent_rev"

  # Ensure .tt/task exists
  mkdir -p "$repo/.tt/task"

  if [[ "$is_project" == true ]]; then
    # Project task: first commit creates the stub task file; second commit (via edit) sets metadata.
    write_task_stub "$repo" "$task_suffix"
    jj "${jj_opts[@]}" describe -m "Create project: $title"
    jj "${jj_opts[@]}" bookmark set "$task_id" $( [[ "$bookmark_existed" == true ]] && echo '--allow-backwards' || true )
    jj "${jj_opts[@]}" new "@"
    jj "${jj_opts[@]}" bookmark set "$task_id"
    local edit_args=(--repo "$repo" --title "$title")
    [[ -n "$body" ]] && edit_args+=(--body "$body")
    for label in "${labels[@]+"${labels[@]}"}"; do edit_args+=(--label "$label"); done
    "$SCRIPT_DIR/edit" "${edit_args[@]}" "$task_id"
  elif [[ -n "$parent_task_file" ]]; then
    # Child task: commit on parent branch creates the stub and registers the subtask;
    # the child branch's initial commit (via edit) sets title, body, and labels.
    local parent_path="$repo/$parent_task_file"
    if [[ ! -f "$parent_path" ]]; then
      log "Error: Parent task file not found: $parent_path"
      exit 1
    fi
    write_task_stub "$repo" "$task_suffix"
    add_subtask_to_frontmatter "$parent_path" "$task_id"
    log "Added subtask to parent: $parent_task_file"
    jj "${jj_opts[@]}" describe -m "Create task: $title ($task_id)"
    jj "${jj_opts[@]}" bookmark set "$parent_bookmark"
    jj "${jj_opts[@]}" new "@"
    jj "${jj_opts[@]}" bookmark set "$task_id" $( [[ "$bookmark_existed" == true ]] && echo '--allow-backwards' || true )
    local edit_args=(--repo "$repo" --title "$title")
    [[ -n "$body" ]] && edit_args+=(--body "$body")
    for label in "${labels[@]+"${labels[@]}"}"; do edit_args+=(--label "$label"); done
    "$SCRIPT_DIR/edit" "${edit_args[@]}" "$task_id"
  else
    # Child task with no identifiable parent task file (e.g. branching from a non-task bookmark).
    # Create the stub and bookmark without modifying any parent; edit sets metadata.
    write_task_stub "$repo" "$task_suffix"
    jj "${jj_opts[@]}" describe -m "Create task: $title ($task_id)"
    jj "${jj_opts[@]}" new "@"
    jj "${jj_opts[@]}" bookmark set "$task_id" $( [[ "$bookmark_existed" == true ]] && echo '--allow-backwards' || true )
    local edit_args=(--repo "$repo" --title "$title")
    [[ -n "$body" ]] && edit_args+=(--body "$body")
    for label in "${labels[@]+"${labels[@]}"}"; do edit_args+=(--label "$label"); done
    "$SCRIPT_DIR/edit" "${edit_args[@]}" "$task_id"
  fi

  log "Created task $task_id (bookmark: $task_id)"

  if [[ "$propagate" == true ]] && [[ -n "$parent_bookmark" ]]; then
    local -a propagate_args=(--from "$parent_bookmark" --repo "$repo")
    [[ "$propagate_strategy" == merge ]] && propagate_args+=(--merge)
    [[ "$propagate_shallow" == true ]] && propagate_args+=(--shallow)
    [[ "$force" == true ]] && propagate_args+=(--force)
    [[ "$dry_run" == true ]] && propagate_args+=(--dry-run)
    log "Propagating from $parent_bookmark..."
    "$SCRIPT_DIR/propagate" "${propagate_args[@]}"
  fi

  if [[ "$checkout" == true ]]; then
    trap - EXIT
    local -a checkout_args=(--repo "$repo" "$task_id")
    if [[ "$checkout_worktree" == true ]]; then
      if [[ -n "$checkout_worktree_path" ]]; then
        checkout_args+=(--worktree="$checkout_worktree_path")
      else
        checkout_args+=(--worktree)
      fi
    fi
    "$SCRIPT_DIR/checkout" "${checkout_args[@]}"
  fi

  printf '%s\n' "$task_id"
}

main "$@"
