#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# Create a task file and branch bookmark for bootstrapping task-tree.
#
# For project tasks: use --project to create a top-level project branch.
# For all other tasks (default): branches from current branch or --parent.
#
# Usage:
#   create [options...]
#   create --title <title> [options...]
#   create --slug <slug> --title <title> [options...]
#
# Options:
#   --title TITLE          Task title (prompted if missing and stdin is a TTY)
#   --slug SLUG            Human-readable slug (required in non-interactive mode; prompted otherwise)
#   --parent TASK-ID       Parent task ID (default: current branch); mutually exclusive with --project
#   --project              Create a parentless project task; mutually exclusive with --parent
#   --target COMMIT-REV    (with --project) Fork project branch from this revision (default: current @)
#   --label LABEL          Add a label (repeatable)
#   --repo PATH            Repository root (overrides TT_REPO; default: walk up to find .jj)
#   --dry-run              Show what would be done without making changes
#   --force                Overwrite child branch if it already exists
#   --propagate            After creation, propagate parent's new commit to sibling branches
#   --rebase               (with --propagate) Rebase descendants onto parent tip (default)
#   --merge                (with --propagate) Merge parent tip into descendants
#   --shallow              (with --propagate) Propagate to direct children only
#   --checkout             After creation, run checkout on the newly created task
#   --worktree[=<path>]    (with --checkout) Use or create a dedicated workspace for the task
#   --switch              (with --checkout --worktree) Also update the HEAD symlink to the new worktree
#

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [options...]

Create a task file and branch bookmark for task-tree bootstrap.

Options:
  --title TITLE         Task title/summary (prompted if missing and interactive)
  --slug SLUG           Human-readable slug (required in non-interactive mode; prompted otherwise)
  --parent TASK-ID      Parent task ID (default: current branch); mutually exclusive with --project
  --project             Create a parentless project task; mutually exclusive with --parent
  --target COMMIT-REV   (with --project) Fork project branch from this revision (default: current @)
  --label LABEL         Add a label (repeatable)
  --repo PATH           Repository root (overrides TT_REPO; default: walk up to find .jj)
  --dry-run             Show what would be done, do not execute
  --force               Overwrite child/project branch if it already exists
  --propagate           After creation, propagate parent's new commit to sibling branches
  --rebase              (with --propagate) Rebase descendants onto parent tip (default)
  --merge               (with --propagate) Merge parent tip into descendants
  --shallow             (with --propagate) Propagate to direct children only
  --checkout            After creation, run checkout on the newly created task
  --worktree[=<path>]   (with --checkout) Use or create a dedicated workspace for the task
  --switch              (with --checkout --worktree) Also update the HEAD symlink to the new worktree

Body is read from stdin (via pipe or redirect) if stdin is not a terminal;
otherwise opens an editor for body input.

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}                                    # prompts for title, slug, body (editor)
  ${COMMAND_NAME:-$SCRIPT_NAME} --title "Phase 0: Test harness"   # prompts for body (editor)
  echo "Set up the test harness" | ${COMMAND_NAME:-$SCRIPT_NAME} --title "Phase 0: Test harness"
  ${COMMAND_NAME:-$SCRIPT_NAME} --title "Phase 0: Test harness" < ./description.md
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug tt-task-list --parent task/phase-0-abc123de --label tdd < ./description.md
  ${COMMAND_NAME:-$SCRIPT_NAME} --project --title "Main app" < ./description.md
  ${COMMAND_NAME:-$SCRIPT_NAME} --project --title "Main app" --target abc123 < ./description.md
  ${COMMAND_NAME:-$SCRIPT_NAME} --title "New feature" --propagate --shallow < ./description.md
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug my-task --title "My task" --checkout
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug my-task --title "My task" --checkout --worktree
  ${COMMAND_NAME:-$SCRIPT_NAME} --slug my-task --title "My task" --checkout --worktree --switch

EOF
}

# Usage: resolve_parent PARENT_ARG REPO TASK_PREFIX PROJECT_PREFIX
#
# Resolve the parent for task creation: either from explicit --parent or from current branch.
# Outputs three lines to stdout:
#   line 1: parent_rev      — commit ID to branch from
#   line 2: parent_task_file — path to parent task file, or empty (top-level task)
#   line 3: parent_bookmark — bookmark name to update after adding subtask, or empty
#
# When PARENT_ARG is non-empty: resolves that task-id/bookmark. If it's a task or project
#   branch, derives task file path from the ID and outputs the bookmark to update.
#
# When PARENT_ARG is empty: calls _task__resolve_current to use the current branch.
#
# Exits 1 if parent not found.
resolve_parent() {
  local parent_arg="$1"
  local repo="$2"
  local task_prefix="$3"
  local project_prefix="$4"

  if [[ -n "$parent_arg" ]]; then
    # Explicit --parent <task-id>
    local parent_task_id="$parent_arg"
    local parent_rev
    if ! parent_rev="$(_task__resolve_revision "$repo" "$parent_task_id")"; then
      _ui__log "Error: Parent task not found: $parent_task_id"
      exit 1
    fi
    if _task__check_is_task_branch "$parent_task_id" "$task_prefix"; then
      local suffix="${parent_task_id#$task_prefix}"
      printf '%s\n%s\n%s\n' "$parent_rev" "$(_path__task_file "$suffix")" "$parent_task_id"
    elif _task__check_is_project_branch "$parent_task_id" "$project_prefix"; then
      local suffix="${parent_task_id#$project_prefix}"
      printf '%s\n%s\n%s\n' "$parent_rev" "$(_path__task_file "$suffix")" "$parent_task_id"
    else
      printf '%s\n\n\n' "$parent_rev"
    fi
  else
    _task__resolve_current "$repo" "$task_prefix" "$project_prefix"
  fi
}

main() {
  local slug=''
  local slug_explicit=false
  local title=''
  local -a labels=()
  local is_project=false
  local target=''
  local parent=''
  local repo=''
  local dry_run=false
  local force=false
  local propagate=false
  local propagate_strategy='rebase'
  local propagate_shallow=false
  local checkout=false
  local checkout_worktree=false
  local checkout_worktree_path=''
  local checkout_switch=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --slug)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        slug="$2"
        slug_explicit=true
        shift 2
        ;;
      --title)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        title="$2"
        shift 2
        ;;
      --label)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        labels+=("$2")
        shift 2
        ;;
      --project)
        is_project=true
        shift
        ;;
      --target)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        target="$2"
        shift 2
        ;;
      --parent)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        parent="$2"
        shift 2
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=true
        shift
        ;;
      --force)
        force=true
        shift
        ;;
      --propagate)
        propagate=true
        shift
        ;;
      --rebase)
        propagate_strategy='rebase'
        shift
        ;;
      --merge)
        propagate_strategy='merge'
        shift
        ;;
      --shallow)
        propagate_shallow=true
        shift
        ;;
      --checkout)
        checkout=true
        shift
        ;;
      --worktree)
        checkout_worktree=true
        shift
        ;;
      --worktree=*)
        checkout_worktree=true
        checkout_worktree_path="${1#--worktree=}"
        shift
        ;;
      --switch)
        checkout_switch=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  if [[ "$is_project" == true && -n "$parent" ]]; then
    usage >&2; exit 1
  fi

  if [[ -n "$target" && "$is_project" == false ]]; then
    usage >&2; exit 1
  fi

  if [[ "$checkout_worktree" == true && "$checkout" == false ]]; then
    usage >&2; exit 1
  fi

  if [[ "$checkout_switch" == true && "$checkout_worktree" == false ]]; then
    usage >&2; exit 1
  fi

  repo="$(_workspace__resolve_repo "$repo")"

  # Resolve task prefix and project prefix from config
  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Choose the active prefix based on mode
  local active_prefix
  if [[ "$is_project" == true ]]; then
    active_prefix="$project_prefix"
  else
    active_prefix="$task_prefix"
  fi

  # Resolve parent: from --parent or default (current branch); not used for --project
  local resolve_output
  local parent_rev=''
  local parent_task_file=''
  local parent_bookmark=''
  if [[ "$is_project" == false ]]; then
    resolve_output="$(resolve_parent "$parent" "$repo" "$task_prefix" "$project_prefix")"
    parent_rev="$(printf '%s' "$resolve_output" | head -n 1)"
    parent_task_file="$(printf '%s' "$resolve_output" | sed -n '2p')"
    parent_bookmark="$(printf '%s' "$resolve_output" | sed -n '3p')"
  else
    # --project mode: fork from --target if given, else current @
    if [[ -n "$target" ]]; then
      if ! parent_rev="$(_task__resolve_revision "$repo" "$target")"; then
        _ui__log "Error: --target revision not found: $target"
        exit 1
      fi
    else
      parent_rev="$(_task__resolve_revision "$repo" '@')"
    fi
  fi

  if [[ -n "$parent_bookmark" ]]; then
    _ui__log "Creating task under parent: $parent_bookmark"
  fi

  if [[ -z "$title" ]]; then
    if [[ -t 0 ]]; then
      read -e -p "Enter a title: " title
    fi
    if [[ -z "$title" ]]; then
      usage >&2; exit 1
    fi
  fi

  if [[ "$slug_explicit" == false ]]; then
    local default_slug
    default_slug="$(_string__to_slug "$title")"
    if [[ -z "$default_slug" ]]; then
      _ui__log "Error: Could not generate slug from title: $title"
      exit 1
    fi
    if [[ -t 0 ]]; then
      local prompted_slug
      read -e -p "Enter a task identifier (defaults to $default_slug): " prompted_slug
      slug="${prompted_slug:-$default_slug}"
    else
      usage >&2; exit 1
    fi
  fi
  if ! _string__validate_slug "$slug"; then
    exit 1
  fi

  # Acquire body text
  local body
  if [[ -t 0 ]]; then
    # Interactive: open editor for body
    local raw
    raw="$(_ui__prompt_raw </dev/null)" || {
      _ui__log "Error: Editor exited with non-zero status."
      exit 1
    }
    body="$raw"
  else
    # Read from stdin (pipe or redirect)
    body="$(cat)"
  fi

  # Generate task ID
  local task_hex
  task_hex="$(_string__generate_hex)"
  local task_id="${active_prefix}${slug}-${task_hex}"
  local task_suffix="${slug}-${task_hex}"
  local task_file
  task_file="$(_path__task_file "$task_suffix")"

  if [[ "$dry_run" == true ]]; then
    _ui__log "Dry run: would create task $task_id"
    _ui__log "  Task file: $task_file"
    _ui__log "  Title: $title"
    _ui__log "  Mode: $( [[ "$is_project" == true ]] && echo project || echo task )"
    _ui__log "  Parent rev: $parent_rev"
    [[ -n "$parent_task_file" ]] && _ui__log "  Parent task file: $parent_task_file"
    _ui__log "  JJ bookmark: $task_id"
    exit 0
  fi

  # Detect a completed (DONE) parent task: it is reopened via `tt task checkout`
  # before the child is created (see DESIGN.md §6.1).
  local parent_is_done=false
  if [[ -n "$parent_task_file" ]]; then
    local parent_content
    if ! parent_content="$(_task__read_file "$repo" "$parent_bookmark" "$parent_task_file")"; then
      _ui__log "Error: Parent task file not found: $repo/$parent_task_file"
      exit 1
    fi
    local parent_line
    while IFS= read -r parent_line; do
      if [[ "$parent_line" == 'status:'* ]]; then
        parent_line="${parent_line#status:}"
        parent_line="${parent_line#"${parent_line%%[![:space:]]*}"}"
        [[ "${parent_line%% *}" == "DONE" ]] && parent_is_done=true
        break
      fi
    done <<< "$parent_content"
  fi

  # Check whether the target bookmark already exists; refuse unless --force
  local bookmark_existed=false
  if _task__check_branch_exists "$repo" "$task_id"; then
    if [[ "$force" == false ]]; then
      _ui__log "Error: Branch '$task_id' already exists. Use --force to overwrite."
      exit 1
    fi
    bookmark_existed=true
    _ui__log "Warning: Branch '$task_id' already exists; overwriting (--force)."
  fi

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  # Reopen a completed parent before adding the child. `tt task checkout` creates the
  # status -> IN-PROGRESS commit and advances the parent bookmark, so parent_rev (a
  # commit id captured before the reopen) must be re-resolved afterwards.
  if [[ "$parent_is_done" == true ]]; then
    _ui__log "Parent task '$parent_bookmark' is DONE; reopening before creating child..."
    "$SCRIPT_DIR/checkout" "$parent_bookmark" --repo "$repo" >/dev/null
    parent_rev="$(_task__resolve_revision "$repo" "$parent_bookmark")"
  fi

  local create_message
  create_message="$(_commit__format_message "task" "create" "$task_id" "$title")"

  # One timestamp for every copy of the stub written by this invocation, so
  # the child branch's first commit carries a byte-identical stub to the copy
  # committed on the parent branch.
  local stub_ts
  stub_ts="$(_string__generate_timestamp)"

  # Writer invoked with a staging root: stages the new task's stub file.
  create_stub_writer() {
    local root="$1"
    _task__write_stub "$root" "$task_suffix" "$stub_ts"
  }

  # Pass --allow-backwards to the branch creation when overwriting an
  # existing bookmark (--force): its current position need not be an
  # ancestor of the re-created branch tip.
  local -a new_branch_flags=()
  if [[ "$bookmark_existed" == true ]]; then
    new_branch_flags=(--allow-backwards)
  fi

  # Metadata commit on the new branch: the commit `tt task edit` records for
  # the title, labels and body, made here in the same process. The stub the
  # branch starts from is TODO with the creation timestamp and nothing else.
  commit_metadata() {
    local updated
    updated="$(_string__generate_timestamp)"
    local REWRITE_LABELS=("${labels[@]+"${labels[@]}"}") REWRITE_SUBTASKS=() REWRITE_CONTEXTS=()
    metadata_writer() {
      local root="$1"
      _frontmatter__write_task_file "$root/$task_file" \
        "$title" "TODO" "$body" "$stub_ts" "$updated"
    }
    _task__commit_on_branch "$repo" "$task_id" \
      "$(_commit__format_message "task" "edit" "$task_id" "$title")" \
      --modify "$task_file" -- metadata_writer >/dev/null
    _worktree__report_unsynced "$repo" "$task_id"
  }

  if [[ "$is_project" == true ]]; then
    # Project task: the branch's first commit creates the stub task file on
    # top of the fork revision; the metadata commit follows on the
    # new branch and advances its bookmark.
    _task__commit_new_branch "$repo" "$task_id" "$parent_rev" "$create_message" \
      "${new_branch_flags[@]+"${new_branch_flags[@]}"}" -- create_stub_writer >/dev/null
    _ui__log "Created task file: $task_file"
    commit_metadata
  elif [[ -n "$parent_task_file" ]]; then
    # Child task: one commit on the parent branch creates the stub and
    # registers the subtask entry; the child branch then forks from that
    # commit with its own first commit (the same stub content), and the
    # metadata commit follows on the child branch.
    create_parent_writer() {
      local root="$1"
      _task__write_stub "$root" "$task_suffix" "$stub_ts"
      _frontmatter__append_subtask "$root/$parent_task_file" "$task_id"
    }
    local parent_tip
    parent_tip="$(_task__commit_on_branch "$repo" "$parent_bookmark" "$create_message" \
      --modify "$parent_task_file" -- create_parent_writer)"
    _ui__log "Created task file: $task_file"
    _ui__log "Added subtask to parent: $parent_task_file"
    _task__commit_new_branch "$repo" "$task_id" "$parent_tip" "$create_message" \
      "${new_branch_flags[@]+"${new_branch_flags[@]}"}" -- create_stub_writer >/dev/null
    _worktree__report_unsynced "$repo" "$parent_bookmark"
    commit_metadata
  else
    # Child task with no identifiable parent task file (e.g. branching from a
    # non-task bookmark). Create the stub commit and bookmark without
    # modifying any parent; edit sets metadata.
    _task__commit_new_branch "$repo" "$task_id" "$parent_rev" "$create_message" \
      "${new_branch_flags[@]+"${new_branch_flags[@]}"}" -- create_stub_writer >/dev/null
    _ui__log "Created task file: $task_file"
    commit_metadata
  fi

  _ui__log "Created task $task_id (bookmark: $task_id)"

  if [[ "$propagate" == true ]] && [[ -n "$parent_bookmark" ]]; then
    local -a propagate_args=(--from "$parent_bookmark" --repo "$repo")
    [[ "$propagate_strategy" == merge ]] && propagate_args+=(--merge)
    [[ "$propagate_shallow" == true ]] && propagate_args+=(--shallow)
    [[ "$force" == true ]] && propagate_args+=(--force)
    [[ "$dry_run" == true ]] && propagate_args+=(--dry-run)
    _ui__log "Propagating from $parent_bookmark..."
    "$SCRIPT_DIR/propagate" "${propagate_args[@]}" >&2
  fi

  if [[ "$checkout" == true ]]; then
    # Checkout handles WC positioning. Without --checkout nothing needs to be
    # restored: the branch writes above never move the working copy (beyond
    # keeping a working copy that sat on the parent tip attached to it).
    local -a checkout_args=(--repo "$repo" "$task_id")
    if [[ "$checkout_worktree" == true ]]; then
      if [[ -n "$checkout_worktree_path" ]]; then
        checkout_args+=(--worktree="$checkout_worktree_path")
      else
        checkout_args+=(--worktree)
      fi
      if [[ "$checkout_switch" == true ]]; then
        checkout_args+=(--switch)
      fi
    fi
    "$SCRIPT_DIR/checkout" "${checkout_args[@]}" >&2
  fi

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  printf '%s\n' "$task_id"
}

main "$@"
