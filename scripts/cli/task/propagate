#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task propagate — Rebase/merge descendant task branches onto their parent's current tip.
#
# Computes the transitive closure of child branches registered under --from (or the current
# branch) and rebases each one that is behind the parent onto the parent's current tip.
#
# Every commit on a child's own line points the task symlink at the child, and propagate
# keeps it that way:
#   - A child whose whole history is already in the parent's, but whose task is not DONE,
#     advances onto a new fork commit on the parent's tip (under either strategy).
#   - A rebase whose moved commits hang off a commit of the child's own line (left there
#     by an earlier check-in) puts a fork commit on the parent's tip underneath them.
#   - A merge is described as '[tt:task:<parent-id>:propagate] <parent title>' and takes
#     the task symlink from the child's previous tip.
# Propagate never creates an empty commit.
#
# Usage:
#   propagate [options...]
#
# Options:
#   --from PARENT_ID  Parent task/project branch to propagate from (default: current branch)
#   --to CHILD_ID     Limit propagation to specific child(ren) (repeatable; default: all)
#   --rebase          Rebase descendants onto parent tip (default)
#   --merge           Merge parent tip into each descendant branch
#   --shallow         Update direct children only (do not recurse into grandchildren)
#   --force           Proceed even if conflicts occur after rebase/merge, the working
#                     copy has uncommitted changes, or they touch task metadata
#   --dry-run         Show what would be done without making changes
#   --repo PATH       Repository root (overrides TT_REPO; default: walk up to find .jj)

readonly SCRIPT_NAME="${0##*/}"

# Global: specific --to targets (empty array = all descendants)
TO_FILTER=()

# Global: set when a child is skipped because of an error; the command then
# fails, rolling back every branch it has already updated.
HAS_ERRORS=false

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [options...]

Rebase or merge descendant task branches onto their parent's current tip.

Options:
  --from PARENT_ID  Parent task/project branch to propagate from (default: current branch)
  --to CHILD_ID     Limit propagation to specific child(ren) (repeatable; default: all)
  --rebase          Rebase descendants onto parent tip (default)
  --merge           Merge parent tip into descendants instead of rebasing
  --shallow         Update direct children only (no recursive propagation)
  --force           Proceed even if conflicts occur, the working copy has
                    uncommitted changes, or they touch task metadata
  --dry-run         Show planned changes without applying them
  --repo PATH       Repository root (overrides TT_REPO; default: find .jj)

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}                                          # rebase all descendants of current task
  ${COMMAND_NAME:-$SCRIPT_NAME} --from project/bootstrap-cli-d35756ce   # propagate from a specific project
  ${COMMAND_NAME:-$SCRIPT_NAME} --shallow                                # direct children only
  ${COMMAND_NAME:-$SCRIPT_NAME} --to task/tt-task-create-5841c217        # one specific child
  ${COMMAND_NAME:-$SCRIPT_NAME} --merge --shallow                        # merge parent into direct children

EOF
}

# Usage: read_title REPO BRANCH TASK_ID TASK_PREFIX PROJECT_PREFIX
# Prints the title of TASK_ID's task file at BRANCH's tip, or nothing when the
# file cannot be read there.
read_title() {
  _task__read_title "$@" || true
}

# Usage: is_up_to_date REPO CHILD_BOOKMARK PARENT_BOOKMARK
# Returns 0 (true) if there are no commits in CHILD_BOOKMARK's ancestry that are not
# already in PARENT_BOOKMARK's ancestry. This handles the case where the child has been
# partially checked in (some commits already merged via a handoff commit), or where the
# parent is already a direct or indirect ancestor of the child. Also true when the
# child's unmerged commits already hang directly off the parent's tip (e.g. a fork
# commit placed there by a prior propagate).
is_up_to_date() {
  local repo="$1" child="$2" parent="$3"
  _task__check_up_to_date "$repo" "$parent" "$child"
}

# Usage: is_behind REPO CHILD_BOOKMARK PARENT_BOOKMARK
# Returns 0 (true) if PARENT_BOOKMARK carries commits that CHILD_BOOKMARK's ancestry
# does not contain. For an up-to-date child this means the child is a strict ancestor
# of the parent: a check-in brought all of the child's work into the parent, and the
# parent moved on.
is_behind() {
  local repo="$1" child="$2" parent="$3"
  # A range is empty exactly when it has no roots, so the roots of the range
  # running from the child to the parent answer the question directly.
  local result
  result="$(_task__list_unmerged_roots "$repo" "$child" "$parent")" || true
  [[ -n "$result" ]]
}

# Usage: read_status REPO CHILD_BOOKMARK TASK_PREFIX PROJECT_PREFIX
# Prints the status recorded by the child's task file at CHILD_BOOKMARK's tip.
# Fails when the task file cannot be read there (e.g. one at a legacy path).
read_status() {
  local repo="$1" child="$2" task_prefix="$3" project_prefix="$4"
  _task__read_status "$repo" "$child" "$child" "$task_prefix" "$project_prefix"
}

# Usage: is_attached_to_own_line REPO CHILD_BOOKMARK PARENT_BOOKMARK TASK_FILE
# Returns 0 (true) if any commit that the child's unmerged range hangs off
# points the task symlink at TASK_FILE, the child's own task file. Such a
# commit is a child commit that an earlier check-in brought into the parent.
# The moved commits then do not include the child's fork commit, so on the
# parent's tip they would inherit the parent's task symlink.
is_attached_to_own_line() {
  local repo="$1" child="$2" parent="$3" task_file="$4"
  local root_parents
  root_parents="$(_task__list_unmerged_root_parents "$repo" "$parent" "$child")" \
    || root_parents=''
  local root_parent target
  while IFS= read -r root_parent; do
    [[ -n "$root_parent" ]] || continue
    target="$(_task__read_symlink "$repo" "$root_parent" "$TT_TASK_SYMLINK_FILENAME")" \
      || continue
    [[ "$target" == "$task_file" ]] && return 0
  done <<< "$root_parents"
  return 1
}

# Usage: get_subtask_ids REPO BOOKMARK TASK_PREFIX PROJECT_PREFIX
# Prints one subtask task-id per line for all checkboxes ([ ], [-], [x]).
# Includes [x] entries so that partially-checked-in children that are still
# active can be propagated to; is_up_to_date handles skipping truly finished ones.
get_subtask_ids() {
  local repo="$1" bookmark="$2" task_prefix="$3" project_prefix="$4"
  local fields
  fields="$(_task__read_fields "$repo" "$bookmark" "$bookmark" \
    "$task_prefix" "$project_prefix" 'subtask[]')" || return 0
  local subtask_count subtask subtasks=() i
  { IFS= read -r subtask_count
    for (( i = 0; i < subtask_count; i++ )); do
      IFS= read -r subtask; subtasks+=("$subtask")
    done
  } <<< "$fields" || true
  printf '%s\n' ${subtasks[@]+"${subtasks[@]}"} | awk '
    /^\[[ x\-]\]/ { sub(/^\[[ x\-]\][ \t]*/, ""); if ($1 != "") print $1 }
  '
}

# Usage: build_fork_commit REPO CHILD_BOOKMARK FROM_BOOKMARK TASK_PREFIX PROJECT_PREFIX
# Builds a fork commit for the child on FROM_BOOKMARK's tip and prints its
# commit ID. The commit points the task symlink at the child's task file. No
# bookmark moves and no worktree is reattached.
build_fork_commit() {
  local repo="$1" child="$2" from="$3" task_prefix="$4" project_prefix="$5"
  local title fork_commit
  title="$(read_title "$repo" "$child" "$child" "$task_prefix" "$project_prefix")"
  fork_commit="$(_task__commit_fork "$repo" "$child" "$from" "$title")" || {
    _ui__log "Error: Could not create a fork commit for '$child' on '$from'."
    exit 1
  }
  printf '%s' "$fork_commit"
}

# Usage: propagate_one_fork REPO CHILD_BOOKMARK FROM_BOOKMARK TASK_PREFIX PROJECT_PREFIX DRY_RUN
# Advances a child whose whole history is already in FROM's history onto a new
# fork commit on FROM's tip. The fork commit points the task symlink back at
# the child, so work resumed there belongs to the child.
propagate_one_fork() {
  local repo="$1" child="$2" from="$3" task_prefix="$4" project_prefix="$5" dry_run="$6"

  if [[ "$dry_run" == true ]]; then
    _ui__log "  [dry-run] fork $child onto $from"
    return 0
  fi

  local child_tip
  child_tip="$(_task__resolve_revision "$repo" "$child")" || {
    _ui__log "Error: Could not resolve branch '$child'."
    exit 1
  }

  local fork_commit
  fork_commit="$(build_fork_commit "$repo" "$child" "$from" "$task_prefix" "$project_prefix")"

  # Follow the advance with the invoking worktree only when it sits on the
  # child branch; worktrees on the parent also descend from the child's old
  # tip, and must not be dragged onto the child.
  _worktree__reattach_current "$repo" "$child" "$child_tip" "$fork_commit"
  _task__advance_branch "$repo" "$child" "$fork_commit"
}

# Usage: propagate_one_rebase REPO CHILD_BOOKMARK FROM_BOOKMARK TASK_FILE TASK_PREFIX PROJECT_PREFIX FORCE DRY_RUN
# Rebases the unmerged range of CHILD_BOOKMARK onto FROM_BOOKMARK.
# If the child has been partially checked in (some commits already in FROM's ancestry
# via a prior handoff merge), only the commits not yet in FROM's ancestry are rebased.
# When the range hangs off a commit of the child's own line, a fork commit on FROM's
# tip goes underneath it, so the moved commits keep pointing the task symlink at the
# child.
propagate_one_rebase() {
  local repo="$1" child="$2" from="$3" task_file="$4"
  local task_prefix="$5" project_prefix="$6" force="$7" dry_run="$8"

  # The roots of the unmerged range are the commits in the child's ancestry not
  # yet in FROM's ancestry that hang off inherited history. Nothing there means
  # the child is already up to date (guard; the caller should have checked).
  local rebase_roots
  rebase_roots="$(_task__list_unmerged_roots "$repo" "$from" "$child")" || true

  if [[ -z "$rebase_roots" ]]; then
    return 0
  fi

  local needs_fork=false
  is_attached_to_own_line "$repo" "$child" "$from" "$task_file" && needs_fork=true

  if [[ "$dry_run" == true ]]; then
    if [[ "$needs_fork" == true ]]; then
      _ui__log "  [dry-run] fork $child onto $from, then rebase $child onto the fork commit"
    else
      _ui__log "  [dry-run] rebase $child onto $from"
    fi
    return 0
  fi

  local destination="$from"
  if [[ "$needs_fork" == true ]]; then
    _ui__log "  $child: creating fork commit"
    destination="$(build_fork_commit "$repo" "$child" "$from" "$task_prefix" "$project_prefix")"
  fi

  _task__move_unmerged_range "$repo" "$from" "$child" "$destination" || {
    _ui__log "Error: Could not rebase $child onto $from."
    exit 1
  }

  # The rebase replays every commit of the range, so a conflict may surface on
  # any of them, not just the branch tip: a later commit can cancel a conflict
  # an earlier one introduced. Commits above the tip moved too.
  if [[ "$force" != true ]] && \
     { _task__check_range_conflicts "$repo" "$from" "$child" || \
       _task__check_descendant_conflicts "$repo" "$child"; }; then
    _ui__log "Error: Conflicts detected in $child after rebase onto $from."
    _ui__log "  Use --force to proceed despite conflicts."
    exit 1
  fi
}

# Usage: propagate_one_merge REPO CHILD_BOOKMARK FROM_BOOKMARK TASK_PREFIX PROJECT_PREFIX FORCE DRY_RUN
# Creates a merge commit on CHILD_BOOKMARK combining its current tip with FROM_BOOKMARK,
# described as a propagate of FROM_BOOKMARK. The merge keeps the child's task symlink.
propagate_one_merge() {
  local repo="$1" child="$2" from="$3" task_prefix="$4" project_prefix="$5"
  local force="$6" dry_run="$7"

  if [[ "$dry_run" == true ]]; then
    local label
    label="$(_commit__format_message "task" "propagate" "$from" "")"
    _ui__log "  [dry-run] merge $from into $child as ${label% }"
    return 0
  fi

  local child_tip
  child_tip="$(_task__resolve_revision "$repo" "$child")" || {
    _ui__log "Error: Could not resolve branch '$child'."
    exit 1
  }

  # A two-parent commit with the child's tip first and the incoming parent tip
  # second. Like a check-in merge, it is described by the incoming task.
  local message merge_commit
  message="$(_commit__format_title_message "task" "propagate" "$from" \
    "$(read_title "$repo" "$from" "$from" "$task_prefix" "$project_prefix")")"
  merge_commit="$(_task__merge_branch "$repo" "$message" "$child_tip" "$from")" || {
    _ui__log "Error: Could not merge '$from' into '$child'."
    exit 1
  }

  # The merge resolves the task symlink to the parent's task file when the
  # parent's side changed it in a check-in handoff, and leaves it conflicted
  # when both sides changed it. The child's own tip records the right target.
  # The restore rewrites the merge, so it runs while nothing descends from it
  # yet, and the merge is found again by its change ID.
  local merge_change
  merge_change="$(_task__resolve_change "$repo" "$merge_commit")" || {
    _ui__log "Error: Could not resolve the merge of '$from' into '$child'."
    exit 1
  }
  _task__restore_symlink "$repo" "$child_tip" "$merge_commit" || {
    _ui__log "Error: Could not restore the task symlink of '$child'."
    exit 1
  }
  merge_commit="$(_task__resolve_revision "$repo" "$merge_change")" || {
    _ui__log "Error: Could not resolve the merge of '$from' into '$child'."
    exit 1
  }

  # Follow the advance with the invoking worktree only when it sits on the
  # child branch; every commit on the incoming parent's line also descends
  # from the child's fork point, so plain descent would relocate worktrees
  # that have nothing to do with this child.
  _worktree__reattach_current "$repo" "$child" "$child_tip" "$merge_commit"
  _task__advance_branch "$repo" "$child" "$merge_commit"

  if [[ "$force" != true ]] && _task__check_conflicts "$repo" "$child"; then
    _ui__log "Error: Conflicts in $child after merging $from."
    _ui__log "  Use --force to proceed despite conflicts."
    exit 1
  fi
}

# Usage: propagate_from REPO FROM_BOOKMARK TASK_PREFIX PROJECT_PREFIX STRATEGY SHALLOW FORCE DRY_RUN DEPTH
# Recursively propagates all registered subtasks of FROM_BOOKMARK onto FROM_BOOKMARK's current tip.
propagate_from() {
  local repo="$1"
  local from_bookmark="$2"
  local task_prefix="$3"
  local project_prefix="$4"
  local strategy="$5"
  local shallow="$6"
  local force="$7"
  local dry_run="$8"
  local depth="${9:-0}"

  if ! _task__resolve_file "$from_bookmark" "$task_prefix" "$project_prefix" >/dev/null; then
    _ui__log "  Warning: $from_bookmark is not a task/project branch; cannot enumerate subtasks"
    return 0
  fi

  local subtasks
  subtasks="$(get_subtask_ids "$repo" "$from_bookmark" "$task_prefix" "$project_prefix")" || true
  [[ -z "$subtasks" ]] && return 0

  while IFS= read -r child_id; do
    [[ -z "$child_id" ]] && continue

    # Only process recognised task/project branches
    local child_task_file
    child_task_file="$(_task__resolve_file "$child_id" "$task_prefix" "$project_prefix")" \
      || continue

    # Apply --to filter at top level only
    if [[ $depth -eq 0 ]] && [[ ${#TO_FILTER[@]} -gt 0 ]]; then
      local in_filter=false
      for t in "${TO_FILTER[@]}"; do
        [[ "$t" == "$child_id" ]] && { in_filter=true; break; }
      done
      [[ "$in_filter" == false ]] && continue
    fi

    # Check bookmark exists in repo
    if ! _task__check_branch_exists "$repo" "$child_id"; then
      _ui__log "  $child_id: bookmark not found in repo; skipping"
      continue
    fi

    if is_up_to_date "$repo" "$child_id" "$from_bookmark"; then
      local child_status=DONE
      if is_behind "$repo" "$child_id" "$from_bookmark"; then
        child_status="$(read_status "$repo" "$child_id" "$task_prefix" "$project_prefix")" \
          || child_status=''
      fi
      if [[ -z "$child_status" ]]; then
        # Whether the child continues on a fork commit depends on its status,
        # so a child whose status is unknown cannot be propagated.
        _ui__log "  Warning: $child_id: could not read its task file at the branch tip; skipping"
        HAS_ERRORS=true
      elif [[ "$child_status" != DONE ]]; then
        # The child's whole history is in the parent's, but its task is not
        # finished: it continues from a fork commit on the parent's tip.
        _ui__log "  $child_id: checked in but still in progress, creating fork commit"
        propagate_one_fork "$repo" "$child_id" "$from_bookmark" "$task_prefix" "$project_prefix" \
          "$dry_run"
        if [[ "$dry_run" != true ]]; then
          _worktree__report_unsynced "$repo" "$child_id"
        fi
      else
        _ui__log "  $child_id: already up to date"
      fi
    else
      _ui__log "  $child_id: $strategy onto $from_bookmark"
      if [[ "$strategy" == rebase ]]; then
        propagate_one_rebase "$repo" "$child_id" "$from_bookmark" "$child_task_file" \
          "$task_prefix" "$project_prefix" "$force" "$dry_run"
      else
        propagate_one_merge "$repo" "$child_id" "$from_bookmark" "$task_prefix" \
          "$project_prefix" "$force" "$dry_run"
      fi

      # The child branch just moved; worktrees other than the invoking one
      # that were sitting on it are now behind its new tip.
      if [[ "$dry_run" != true ]]; then
        _worktree__report_unsynced "$repo" "$child_id"
      fi
    fi

    # Recurse into child's subtasks unless --shallow
    if [[ "$shallow" == false ]]; then
      propagate_from "$repo" "$child_id" "$task_prefix" "$project_prefix" \
        "$strategy" "$shallow" "$force" "$dry_run" "$((depth + 1))"
    fi
  done <<< "$subtasks"
}

main() {
  local from=''
  local strategy='rebase'
  local shallow=false
  local force=false
  local dry_run=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        from="$2"; shift 2 ;;
      --to)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        TO_FILTER+=("$2"); shift 2 ;;
      --rebase) strategy='rebase'; shift ;;
      --merge)  strategy='merge';  shift ;;
      --shallow) shallow=true; shift ;;
      --force)   force=true;   shift ;;
      --dry-run) dry_run=true; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve --from: explicit or current branch
  local from_bookmark
  if [[ -n "$from" ]]; then
    from_bookmark="$from"
    if ! _task__check_branch_exists "$repo" "$from_bookmark"; then
      _ui__log "Error: --from '$from_bookmark' not found in repository"
      exit 1
    fi
  else
    from_bookmark="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$from_bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch. Use --from to specify the source."
      exit 1
    fi
  fi

  _ui__log "Propagating from: $from_bookmark"
  [[ "$dry_run" == true ]] && _ui__log "(dry-run: no changes will be made)"

  # Precondition and transaction, skipped for --dry-run: it makes no changes,
  # so it neither needs a rollback point nor has anything to absorb.
  if [[ "$dry_run" != true ]]; then
    # Precondition: the working-copy commit must not carry a bookmark
    _worktree__ensure_working_copy "$repo" || exit 1
    _worktree__ensure_canonical_current "$repo" || exit 1
    local current_worktree
    current_worktree="$(_worktree__resolve_current "$repo")"
    if [[ "$force" != true ]]; then
      _worktree__ensure_metadata_unmodified "$current_worktree" "or use --force" || exit 1
    fi
    # Propagating the branch the invoking worktree sits on carries the branch
    # as it stands, so work not yet checkpointed on it would be left out.
    if [[ -z "$from" ]]; then
      _worktree__ensure_no_uncheckpointed_commits "$current_worktree" "$from_bookmark" \
        "or pass --from explicitly to skip this check" || exit 1
      if [[ "$force" != true ]]; then
        _worktree__ensure_clean "$current_worktree" \
          "pass --from explicitly, or use --force" || exit 1
      fi
    fi
    _history__begin_transaction "$repo"
  fi

  # No working-copy position is saved or restored: propagation only writes to
  # the descendant branches themselves. The one case where the working copy
  # moves at all is when it is checked out on a branch being propagated, and
  # then it moves with that branch — never away from it and back.
  propagate_from "$repo" "$from_bookmark" "$task_prefix" "$project_prefix" \
    "$strategy" "$shallow" "$force" "$dry_run" 0

  # Exiting before the commit rolls back the transaction, undoing every
  # branch already updated.
  if [[ "$HAS_ERRORS" == true ]]; then
    _ui__log "Error: Propagate failed; no branches were changed."
    exit 1
  fi

  # Commit transaction (records after-op for undo; skip for dry-run)
  if [[ "$dry_run" != true ]]; then
    _history__commit_transaction "$repo"
  fi

  _ui__log "Propagate complete."
}

main "$@"
