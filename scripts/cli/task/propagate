#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task propagate — Rebase/merge descendant task branches onto their parent's current tip.
#
# Computes the transitive closure of child branches registered under --from (or the current
# branch) and rebases each one that is behind the parent onto the parent's current tip.
#
# Usage:
#   propagate [options...]
#
# Options:
#   --from PARENT_ID  Parent task/project branch to propagate from (default: current branch)
#   --to CHILD_ID     Limit propagation to specific child(ren) (repeatable; default: all)
#   --rebase          Rebase descendants onto parent tip (default)
#   --merge           Merge parent tip into each descendant branch
#   --shallow         Update direct children only (do not recurse into grandchildren)
#   --force           Proceed even if conflicts occur after rebase/merge
#   --dry-run         Show what would be done without making changes
#   --repo PATH       Repository root (overrides TT_REPO; default: walk up to find .jj)

readonly SCRIPT_NAME="${0##*/}"

# Global: specific --to targets (empty array = all descendants)
TO_FILTER=()

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [options...]

Rebase or merge descendant task branches onto their parent's current tip.

Options:
  --from PARENT_ID  Parent task/project branch to propagate from (default: current branch)
  --to CHILD_ID     Limit propagation to specific child(ren) (repeatable; default: all)
  --rebase          Rebase descendants onto parent tip (default)
  --merge           Merge parent tip into descendants instead of rebasing
  --shallow         Update direct children only (no recursive propagation)
  --force           Proceed even if conflicts occur
  --dry-run         Show planned changes without applying them
  --repo PATH       Repository root (overrides TT_REPO; default: find .jj)

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}                                          # rebase all descendants of current task
  ${COMMAND_NAME:-$SCRIPT_NAME} --from project/bootstrap-cli-d35756ce   # propagate from a specific project
  ${COMMAND_NAME:-$SCRIPT_NAME} --shallow                                # direct children only
  ${COMMAND_NAME:-$SCRIPT_NAME} --to task/tt-task-create-5841c217        # one specific child
  ${COMMAND_NAME:-$SCRIPT_NAME} --merge --shallow                        # merge parent into direct children

EOF
}

# Usage: is_up_to_date REPO CHILD_BOOKMARK PARENT_BOOKMARK
# Returns 0 (true) if there are no commits in CHILD_BOOKMARK's ancestry that are not
# already in PARENT_BOOKMARK's ancestry. This handles the case where the child has been
# partially checked in (some commits already merged via a handoff commit), or where the
# parent is already a direct or indirect ancestor of the child. Also true when the
# child's unmerged commits already hang directly off the parent's tip (e.g. a resume
# commit placed there by a prior propagate).
is_up_to_date() {
  local repo="$1" child="$2" parent="$3"
  _task__check_up_to_date "$repo" "$parent" "$child"
}

# Usage: is_checked_in REPO CHILD_BOOKMARK PARENT_BOOKMARK
# Returns 0 (true) if PARENT_BOOKMARK carries commits that CHILD_BOOKMARK's ancestry
# does not contain — the shape a prior handoff commit from the child leaves behind
# once it has been merged into the parent.
is_checked_in() {
  local repo="$1" child="$2" parent="$3"
  # A range is empty exactly when it has no roots, so the roots of the range
  # running from the child to the parent answer the question directly.
  local result
  result="$(_task__list_unmerged_roots "$repo" "$child" "$parent")" || true
  [[ -n "$result" ]]
}

# Usage: is_partially_checked_in REPO CHILD_BOOKMARK PARENT_BOOKMARK TASK_PREFIX PROJECT_PREFIX
# Returns 0 (true) if the child has been checked in to the parent AND the child's task
# status is not DONE — i.e. it was a partial (in-progress) checkin and work should continue.
is_partially_checked_in() {
  local repo="$1" child="$2" parent="$3" task_prefix="$4" project_prefix="$5"
  is_checked_in "$repo" "$child" "$parent" || return 1
  local suffix
  if _task__check_is_task_branch "$child" "$task_prefix"; then
    suffix="${child#$task_prefix}"
  elif _task__check_is_project_branch "$child" "$project_prefix"; then
    suffix="${child#$project_prefix}"
  else
    return 1
  fi
  local task_file
  task_file="$(_path__task_file "$suffix")"
  local content status
  content="$(_task__read_file "$repo" "$child" "$task_file")" || true
  # If the task file is unreadable (e.g. it lives at a legacy path format),
  # treat the task as complete so we never create spurious resume commits.
  [[ -z "$content" ]] && return 1
  status="$(_frontmatter__parse_field "$content" "status")"
  [[ "$status" != "DONE" ]]
}

# Usage: get_subtask_ids REPO BOOKMARK TASK_FILE
# Prints one subtask task-id per line for all checkboxes ([ ], [-], [x]).
# Includes [x] entries so that partially-checked-in children that are still
# active can be propagated to; is_up_to_date handles skipping truly finished ones.
get_subtask_ids() {
  local repo="$1" bookmark="$2" task_file="$3"
  local content
  content="$(_task__read_file "$repo" "$bookmark" "$task_file")" || true
  [[ -z "$content" ]] && return 0
  _frontmatter__parse_repeated_field "$content" "subtask" | awk '
    /^\[[ x\-]\]/ { sub(/^\[[ x\-]\][ \t]*/, ""); if ($1 != "") print $1 }
  '
}

# Usage: propagate_one_rebase REPO CHILD_BOOKMARK FROM_BOOKMARK FORCE DRY_RUN
# Rebases the unmerged range of CHILD_BOOKMARK onto FROM_BOOKMARK.
# If the child has been partially checked in (some commits already in FROM's ancestry
# via a prior handoff merge), only the commits not yet in FROM's ancestry are rebased.
propagate_one_rebase() {
  local repo="$1" child="$2" from="$3" force="$4" dry_run="$5"

  # The roots of the unmerged range are the commits in the child's ancestry not
  # yet in FROM's ancestry that hang off inherited history. Nothing there means
  # the child is already up to date (guard; the caller should have checked).
  local rebase_roots
  rebase_roots="$(_task__list_unmerged_roots "$repo" "$from" "$child")" || true

  if [[ -z "$rebase_roots" ]]; then
    return 0
  fi

  if [[ "$dry_run" == true ]]; then
    _ui__log "  [dry-run] rebase $child onto $from"
    return 0
  fi

  _task__move_unmerged_range "$repo" "$from" "$child" "$from"

  # The rebase replays every commit of the range, so a conflict may surface on
  # any of them, not just the branch tip.
  if [[ "$force" != true ]] && _task__check_descendant_conflicts "$repo" "$child"; then
    _ui__log "Error: Conflicts detected in $child after rebase onto $from."
    _ui__log "  Use --force to proceed despite conflicts."
    exit 1
  fi
}

# Usage: propagate_one_merge REPO CHILD_BOOKMARK FROM_BOOKMARK FORCE DRY_RUN
# Creates a merge commit on CHILD_BOOKMARK combining its current tip with FROM_BOOKMARK.
propagate_one_merge() {
  local repo="$1" child="$2" from="$3" force="$4" dry_run="$5"

  if [[ "$dry_run" == true ]]; then
    _ui__log "  [dry-run] merge $from into $child"
    return 0
  fi

  local child_tip
  child_tip="$(_task__resolve_revision "$repo" "$child")" || {
    _ui__log "Error: Could not resolve branch '$child'."
    exit 1
  }

  # A two-parent commit with the child's tip first and the incoming parent tip
  # second, carrying no file writes of its own and no description: it records
  # the join, not a change. The child bookmark then advances onto it.
  local merge_commit
  merge_commit="$(_task__merge_branch "$repo" "" "$child_tip" "$from")" || {
    _ui__log "Error: Could not merge '$from' into '$child'."
    exit 1
  }

  # Follow the advance with the invoking worktree only when it sits on the
  # child branch; every commit on the incoming parent's line also descends
  # from the child's fork point, so plain descent would relocate worktrees
  # that have nothing to do with this child. Must run before the bookmark moves.
  _worktree__reattach_current_on_branch "$repo" "$child" "$child_tip" "$merge_commit"
  _task__advance_branch "$repo" "$child" "$merge_commit"

  if [[ "$force" != true ]] && _task__check_conflicts "$repo" "$child"; then
    _ui__log "Error: Conflicts in $child after merging $from."
    _ui__log "  Use --force to proceed despite conflicts."
    exit 1
  fi
}

# Usage: create_resume_commit REPO CHILD_BOOKMARK [DESTINATION]
# Creates a new empty commit on top of DESTINATION and advances CHILD_BOOKMARK to it.
# DESTINATION defaults to CHILD_BOOKMARK when not supplied (post-rebase/merge case).
# For fully-merged IN-PROGRESS children, pass the parent bookmark as DESTINATION so the
# child advances to the parent tip rather than staying behind it.
#
# Idempotent: if child is already equal to destination, does nothing instead of
# creating a redundant empty commit.
create_resume_commit() {
  local repo="$1" child="$2" destination="${3:-}"
  [[ -z "$destination" ]] && destination="$child"
  _task__commit_resume "$repo" "$child" "$destination" >/dev/null
}

# Usage: propagate_from REPO FROM_BOOKMARK TASK_PREFIX PROJECT_PREFIX STRATEGY SHALLOW FORCE DRY_RUN DEPTH
# Recursively propagates all registered subtasks of FROM_BOOKMARK onto FROM_BOOKMARK's current tip.
propagate_from() {
  local repo="$1"
  local from_bookmark="$2"
  local task_prefix="$3"
  local project_prefix="$4"
  local strategy="$5"
  local shallow="$6"
  local force="$7"
  local dry_run="$8"
  local depth="${9:-0}"

  # Derive task file path from bookmark name
  local suffix
  if _task__check_is_task_branch "$from_bookmark" "$task_prefix"; then
    suffix="${from_bookmark#$task_prefix}"
  elif _task__check_is_project_branch "$from_bookmark" "$project_prefix"; then
    suffix="${from_bookmark#$project_prefix}"
  else
    _ui__log "  Warning: $from_bookmark is not a task/project branch; cannot enumerate subtasks"
    return 0
  fi

  local task_file
  task_file="$(_path__task_file "$suffix")"
  local subtasks
  subtasks="$(get_subtask_ids "$repo" "$from_bookmark" "$task_file")" || true
  [[ -z "$subtasks" ]] && return 0

  while IFS= read -r child_id; do
    [[ -z "$child_id" ]] && continue

    # Only process recognised task/project branches
    if ! _task__check_is_task_branch "$child_id" "$task_prefix" && \
       ! _task__check_is_project_branch "$child_id" "$project_prefix"; then
      continue
    fi

    # Apply --to filter at top level only
    if [[ $depth -eq 0 ]] && [[ ${#TO_FILTER[@]} -gt 0 ]]; then
      local in_filter=false
      for t in "${TO_FILTER[@]}"; do
        [[ "$t" == "$child_id" ]] && { in_filter=true; break; }
      done
      [[ "$in_filter" == false ]] && continue
    fi

    # Check bookmark exists in repo
    if ! _task__check_branch_exists "$repo" "$child_id"; then
      _ui__log "  $child_id: bookmark not found in repo; skipping"
      continue
    fi

    local partial=false
    is_partially_checked_in "$repo" "$child_id" "$from_bookmark" "$task_prefix" "$project_prefix" \
      && partial=true

    if is_up_to_date "$repo" "$child_id" "$from_bookmark"; then
      if [[ "$partial" == true ]]; then
        # Child is fully merged into parent but still IN-PROGRESS: no rebase needed,
        # but we must advance the child bookmark to the parent tip so work can resume.
        _ui__log "  $child_id: checked in but still in progress — creating resume commit"
        if [[ "$dry_run" != true ]]; then
          create_resume_commit "$repo" "$child_id" "$from_bookmark"
          _worktree__report_unsynced "$repo" "$child_id"
        fi
      else
        _ui__log "  $child_id: already up to date"
      fi
    else
      _ui__log "  $child_id: $strategy onto $from_bookmark"
      if [[ "$strategy" == rebase ]]; then
        propagate_one_rebase "$repo" "$child_id" "$from_bookmark" "$force" "$dry_run"
      else
        propagate_one_merge "$repo" "$child_id" "$from_bookmark" "$force" "$dry_run"
      fi

      if [[ "$partial" == true ]] && [[ "$dry_run" != true ]]; then
        _ui__log "  $child_id: creating resume commit"
        create_resume_commit "$repo" "$child_id"
      fi

      # The child branch just moved; worktrees other than the invoking one
      # that were sitting on it are now behind its new tip.
      if [[ "$dry_run" != true ]]; then
        _worktree__report_unsynced "$repo" "$child_id"
      fi
    fi

    # Recurse into child's subtasks unless --shallow
    if [[ "$shallow" == false ]]; then
      propagate_from "$repo" "$child_id" "$task_prefix" "$project_prefix" \
        "$strategy" "$shallow" "$force" "$dry_run" "$((depth + 1))"
    fi
  done <<< "$subtasks"
}

main() {
  local from=''
  local strategy='rebase'
  local shallow=false
  local force=false
  local dry_run=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        from="$2"; shift 2 ;;
      --to)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        TO_FILTER+=("$2"); shift 2 ;;
      --rebase) strategy='rebase'; shift ;;
      --merge)  strategy='merge';  shift ;;
      --shallow) shallow=true; shift ;;
      --force)   force=true;   shift ;;
      --dry-run) dry_run=true; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *)
        usage >&2; exit 1 ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve --from: explicit or current branch
  local from_bookmark
  if [[ -n "$from" ]]; then
    from_bookmark="$from"
    if ! _task__check_branch_exists "$repo" "$from_bookmark"; then
      _ui__log "Error: --from '$from_bookmark' not found in repository"
      exit 1
    fi
  else
    from_bookmark="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$from_bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch. Use --from to specify the source."
      exit 1
    fi
  fi

  _ui__log "Propagating from: $from_bookmark"
  [[ "$dry_run" == true ]] && _ui__log "(dry-run: no changes will be made)"

  # Precondition and transaction, skipped for --dry-run: it makes no changes,
  # so it neither needs a rollback point nor has anything to absorb.
  if [[ "$dry_run" != true ]]; then
    # Precondition: the working-copy commit must not carry a bookmark
    _worktree__ensure_working_copy "$repo" || exit 1
    _history__begin_transaction "$repo"
  fi

  # No working-copy position is saved or restored: propagation only writes to
  # the descendant branches themselves. The one case where the working copy
  # moves at all is when it is checked out on a branch being propagated, and
  # then it moves with that branch — never away from it and back.
  propagate_from "$repo" "$from_bookmark" "$task_prefix" "$project_prefix" \
    "$strategy" "$shallow" "$force" "$dry_run" 0

  # Commit transaction (records after-op for undo; skip for dry-run)
  if [[ "$dry_run" != true ]]; then
    _history__commit_transaction "$repo"
  fi

  _ui__log "Propagate complete."
}

main "$@"
