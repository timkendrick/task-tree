#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task delete — Remove a task from its parent branch.
#
# Usage:
#   delete [<task-id>] [--force] [--recursive]
#          [--worktree=<path>] [--repo PATH] [--workspace-dir PATH]
#
# Removes the subtask: entry from the parent task file and removes the child
# task file from the parent branch, creating a "Remove subtask:" commit.
# The child's VCS bookmark is not deleted.
#
# Options:
#   <task-id>            Task to delete (default: current branch).
#   --force              Skip DONE status check and clean WC check.
#   --recursive          Also delete subtasks of this task.
#   --worktree=<path>    Explicit parent workspace path (for disambiguation).
#   --repo PATH          Repository root (default: walk up from CWD to find .jj).
#   --workspace-dir PATH Virtual project dir (for hooks and workspace paths).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat >&2 <<EOF
Usage: ${SCRIPT_NAME} [<task-id>] [--force] [--recursive] [--worktree=<path>] [--repo PATH] [--workspace-dir PATH]

Remove a task from its parent branch.

Arguments:
  <task-id>             Task to delete (default: current branch).

Options:
  --force               Skip DONE and clean WC checks.
  --recursive           Also delete subtasks recursively.
  --worktree=<path>     Explicit parent workspace path.
  --repo PATH           Repository root (default: find .jj).
  --workspace-dir PATH  Virtual project dir.
  -h, --help            Show this help.

EOF
  exit 1
}

# Usage: do_delete REPO TASK_ID TASK_FILE TASK_SLUG FORCE WORKTREE_ARG WORKSPACE_DIR TASK_PREFIX PROJECT_PREFIX
# Performs the actual deletion of TASK_ID from its parent branch.
# Called recursively for subtasks when --recursive is used.
do_delete() {
  local repo="$1"
  local task_id="$2"
  local task_file="$3"
  local task_slug="$4"
  local force="$5"
  local worktree_arg="$6"
  local workspace_dir="$7"
  local task_prefix="$8"
  local project_prefix="$9"

  local jj_opts=(-R "$repo")

  # Read task content from bookmark
  local task_content task_title task_status
  task_content="$(jj "${jj_opts[@]}" file show -r "$task_id" -- "$task_file" 2>/dev/null)" || {
    log "Error: Could not read task file '$task_file' from bookmark '$task_id'."
    exit 1
  }
  task_title="$(parse_frontmatter_field "$task_content" "title")"
  task_status="$(parse_frontmatter_field "$task_content" "status")"

  # Status check (skip with --force)
  if [[ "$force" != true ]] && [[ "$task_status" != "DONE" ]]; then
    log "Error: Task '$task_id' is not DONE (status: $task_status)."
    log "  Use --force to delete regardless of status."
    exit 1
  fi

  # Find parent branch
  local parent_bookmark
  parent_bookmark="$(find_parent_branch "$repo" "$task_id" "$task_prefix" "$project_prefix")"

  # Derive parent slug and task file path
  local parent_slug parent_task_file
  if is_task_branch "$parent_bookmark" "$task_prefix"; then
    parent_slug="${parent_bookmark#$task_prefix}"
  else
    parent_slug="${parent_bookmark#$project_prefix}"
  fi
  parent_task_file=".tt/task/${parent_slug}.md"

  # Determine target workspace
  local target_ws
  local worktrees
  worktrees="$(find_worktrees_for_branch "$repo" "$parent_bookmark" "$task_prefix" "$project_prefix")"
  local wt_count
  wt_count="$(printf '%s' "$worktrees" | grep -c . 2>/dev/null || true)"

  case "$wt_count" in
    0) target_ws="$repo" ;;
    1) target_ws="$worktrees" ;;
    *)
      if [[ -z "$worktree_arg" ]]; then
        log "Error: Multiple parent workspaces found; use --worktree=<path>:"
        printf '%s\n' "$worktrees" | while IFS= read -r p; do log "  $p"; done
        exit 1
      fi
      target_ws="$worktree_arg"
      ;;
  esac

  local current_worktree
  current_worktree="$(jj -R "$repo" workspace root 2>/dev/null || printf '%s' "$repo")"

  # Run pre-delete hook (blocking)
  run_hook "$repo" "pre-delete" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$task_id" \
    "TT_TASK_BRANCH=$task_id" \
    "TT_PARENT_TASK_ID=$parent_bookmark" \
    "TT_PARENT_TASK_BRANCH=$parent_bookmark"

  # Create new WC branching from parent bookmark
  jj -R "$target_ws" new "$parent_bookmark"

  # Read parent task file content
  local parent_task_content
  parent_task_content="$(jj -R "$target_ws" file show -r "$parent_bookmark" -- "$parent_task_file" 2>/dev/null)" || {
    log "Error: Could not read parent task file '$parent_task_file' from '$parent_bookmark'."
    jj -R "$target_ws" op undo
    exit 1
  }

  # Remove subtask entry for this task from parent frontmatter
  local updated_parent_content
  updated_parent_content="$(printf '%s' "$parent_task_content" | awk -v id="$task_id" '
    /^---$/ { in_fm = !in_fm; print; next }
    in_fm && /^subtask:/ {
      line = $0
      rest = line
      sub(/^subtask:[[:space:]]*\[[[:space:]x\-]\][[:space:]]*/, "", rest)
      split(rest, parts, /[[:space:]]/)
      if (parts[1] == id) next
    }
    { print }
  ')"

  printf '%s\n' "$updated_parent_content" > "$target_ws/$parent_task_file"

  # Remove child task file from target workspace (may not exist if never checked in)
  rm -f "$target_ws/$task_file"

  # Commit and advance parent bookmark
  jj -R "$target_ws" commit -m "Remove subtask: $task_title ($task_id)"
  jj -R "$target_ws" bookmark set "$parent_bookmark" -r '@-'
  jj -R "$target_ws" new '@'

  # Handle dedicated workspace for deleted task
  if [[ -n "$workspace_dir" ]]; then
    local child_ws_path="${workspace_dir}/${task_id}"
    if [[ -d "$child_ws_path" ]] && [[ -d "$child_ws_path/.jj" || -L "$child_ws_path/.jj" ]]; then
      # Get workspace name and forget it from jj
      local ws_name
      ws_name="$(jj -R "$child_ws_path" workspace list --no-pager 2>/dev/null \
        | awk -v root="$child_ws_path" '$2 == root {print $1}' | tr -d ':' || true)"
      if [[ -n "$ws_name" ]]; then
        jj -R "$repo" workspace forget "$ws_name" 2>/dev/null || true
        log "Workspace '$ws_name' forgotten from jj."
      fi
      log "Warning: Workspace directory still exists: $child_ws_path"
      log "  Files have not been removed. Clean up manually when ready."
    fi
  fi

  # Run post-delete hook (non-blocking)
  run_hook "$repo" "post-delete" false "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$task_id" \
    "TT_TASK_BRANCH=$task_id" \
    "TT_PARENT_TASK_ID=$parent_bookmark" \
    "TT_PARENT_TASK_BRANCH=$parent_bookmark"

  log "Deleted: $task_id from $parent_bookmark"
}

# Usage: find_parent_branch REPO TASK_ID TASK_PREFIX PROJECT_PREFIX
# Same logic as checkin: scans all bookmarks for subtask: entry containing TASK_ID.
find_parent_branch() {
  local repo="$1" task_id="$2" task_prefix="$3" project_prefix="$4"
  local jj_opts=(-R "$repo")

  local all_bookmarks
  all_bookmarks="$(jj "${jj_opts[@]}" log -r 'bookmarks()' \
    -T 'local_bookmarks.map(|b| b.name()).join("\n") ++ "\n"' --no-graph 2>/dev/null)" || true

  local found=''
  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if ! is_task_branch "$branch" "$task_prefix" && \
       ! is_project_branch "$branch" "$project_prefix"; then
      continue
    fi
    [[ "$branch" == "$task_id" ]] && continue

    local suffix
    if is_task_branch "$branch" "$task_prefix"; then
      suffix="${branch#$task_prefix}"
    else
      suffix="${branch#$project_prefix}"
    fi
    local path=".tt/task/${suffix}.md"
    local content
    content="$(jj "${jj_opts[@]}" file show -r "$branch" -- "$path" 2>/dev/null)" || continue
    if printf '%s' "$content" | grep -qE "^subtask:[[:space:]]*\[[[:space:]x\-]\][[:space:]]+${task_id}([[:space:]]|$)"; then
      if [[ -n "$found" ]]; then
        log "Error: Multiple parent branches found for '$task_id':"
        log "  $found"
        log "  $branch"
        exit 1
      fi
      found="$branch"
    fi
  done <<< "$all_bookmarks"

  if [[ -z "$found" ]]; then
    log "Error: No parent branch found containing subtask entry for '$task_id'."
    log "  Parentless tasks cannot be deleted with this command."
    exit 1
  fi

  printf '%s' "$found"
}

main() {
  local task_id_arg=''
  local force=false
  local recursive=false
  local worktree_arg=''
  local repo=''
  local workspace_dir=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)      force=true; shift ;;
      --recursive)  recursive=true; shift ;;
      --worktree=*) worktree_arg="${1#--worktree=}"; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { log "Error: --repo requires an argument"; usage; }
        repo="$2"; shift 2 ;;
      --workspace-dir)
        [[ $# -lt 2 ]] && { log "Error: --workspace-dir requires an argument"; usage; }
        workspace_dir="$2"; shift 2 ;;
      -h|--help) usage ;;
      -*)
        log "Error: Unknown option: $1"; usage ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          log "Error: Unexpected argument: $1"; usage
        fi
        ;;
    esac
  done

  # Resolve repo root
  if [[ -z "$repo" ]]; then
    if ! repo="$(find_repo_root)"; then
      log "Error: No enclosing jj repository. Use --repo to specify."
      exit 1
    fi
  fi
  if [[ ! -d "$repo/.jj" ]]; then
    log "Error: Not a jj repository: $repo"
    exit 1
  fi

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  if [[ -z "$workspace_dir" ]]; then
    workspace_dir="$(get_workspace_dir "$repo")" || true
  fi

  # Resolve task_id: explicit arg or current branch
  local task_id task_file task_slug
  if [[ -n "$task_id_arg" ]]; then
    task_id="$task_id_arg"
    if ! is_task_branch "$task_id" "$task_prefix" && ! is_project_branch "$task_id" "$project_prefix"; then
      log "Error: '$task_id' is not a recognized task or project ID."
      exit 1
    fi
    if ! jj -R "$repo" log -r "$task_id" --no-graph -T '' 2>/dev/null; then
      log "Error: Task '$task_id' not found in repository."
      exit 1
    fi
    if is_task_branch "$task_id" "$task_prefix"; then
      task_slug="${task_id#$task_prefix}"
    else
      task_slug="${task_id#$project_prefix}"
    fi
    task_file=".tt/task/${task_slug}.md"
  else
    local resolve_output
    resolve_output="$(resolve_current "$repo" "$task_prefix" "$project_prefix")"
    task_file="$(printf '%s' "$resolve_output" | sed -n '2p')"
    task_id="$(printf '%s' "$resolve_output" | sed -n '3p')"
    if [[ -z "$task_id" ]]; then
      log "Error: Not on a task or project branch. Pass a task ID explicitly."
      exit 1
    fi
    if is_task_branch "$task_id" "$task_prefix"; then
      task_slug="${task_id#$task_prefix}"
    else
      task_slug="${task_id#$project_prefix}"
    fi
  fi

  # Precondition: WC must be clean (skip with --force)
  if [[ "$force" != true ]]; then
    if ! is_wc_clean "$repo"; then
      log "Error: Working copy has uncommitted changes. Commit or discard first, or use --force."
      exit 1
    fi
  fi

  # Precondition: check for subtasks (skip with --force or --recursive)
  local task_content
  task_content="$(jj -R "$repo" file show -r "$task_id" -- "$task_file" 2>/dev/null)" || {
    log "Error: Could not read task file '$task_file' from bookmark '$task_id'."
    exit 1
  }

  if [[ "$force" != true ]] && [[ "$recursive" != true ]]; then
    local incomplete_subtasks
    incomplete_subtasks="$(printf '%s' "$task_content" | awk '
      /^---$/ { in_fm = !in_fm; next }
      in_fm && /^subtask:[ \t]*\[[ \-]\]/ { print; found=1 }
    ')" || true
    if [[ -n "$incomplete_subtasks" ]]; then
      log "Error: Task '$task_id' has incomplete subtasks."
      log "  Complete or delete them first, or use --force / --recursive."
      exit 1
    fi
    # Also check [x] subtasks — any subtask means abort unless force/recursive
    local any_subtasks
    any_subtasks="$(printf '%s' "$task_content" | awk '
      /^---$/ { in_fm = !in_fm; next }
      in_fm && /^subtask:[ \t]*\[[ x\-]\]/ { print; exit }
    ')" || true
    if [[ -n "$any_subtasks" ]]; then
      log "Error: Task '$task_id' has subtasks."
      log "  Delete them first, or use --force / --recursive."
      exit 1
    fi
  fi

  # If --recursive: delete subtasks depth-first first
  if [[ "$recursive" == true ]]; then
    local subtask_ids
    subtask_ids="$(printf '%s' "$task_content" | awk '
      /^---$/ { in_fm = !in_fm; next }
      in_fm && /^subtask:[ \t]*\[[ x\-]\]/ {
        sub(/^subtask:[ \t]*\[[ x\-]\][ \t]*/, "")
        if ($1 != "") print $1
      }
    ')" || true

    while IFS= read -r sub_id; do
      [[ -z "$sub_id" ]] && continue
      if ! is_task_branch "$sub_id" "$task_prefix" && \
         ! is_project_branch "$sub_id" "$project_prefix"; then
        continue
      fi
      # Check bookmark exists
      if ! jj -R "$repo" log -r "$sub_id" --no-graph -T '' 2>/dev/null; then
        log "  Subtask '$sub_id' not found in repo; skipping."
        continue
      fi
      local sub_slug sub_file
      if is_task_branch "$sub_id" "$task_prefix"; then
        sub_slug="${sub_id#$task_prefix}"
      else
        sub_slug="${sub_id#$project_prefix}"
      fi
      sub_file=".tt/task/${sub_slug}.md"
      log "Recursively deleting subtask: $sub_id"
      do_delete "$repo" "$sub_id" "$sub_file" "$sub_slug" \
        "$force" "$worktree_arg" "$workspace_dir" "$task_prefix" "$project_prefix"
    done <<< "$subtask_ids" || true
  fi

  # Perform the deletion
  do_delete "$repo" "$task_id" "$task_file" "$task_slug" \
    "$force" "$worktree_arg" "$workspace_dir" "$task_prefix" "$project_prefix"
}

main "$@"
