#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task delete — Remove a task from its parent branch.
#
# Usage:
#   delete [<task-id>] [--force]
#          [--worktree=<path>] [--repo PATH]
#
# Removes the subtask: entry from the parent task file and removes the child
# task file (and all descendant task files) from the parent branch, creating
# a single "Remove subtask:" commit. All bookmarks in the subtree are deleted.
#
# Options:
#   <task-id>            Task to delete (default: current branch).
#   --force              Skip DONE status check and clean WC check.
#   --worktree=<path>    Explicit parent workspace path (for disambiguation).
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--force] [--worktree=<path>] [--repo PATH]

Remove a task from its parent branch.

Arguments:
  <task-id>             Task to delete (default: current branch).

Options:
  --force               Skip DONE and clean WC checks.
  --worktree=<path>     Explicit parent workspace path.
  --repo PATH           Repository root (overrides TT_REPO; default: find .jj).
  -h, --help            Show this help.

EOF
}

# Usage: _subtask_ids_from_content CONTENT
# Outputs one subtask task ID per line, for all checkbox states ([ ], [-], [x]).
# Outputs nothing when CONTENT is empty.
_subtask_ids_from_content() {
  [[ -z "$1" ]] && return 0
  _frontmatter__parse_repeated_field "$1" "subtask" | awk '
    /^\[[ x\-]\]/ { sub(/^\[[ x\-]\][ \t]*/, ""); if ($1 != "") print $1 }
  '
}

# Usage: collect_subtree REPO ROOT_TASK_ID PARENT_BRANCH TASK_PREFIX PROJECT_PREFIX
# Outputs one task ID per line — all descendants of ROOT_TASK_ID.
# For each discovered task, reads subtask lists from BOTH:
#   (a) the task's own branch
#   (b) the parent branch's copy of the task file (if it exists there)
# Union of both is used at every level.
# ROOT_TASK_ID itself is NOT included in output (only descendants).
collect_subtree() {
  local repo="$1" root_id="$2" parent_branch="$3" task_prefix="$4" project_prefix="$5"

  local seen=""        # newline-separated set of visited IDs
  local to_visit="$root_id"
  local descendants=""

  while [[ -n "$to_visit" ]]; do
    local current
    current="$(printf '%s' "$to_visit" | head -1)"
    to_visit="$(printf '%s' "$to_visit" | tail -n +2)"
    [[ -z "$current" ]] && continue

    # Skip if already visited
    if printf '%s\n' "$seen" | grep -qFx "$current"; then
      continue
    fi
    seen="${seen}${current}"$'\n'

    # Determine this task's file path
    local own_slug own_file
    if _task__check_is_task_branch "$current" "$task_prefix"; then
      own_slug="${current#$task_prefix}"
    else
      own_slug="${current#$project_prefix}"
    fi
    own_file="$(_path__task_file "$own_slug")"

    # Collect subtask IDs from the task's own branch
    local own_subs=""
    local own_content
    own_content="$(_repo__read_file_at_revision "$repo" "$current" "$own_file")" || true
    own_subs="$(_subtask_ids_from_content "$own_content")" || true

    # Collect subtask IDs from the parent branch's copy of this task's file
    local parent_subs=""
    local parent_content
    parent_content="$(_repo__read_file_at_revision "$repo" "$parent_branch" "$own_file")" || true
    parent_subs="$(_subtask_ids_from_content "$parent_content")" || true

    # Union: add all newly discovered subtask IDs to to_visit
    local all_subs
    all_subs="$(printf '%s\n%s\n' "$own_subs" "$parent_subs" | sort -u)"
    while IFS= read -r sub_id; do
      [[ -z "$sub_id" ]] && continue
      if ! _task__check_is_task_branch "$sub_id" "$task_prefix" && \
         ! _task__check_is_project_branch "$sub_id" "$project_prefix"; then
        continue
      fi
      if ! printf '%s\n' "$seen" | grep -qFx "$sub_id"; then
        to_visit="${to_visit}${sub_id}"$'\n'
      fi
    done <<< "$all_subs" || true

    # Add to descendants (everything except root)
    if [[ "$current" != "$root_id" ]]; then
      descendants="${descendants}${current}"$'\n'
    fi
  done

  printf '%s' "$descendants"
}

main() {
  local task_id_arg=''
  local force=false
  local worktree_arg=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)      force=true; shift ;;
      --worktree=*) worktree_arg="${1#--worktree=}"; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi
        ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  # Resolve task_id: explicit arg or current branch
  local task_id task_file task_slug
  if [[ -n "$task_id_arg" ]]; then
    task_id="$task_id_arg"
    if ! _task__check_is_task_branch "$task_id" "$task_prefix" && ! _task__check_is_project_branch "$task_id" "$project_prefix"; then
      _ui__log "Error: '$task_id' is not a recognized task or project ID."
      exit 1
    fi
    if ! jj -R "$repo" log -r "$task_id" --no-graph -T '' 2>/dev/null; then
      _ui__log "Error: Task '$task_id' not found in repository."
      exit 1
    fi
    if _task__check_is_task_branch "$task_id" "$task_prefix"; then
      task_slug="${task_id#$task_prefix}"
    else
      task_slug="${task_id#$project_prefix}"
    fi
    task_file="$(_path__task_file "$task_slug")"
  else
    { read -r _rev; read -r task_file; read -r task_id; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")
    if [[ -z "$task_id" ]]; then
      _ui__log "Error: Not on a task or project branch. Pass a task ID explicitly."
      exit 1
    fi
    if _task__check_is_task_branch "$task_id" "$task_prefix"; then
      task_slug="${task_id#$task_prefix}"
    else
      task_slug="${task_id#$project_prefix}"
    fi
    task_file="$(_path__task_file "$task_slug")"
  fi

  # Precondition: WC must be clean (skip with --force)
  if [[ "$force" != true ]]; then
    if ! _repo__check_working_copy_clean "$repo"; then
      _ui__log "Error: Working copy has uncommitted changes. Commit or discard first, or use --force."
      exit 1
    fi
  fi

  # Read task content and check status
  local task_content task_title task_status
  task_content="$(_repo__read_file_at_revision "$repo" "$task_id" "$task_file")" || {
    _ui__log "Error: Could not read task file '$task_file' from bookmark '$task_id'."
    exit 1
  }
  task_title="$(_frontmatter__parse_quoted_field "$task_content" "title")"
  task_status="$(_frontmatter__parse_field "$task_content" "status")"

  # Precondition: top-level task must be DONE (skip with --force)
  if [[ "$force" != true ]] && [[ "$task_status" != "DONE" ]]; then
    _ui__log "Error: Task '$task_id' is not DONE (status: $task_status)."
    _ui__log "  Use --force to delete regardless of status."
    exit 1
  fi

  # Find parent branch
  local parent_bookmark
  parent_bookmark="$(_task__find_parent_branch "$repo" "$task_id" "$task_prefix" "$project_prefix")" || {
    local rc=$?
    [[ $rc -eq 1 ]] && _ui__log "Error: No parent branch found for '$task_id'. Parentless tasks cannot be deleted with this command."
    exit 1
  }

  # Derive parent slug and task file path
  local parent_slug parent_task_file
  if _task__check_is_task_branch "$parent_bookmark" "$task_prefix"; then
    parent_slug="${parent_bookmark#$task_prefix}"
  else
    parent_slug="${parent_bookmark#$project_prefix}"
  fi
  parent_task_file="$(_path__task_file "$parent_slug")"

  # Collect full descendant subtree
  local subtree_ids
  subtree_ids="$(collect_subtree "$repo" "$task_id" "$parent_bookmark" \
    "$task_prefix" "$project_prefix")"

  # Determine target workspace
  local target_ws
  local worktrees
  worktrees="$(_worktree__find_for_branch "$repo" "$parent_bookmark" "$task_prefix" "$project_prefix")"
  local wt_count
  wt_count="$(printf '%s' "$worktrees" | grep -c . 2>/dev/null || true)"

  case "$wt_count" in
    0) target_ws="$repo" ;;
    1) target_ws="$worktrees" ;;
    *)
      if [[ -z "$worktree_arg" ]]; then
        _ui__log "Error: Multiple parent workspaces found; use --worktree=<path>:"
        printf '%s\n' "$worktrees" | while IFS= read -r p; do _ui__log "  $p"; done
        exit 1
      fi
      target_ws="$worktree_arg"
      ;;
  esac

  local current_worktree
  current_worktree="$(_repo__resolve_worktree_root "$repo")"

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  # Run pre-delete hook (blocking)
  _hook__run "$repo" "pre-delete" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$task_id" \
    "TT_TASK_BRANCH=$task_id" \
    "TT_PARENT_TASK_ID=$parent_bookmark" \
    "TT_PARENT_TASK_BRANCH=$parent_bookmark"

  # Create new WC branching from parent bookmark
  jj -R "$target_ws" new "$parent_bookmark"

  # Read parent task file content
  local parent_task_content
  parent_task_content="$(_repo__read_file_at_revision "$target_ws" "$parent_bookmark" "$parent_task_file")" || {
    _ui__log "Error: Could not read parent task file '$parent_task_file' from '$parent_bookmark'."
    exit 1
  }

  # Remove subtask entry for this task from parent frontmatter
  local updated_parent_content
  updated_parent_content="$(printf '%s' "$parent_task_content" | awk -v id="$task_id" '
    BEGIN { sep = 0 }
    /^---$/ { sep++; print; next }
    sep == 1 && /^subtask:/ {
      rest = $0
      sub(/^subtask:[[:space:]]*\[[[:space:]x\-]\][[:space:]]*/, "", rest)
      split(rest, parts, /[[:space:]]/)
      if (parts[1] == id) next
    }
    { print }
  ')"

  printf '%s\n' "$updated_parent_content" > "$target_ws/$parent_task_file"

  # Remove top-level task directory from target workspace (best-effort)
  local task_dir
  task_dir="$(_path__task_dir "$task_slug")"
  rm -rf "$target_ws/$task_dir"

  # Remove all descendant task directories from target workspace (best-effort)
  while IFS= read -r desc_id; do
    [[ -z "$desc_id" ]] && continue
    local desc_slug
    if _task__check_is_task_branch "$desc_id" "$task_prefix"; then
      desc_slug="${desc_id#$task_prefix}"
    else
      desc_slug="${desc_id#$project_prefix}"
    fi
    local desc_dir
    desc_dir="$(_path__task_dir "$desc_slug")"
    rm -rf "$target_ws/$desc_dir"
  done <<< "$subtree_ids" || true

  # Commit and advance parent bookmark
  jj -R "$target_ws" commit -m "$(_commit__format_message "task" "delete" "$task_id" "$task_title")"
  jj -R "$target_ws" bookmark set "$parent_bookmark" -r '@-'
  jj -R "$target_ws" new '@'

  # Bulk bookmark deletion: root + all descendants
  local all_ids="${task_id}"$'\n'"${subtree_ids}"
  while IFS= read -r del_id; do
    [[ -z "$del_id" ]] && continue
    if jj -R "$repo" log -r "$del_id" --no-graph -T '' 2>/dev/null; then
      jj -R "$repo" bookmark delete "$del_id" 2>/dev/null || \
        _ui__log "Warning: Could not delete bookmark '$del_id'."
    fi
  done <<< "$all_ids" || true

  # Bulk workspace cleanup: root + all descendants
  while IFS= read -r del_id; do
    [[ -z "$del_id" || -z "$workspace_dir" ]] && continue
    local ws_path="${workspace_dir}/${del_id}"
    if [[ -d "$ws_path" ]] && [[ -d "$ws_path/.jj" || -L "$ws_path/.jj" ]]; then
      local ws_name
      ws_name="$(_worktree__resolve_name "$repo" "$ws_path")" || true
      if [[ -n "$ws_name" ]]; then
        jj -R "$repo" workspace forget "$ws_name" 2>/dev/null || true
        _ui__log "Workspace '$ws_name' ($del_id) forgotten from jj."
      fi
      _ui__log "Warning: Workspace directory still exists: $ws_path"
      _ui__log "  Files have not been removed. Clean up manually when ready."
    fi
  done <<< "$all_ids" || true

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  # Run post-delete hook (non-blocking)
  _hook__run "$repo" "post-delete" false "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$task_id" \
    "TT_TASK_BRANCH=$task_id" \
    "TT_PARENT_TASK_ID=$parent_bookmark" \
    "TT_PARENT_TASK_BRANCH=$parent_bookmark"

  _ui__log "Deleted: $task_id from $parent_bookmark"
}

main "$@"
