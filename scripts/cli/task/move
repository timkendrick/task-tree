#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task move — Reparent a task to a different parent.
#
# Usage:
#   move [--task <task-id>] --parent <parent-task-id>
#        [--repo PATH] [--workspace-dir PATH]
#
# Options:
#   --task TASK-ID         Task to move (default: current task)
#   --parent TASK-ID       New parent task (required)
#   --repo PATH            Repository root (overrides TT_REPO; default: walk up to find .jj)
#   --workspace-dir PATH   Virtual project dir (for hooks/context)

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--task <task-id>] --parent <parent-task-id> [--repo PATH] [--workspace-dir PATH]

Reparent a task by moving it to a different parent.

Removes the task from its current parent's subtask list, adds it to the new
parent's subtask list, and rebases the task's unmerged commit range onto the
new parent's bookmark tip.

Options:
  --task TASK-ID         Task to move (default: current task)
  --parent TASK-ID       New parent task (required)
  --repo PATH            Repository root (overrides TT_REPO; default: walk up to find .jj)
  --workspace-dir PATH   Virtual project dir
  -h, --help             Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} --parent project/main-app-abc12345
  ${COMMAND_NAME:-$SCRIPT_NAME} --task task/foo-abc12345 --parent task/bar-def67890

EOF
}

main() {
  local task_id_arg=''
  local new_parent_id=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id_arg="$2"
        shift 2
        ;;
      --parent)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        new_parent_id="$2"
        shift 2
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  # --parent is required
  if [[ -z "$new_parent_id" ]]; then
    usage >&2; exit 1
  fi

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  # Resolve task to move
  local task_id
  if [[ -n "$task_id_arg" ]]; then
    task_id="$task_id_arg"
    # Validate it is a known task/project branch
    if ! _task__check_is_task_branch "$task_id" "$task_prefix" && ! _task__check_is_project_branch "$task_id" "$project_prefix"; then
      _ui__log "Error: '$task_id' is not a recognized task or project ID"
      exit 1
    fi
    if ! _task__check_branch_exists "$repo" "$task_id"; then
      _ui__log "Error: Task '$task_id' not found in repository"
      exit 1
    fi
  else
    task_id="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$task_id" ]]; then
      _ui__log "Error: Not on a task or project branch. Use --task to specify."
      exit 1
    fi
  fi

  # Validate new parent exists
  if ! _task__check_is_task_branch "$new_parent_id" "$task_prefix" && ! _task__check_is_project_branch "$new_parent_id" "$project_prefix"; then
    _ui__log "Error: '$new_parent_id' is not a recognized task or project ID"
    exit 1
  fi
  if ! _task__check_branch_exists "$repo" "$new_parent_id"; then
    _ui__log "Error: Parent '$new_parent_id' not found in repository"
    exit 1
  fi

  local current_worktree
  current_worktree="$(_worktree__resolve_current "$repo")"

  # Precondition: the working copy must be clean. Unlike the other branch
  # writes, a move rebases the task's own line of work, and the invoking
  # worktree may be sitting on it: the rebase carries the working copy across
  # to the new parent, so any uncommitted edits would be replayed onto a
  # different base than the one they were written against.
  if ! _worktree__check_clean "$current_worktree"; then
    _ui__log "Error: Working copy has uncommitted changes. Commit or discard first."
    exit 1
  fi

  local listing
  listing="$(_task__list_branch_records "$repo" "$task_prefix" "$project_prefix")" || {
    _ui__log "Error: Cannot read the task branches."
    exit 1
  }

  # Find old parent
  local old_parent='' find_parent_exit=0
  old_parent="$(_task__find_parent_branch_in "$listing" "$task_id")" || find_parent_exit=$?
  if [[ $find_parent_exit -eq 1 ]]; then
    _ui__log "Error: No parent found for '$task_id'. Cannot move a parentless task."
    exit 1
  elif [[ $find_parent_exit -ne 0 ]]; then
    exit $find_parent_exit
  fi

  # Guard: same parent is a no-op error
  if [[ "$old_parent" == "$new_parent_id" ]]; then
    _ui__log "Error: Task '$task_id' is already a child of '$new_parent_id'."
    exit 1
  fi

  # Guard: cycle detection — walk up from new_parent_id to ensure task_id is not an ancestor
  local cursor="$new_parent_id"
  while true; do
    local p_exit=0
    local p=''
    p="$(_task__find_parent_branch_in "$listing" "$cursor")" || p_exit=$?
    if [[ $p_exit -ne 0 ]]; then
      break  # reached a root without finding task_id — no cycle
    fi
    if [[ "$p" == "$task_id" ]]; then
      _ui__log "Error: Cannot move '$task_id' under '$new_parent_id': would create a cycle."
      exit 1
    fi
    cursor="$p"
  done

  # Derive slugs and task file paths
  local task_slug task_file old_parent_task_file new_parent_task_file
  task_slug="$(_task__resolve_suffix "$task_id" "$task_prefix" "$project_prefix")" || exit 1
  task_file="$(_path__task_file "$task_slug")"
  old_parent_task_file="$(_task__resolve_file "$old_parent" "$task_prefix" "$project_prefix")" \
    || exit 1
  new_parent_task_file="$(_task__resolve_file "$new_parent_id" "$task_prefix" "$project_prefix")" \
    || exit 1

  # Read task title for commit messages
  local task_title
  task_title="$(_task__read_title "$repo" "$task_id" "$task_id" "$task_prefix" "$project_prefix")" || {
    _ui__log "Error: Could not read task file '$task_file' from '$task_id'."
    exit 1
  }

  local task_dir
  task_dir="$(_path__task_dir "$task_slug")"

  # Pin the old parent's tip before anything moves: it is both the source of
  # the task stub copied onto the new parent below and the base the task's
  # unmerged range is measured against.
  local old_parent_tip
  old_parent_tip="$(_task__resolve_revision "$repo" "$old_parent")" || {
    _ui__log "Error: Could not resolve branch '$old_parent'."
    exit 1
  }

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1
  _worktree__ensure_canonical_current "$repo" || exit 1

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  # ----------------------------------------------------------------
  # Step 1: Update old parent — remove subtask entry and task stub dir
  # ----------------------------------------------------------------
  # Writer invoked by _task__commit_on_branch with the staging root: drops the
  # moved task's subtask entry from the staged old-parent task file. The
  # task's stub directory is removed via the --delete-prefix flag, mirroring
  # how tt task create places that stub on the parent branch in the first
  # place.
  move_old_parent_writer() {
    local root="$1"
    _task__remove_subtask "$root/$old_parent_task_file" "$task_id"
  }

  _ui__log "Updating old parent: $old_parent"
  _task__commit_on_branch "$repo" "$old_parent" \
    "$(_commit__format_message "task" "remove" "$task_id" "$task_title")" \
    --modify "$old_parent_task_file" \
    --delete-prefix "$task_dir" \
    -- move_old_parent_writer >/dev/null

  # ----------------------------------------------------------------
  # Step 2: Update new parent — add subtask entry and task stub dir
  # ----------------------------------------------------------------
  # Writer invoked by _task__commit_on_branch with the staging root: adds the
  # moved task's subtask entry to the staged new-parent task file.
  move_new_parent_writer() {
    local root="$1"
    _task__add_subtask "$root/$new_parent_task_file" "$task_id"
  }

  # The task's stub file comes across exactly as recorded at the old parent's
  # pinned tip, so the new parent's copy is byte-identical to the one Step 1
  # removed. That identity is what keeps the rebase in Step 3 conflict-free:
  # the three-way merge sees "theirs == base" for the stub and cleanly takes
  # the task branch's own updated task file.
  local -a stub_copy=()
  if _task__check_file_exists "$repo" "$old_parent_tip" "$task_id" \
      "$task_prefix" "$project_prefix"; then
    stub_copy=(--copy-from "$old_parent_tip" "$task_file")
    _ui__log "Copying task stub from old parent to new parent: $task_file"
  else
    _ui__log "Warning: Could not copy task stub '$task_file' from old parent; skipping."
  fi

  _ui__log "Updating new parent: $new_parent_id"
  _task__commit_on_branch "$repo" "$new_parent_id" \
    "$(_commit__format_message "task" "move" "$task_id" "$task_title")" \
    --modify "$new_parent_task_file" ${stub_copy[@]+"${stub_copy[@]}"} \
    -- move_new_parent_writer >/dev/null

  # ----------------------------------------------------------------
  # Step 3: Reparent the task's unmerged range onto the new parent
  # ----------------------------------------------------------------
  # The range is measured against the old parent's pinned tip rather than its
  # bookmark: Step 1 advanced that bookmark, and the commit it added is not in
  # the task's ancestry, so the pinned tip is the fork base that actually
  # describes what the task owns.
  local rebase_roots
  rebase_roots="$(_task__list_unmerged_roots "$repo" "$old_parent_tip" "$task_id")" || true

  if [[ -n "$rebase_roots" ]]; then
    # Each root is held by change ID too, so it can be found again once the
    # move has rewritten it.
    local -a old_roots=() root_changes=()
    local root
    while IFS= read -r root; do
      [[ -n "$root" ]] || continue
      old_roots+=("$root")
      root_changes+=("$(_task__resolve_change "$repo" "$root")")
    done <<< "$rebase_roots"

    _ui__log "Rebasing $task_id onto $new_parent_id..."
    _task__move_unmerged_range "$repo" "$old_parent_tip" "$task_id" "$new_parent_id"

    # The moved commits keep pointing the task symlink at the moved task. On
    # the new base it points at the new parent, so the rebase would otherwise
    # leave the symlink conflicted (where a root changes it, as a fork commit
    # does) or pointing at the new parent (where a root inherits it). Each
    # moved root takes the symlink from its own pre-move commit, and the
    # commits above it inherit that.
    local i moved_root
    for i in "${!old_roots[@]}"; do
      moved_root="$(_task__resolve_revision "$repo" "${root_changes[$i]}")"
      _task__restore_symlink "$repo" "${old_roots[$i]}" "$moved_root"
    done

    # The restore is a bare rewrite, so a worktree carried along with the
    # range still holds the pre-restore files. The working copy was required
    # clean up front, so nothing uncommitted is lost.
    _worktree__refresh_current "$repo"
  else
    _ui__log "No unmerged commits to rebase for $task_id."
  fi

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  # Both parent branches were written to, so both may have left worktrees
  # other than the invoking one behind.
  _worktree__report_unsynced "$repo" "$old_parent"
  _worktree__report_unsynced "$repo" "$new_parent_id"

  _ui__log "Moved: $task_id"
  _ui__log "  Old parent: $old_parent"
  _ui__log "  New parent: $new_parent_id"
}

main "$@"
