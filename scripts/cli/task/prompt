#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task prompt — Emit a self-contained LLM prompt to implement a task.
#
# Usage:
#   prompt [<task-id>] [--repo PATH] [--message TEXT] [-h|--help]
#
# Options:
#   <task-id>       Task ID (branch name) to prompt for. Default: current task.
#   --repo PATH     Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   --message TEXT  Append a custom message section to the prompt.
#   -h, --help      Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--repo PATH] [--message TEXT]

Write a self-contained implementation prompt for a task to stdout.
Defaults to the current task if no task ID is given.

Options:
  <task-id>       Task branch name to prompt for (default: current task).
  --repo PATH     Repository root (overrides TT_REPO; default: find .jj).
  --message TEXT  Append a custom message section to the prompt.
  -h, --help      Show this help.

EOF
}

main() {
  local task_id_arg=''
  local repo=''
  local message=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      --message)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        message="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # --- Resolve branch and task file ---
  local branch task_file task_id

  if [[ -z "$task_id_arg" ]]; then
    { read -r task_file; read -r branch; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")
    if [[ -z "$branch" ]]; then
      _ui__log "Error: Not on a task or project branch."
      exit 1
    fi
    task_id="$branch"
  else
    task_id="$task_id_arg"
    # A checked-in task is read from the parent branch that received the
    # checkin, so the task file path comes from the task ID, not the branch.
    if ! branch="$(_task__find_branch "$repo" "$task_id" "$task_prefix" "$project_prefix")"; then
      _ui__log "Error: Could not locate branch for task '$task_id'."
      exit 1
    fi
    task_file="$(_task__resolve_file "$task_id" "$task_prefix" "$project_prefix")" || {
      _ui__log "Error: Cannot derive task file path for '$task_id'."
      exit 1
    }
  fi

  # --- Read task fields and body ---
  local fields
  if ! fields="$(_task__read_fields "$repo" "$branch" "$task_id" "$task_prefix" "$project_prefix" \
    title 'context[]' '...')"; then
    _ui__log "Error: Could not read task file '$task_file' from '$branch'."
    exit 1
  fi

  local title context_count ctx_entry i contexts='' body=''
  { IFS= read -r title; IFS= read -r context_count
    for (( i = 0; i < context_count; i++ )); do
      IFS= read -r ctx_entry; contexts+="$ctx_entry"$'\n'
    done
    IFS= read -r -d '' body
  } <<< "$fields" || true
  contexts="${contexts%$'\n'}"
  body="${body%$'\n'}"
  body="$(_string__trim_text "$body")"

  # --- Emit prompt ---

  # Mini frontmatter block
  _frontmatter__format_block task "$task_id" title "$(_frontmatter__quote "$title")"

  # Blank line + body + blank line
  printf '\n'
  [[ -n "$body" ]] && printf '%s\n\n' "$body"

  # Context blocks (each context block's closing --- opens the next, or closes the section)
  if [[ -n "$contexts" ]]; then
    while IFS= read -r ctx_id; do
      [[ -z "$ctx_id" ]] && continue
      local ctx_title='' ctx_body=''
      { IFS= read -r ctx_title; IFS= read -r -d '' ctx_body; } \
        <<< "$(_task__read_context_fields "$repo" "$branch" "$task_id" "$ctx_id" \
          "$task_prefix" "$project_prefix" title '...')" || true
      ctx_body="${ctx_body%$'\n'}"
      _frontmatter__format_block context "$ctx_id" title "$(_frontmatter__quote "$ctx_title")"
      printf '%s\n\n' "$ctx_body"
    done <<< "$contexts"
  fi

  # Commands section
  printf -- '---\n'
  printf '\n'
  printf 'Use the following commands for more context:\n'
  printf '\n'
  printf '  tt task tree --focus  # Show the current task within the overall task tree\n'
  printf '  tt task current       # Print the current task ID\n'
  printf '  tt task parent        # Print the parent task ID\n'
  printf '\n'

  printf -- '---\n'

  if [[ -n "$message" ]]; then
    printf '\n'
    printf '%s\n\n' "$message"
  fi
}

main "$@"
