#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task prompt — Emit a self-contained LLM prompt to implement a task.
#
# Usage:
#   prompt [<task-id>] [--repo PATH] [--message TEXT] [-h|--help]
#
# Options:
#   <task-id>       Task ID (branch name) to prompt for. Default: current task.
#   --repo PATH     Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   --message TEXT  Append a custom message section to the prompt.
#   -h, --help      Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--repo PATH] [--message TEXT]

Write a self-contained implementation prompt for a task to stdout.
Defaults to the current task if no task ID is given.

Options:
  <task-id>       Task branch name to prompt for (default: current task).
  --repo PATH     Repository root (overrides TT_REPO; default: find .jj).
  --message TEXT  Append a custom message section to the prompt.
  -h, --help      Show this help.

EOF
}

main() {
  local task_id_arg=''
  local repo=''
  local message=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      --message)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        message="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # --- Resolve branch and task file ---
  local branch task_file task_suffix

  if [[ -z "$task_id_arg" ]]; then
    task_file="$(resolve_current_task_file "$repo" "$task_prefix" "$project_prefix")"
    branch="$(resolve_current_bookmark "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$branch" ]]; then
      log "Error: Not on a task or project branch."
      exit 1
    fi
    if is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    else
      task_suffix="${branch#$project_prefix}"
    fi
  else
    if ! branch="$(find_branch_for_task "$repo" "$task_id_arg" "$task_prefix" "$project_prefix")"; then
      log "Error: Could not locate branch for task '$task_id_arg'."
      exit 1
    fi
    if is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    elif is_project_branch "$branch" "$project_prefix"; then
      task_suffix="${branch#$project_prefix}"
    else
      if is_task_branch "$task_id_arg" "$task_prefix"; then
        task_suffix="${task_id_arg#$task_prefix}"
      elif is_project_branch "$task_id_arg" "$project_prefix"; then
        task_suffix="${task_id_arg#$project_prefix}"
      else
        log "Error: Cannot derive task file path for '$task_id_arg'."
        exit 1
      fi
    fi
    task_file="$(task_file_path "$task_suffix")"
  fi

  # --- Read task file ---
  local content
  if ! content="$(jj_show_at_revision "$repo" "$branch" "$task_file")"; then
    log "Error: Could not read task file '$task_file' from '$branch'."
    exit 1
  fi

  # --- Parse fields ---
  local title
  title="$(parse_quoted_frontmatter_field "$content" "title")"

  local body
  body="$(parse_body "$content")"
  # Trim leading/trailing blank lines
  body="$(printf '%s' "$body" | awk 'NF{found=1} found{print}' | sed -e 's/[[:space:]]*$//')"

  # Parse context IDs from frontmatter (one per line)
  local contexts
  contexts="$(printf '%s' "$content" | awk '
    /^---$/ { n++; next }
    n==1 && /^context:/ {
      sub(/^context:[[:space:]]*/, "")
      print
    }
  ')"

  # --- Emit prompt ---

  # Heading
  printf 'Implement task: %s\n' "$title"

  # Mini frontmatter block
  printf -- '---\n'
  printf 'task: %s\n' "$branch"
  printf 'title: %s\n' "$title"
  printf -- '---\n'

  # Blank line + body + blank line
  printf '\n'
  [[ -n "$body" ]] && printf '%s\n\n' "$body"

  # Context blocks (each context block's closing --- opens the next, or closes the section)
  if [[ -n "$contexts" ]]; then
    while IFS= read -r ctx_id; do
      [[ -z "$ctx_id" ]] && continue
      local ctx_file ctx_content ctx_title ctx_body
      ctx_file="$(task_context_path "$task_suffix" "$ctx_id")"
      ctx_content="$(jj_show_at_revision "$repo" "$branch" "$ctx_file" || true)"
      ctx_title="$(parse_quoted_frontmatter_field "$ctx_content" "title" 2>/dev/null || true)"
      ctx_body="$(parse_body "$ctx_content")"
      printf -- '---\n'
      printf 'context: %s\n' "$ctx_id"
      printf 'title: "%s"\n' "$ctx_title"
      printf -- '---\n'
      printf '%s\n\n' "$ctx_body"
    done <<< "$contexts"
  fi

  # Commands section
  printf -- '---\n'
  printf '\n'
  printf 'Use the following commands for more context:\n'
  printf '\n'
  printf '  tt task tree --focus  # Show the current task within the overall task tree\n'
  printf '  tt task current       # Print the current task ID\n'
  printf '  tt task parent        # Print the parent task ID\n'
  printf '\n'

  # Optional message section
  if [[ -n "$message" ]]; then
    printf -- '---\n'
    printf '\n'
    printf '%s\n\n' "$message"
  fi
}

main "$@"
