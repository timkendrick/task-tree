#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task checkpoint — merge committed work into the task branch and record a
# checkpoint.
#
# Checkpoint commits carry no file changes. Without --task, the commits the
# working copy sits on that the task bookmark does not reach are merged into
# the branch first, by a `merge` commit whose first parent is the bookmark and
# whose second parent is the working copy's parent. The empty `checkpoint`
# commit then lands on top, and the bookmark advances to it. With --task, only
# the checkpoint commit is written.
#
# Usage:
#   checkpoint [--message <message>] [--task <task-id>] [--repo PATH]
#
# Options:
#   -m, --message <msg>  Checkpoint message (skips editor prompt; required when stdin is not a
#                        terminal). An empty message cancels the checkpoint.
#   --task <task-id>     Record an empty checkpoint on this branch, without merging anything.
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--message <message>] [--task <task-id>] [--repo PATH]

Record a checkpoint on a task branch and advance the task bookmark.

Without --task, the commits made since the task bookmark (up to the working
copy's parent) are first merged into the current task branch. The working copy
must be clean, and those commits must not change task metadata. With --task,
an empty checkpoint is recorded on the given branch and nothing is merged.

Prompts for the message in an editor unless --message is given. When stdin
is not a terminal, --message is required. An empty message cancels the checkpoint.

Options:
  -m, --message <msg>   Checkpoint message (skips editor prompt).
  --task <task-id>      Record an empty checkpoint on this task branch, merging nothing.
  --repo PATH           Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} -m "add foo"
  ${COMMAND_NAME:-$SCRIPT_NAME} --message "refactor bar"
  ${COMMAND_NAME:-$SCRIPT_NAME} --task task/foo-abc12345 -m "milestone"
  ${COMMAND_NAME:-$SCRIPT_NAME}           # opens editor

EOF
}

# Writer for the checkpoint commit: a checkpoint carries no file changes.
checkpoint_writer() {
  :
}

main() {
  local message=''
  local message_provided=false
  local task_id_arg=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--message)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        message="$2"
        message_provided=true
        shift 2
        ;;
      --message=*)
        message="${1#--message=}"
        message_provided=true
        shift
        ;;
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id_arg="$2"
        shift 2
        ;;
      --task=*)
        task_id_arg="${1#--task=}"
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  if [[ "$message_provided" == false && ! -t 0 ]]; then
    _ui__log "Error: cannot open an editor for the checkpoint message: stdin is not a terminal. Pass --message <msg>."
    exit 1
  fi

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  local bookmark
  if [[ -z "$task_id_arg" ]]; then
    { read -r _; read -r bookmark; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")
    if [[ -z "$bookmark" ]]; then
      _ui__log "Error: not on a task or project branch."
      exit 1
    fi
  else
    bookmark="$task_id_arg"
    if ! _task__resolve_suffix "$bookmark" "$task_prefix" "$project_prefix" >/dev/null; then
      _ui__log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    fi
  fi

  if ! _task__check_branch_exists "$repo" "$bookmark"; then
    _ui__log "Error: bookmark '$bookmark' not found in repository."
    exit 1
  fi

  local current_worktree
  current_worktree="$(_worktree__resolve_current "$repo")"

  _worktree__ensure_working_copy "$repo" || exit 1
  _worktree__ensure_canonical_current "$repo" || exit 1
  _worktree__ensure_metadata_unmodified "$current_worktree" || exit 1

  # Without --task, the commits the working copy sits on that the bookmark
  # does not reach are merged into the branch. The working copy must be clean,
  # since uncommitted work would otherwise be silently left out of the merge.
  local merge_head='' commits_to_merge='' commit_count=0
  if [[ -z "$task_id_arg" ]]; then
    _worktree__ensure_clean "$current_worktree" \
      "or pass the task ID explicitly to record an empty checkpoint" || exit 1

    merge_head="$(_worktree__resolve_working_copy_parent "$current_worktree")"
    commits_to_merge="$(_task__list_commits_since_branch "$repo" "$bookmark" "$merge_head")" || {
      _ui__log "Error: Could not list the commits after the task bookmark '$bookmark'."
      exit 1
    }
    commit_count="$(printf '%s\n' "$commits_to_merge" | grep -c . || true)"

    if [[ "$commit_count" -gt 0 ]]; then
      local metadata_changes
      metadata_changes="$(_task__list_metadata_changes_since_branch "$repo" "$bookmark" "$merge_head")" || {
        _ui__log "Error: Could not list the changes made after the task bookmark '$bookmark'."
        exit 1
      }
      if [[ -n "$metadata_changes" ]]; then
        local path
        _ui__log "Error: Commits after the task bookmark '$bookmark' change task metadata:"
        while IFS= read -r path; do
          _ui__log "  $path"
        done <<< "$metadata_changes"
        _ui__log "  Task metadata is written by tt alone. Remove these changes from the commits first."
        exit 1
      fi
    fi
  fi

  local task_title
  task_title="$(_task__read_title "$repo" "$bookmark" "$bookmark" "$task_prefix" "$project_prefix")" \
    || task_title=''

  if [[ "$message_provided" == false ]]; then
    # When exactly one commit is about to be merged, prefill the editor with
    # the first line of its description instead of the task title.
    local default_message="$task_title" single_desc
    if [[ "$commit_count" -eq 1 ]]; then
      single_desc="$(_task__read_commit_message "$repo" "$commits_to_merge")"
      single_desc="${single_desc%%$'\n'*}"
      if [[ -n "$single_desc" ]]; then
        default_message="$single_desc"
      fi
    fi

    local template
    template="$(printf '%s\n\n# Task: %s\n# An empty message cancels the checkpoint.' \
      "$default_message" "$bookmark")"
    message="$(_ui__prompt <<< "$template")" || exit 1
  fi

  if [[ -z "$message" ]]; then
    _ui__log "Checkpoint canceled: no message provided."
    exit 1
  fi

  _history__begin_transaction "$repo"

  local base="$bookmark"
  if [[ "$commit_count" -gt 0 ]]; then
    _hook__run "$repo" "pre-merge" true "$current_worktree" "${workspace_dir:-}" \
      "TT_TASK_ID=$bookmark" \
      "TT_TASK_BRANCH=$bookmark" \
      "TT_MERGE_HEAD=$merge_head"

    local merge_commit
    merge_commit="$(_task__merge_branch "$repo" \
      "$(_commit__format_title_message "task" "merge" "$bookmark" "$task_title")" \
      "$bookmark" "$merge_head")" || {
      _ui__log "Error: Could not merge the commits after the task bookmark into '$bookmark'."
      exit 1
    }
    if _task__check_conflicts "$repo" "$merge_commit"; then
      _ui__log "Error: Merging the commits after the task bookmark into '$bookmark' produces conflicts."
      exit 1
    fi

    _hook__run "$repo" "post-merge" true "$current_worktree" "${workspace_dir:-}" \
      "TT_TASK_ID=$bookmark" \
      "TT_TASK_BRANCH=$bookmark" \
      "TT_MERGE_HEAD=$merge_head" \
      "TT_COMMIT=$merge_commit"

    base="$merge_commit"
  fi

  _hook__run "$repo" "pre-checkpoint" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_MESSAGE=${message}"

  local checkpoint_message new_commit
  checkpoint_message="$(_commit__format_message "task" "checkpoint" "$bookmark" "$message")"
  if [[ "$commit_count" -gt 0 ]]; then
    # The working copy sits on the merged commits rather than on the bookmark,
    # so it is reattached from the newest of them.
    new_commit="$(_task__commit_detached "$repo" "$base" "$checkpoint_message" -- checkpoint_writer)"
    _worktree__reattach_current "$repo" "$bookmark" "$merge_head" "$new_commit"
    _task__advance_branch "$repo" "$bookmark" "$new_commit"
  else
    new_commit="$(_task__commit_on_branch "$repo" "$bookmark" "$checkpoint_message" -- checkpoint_writer)"
  fi

  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$bookmark"

  _ui__log "Checkpoint: $bookmark → ${new_commit:0:8}"

  _hook__run "$repo" "post-checkpoint" false "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_MESSAGE=${message}" \
    "TT_COMMIT=${new_commit}"
}

main "$@"
