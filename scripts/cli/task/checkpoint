#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task checkpoint — record current state and advance the task bookmark.
#
# Working-copy-bound: a checkpoint exists to capture the uncommitted work
# sitting in the worktree it is run from, so unlike the commands that write
# their branch bare it reads and moves that worktree's working copy. Every VCS
# operation therefore goes through the working-copy-bound facades in
# lib/worktree.sh, which take the worktree root explicitly.
#
# Usage:
#   checkpoint [--message <message>] [--squash] [--repo PATH]
#
# Options:
#   -m, --message <msg>  Commit message (skips editor prompt).
#   --squash             Squash all commits since the last bookmark into a single checkpoint commit.
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--message <message>] [--squash] [--repo PATH]

Record the current state of work by creating a named commit and advancing the task bookmark.

Options:
  -m, --message <msg>   Commit message (skips editor prompt).
  --squash              Squash all commits since the last bookmark into a single checkpoint commit.
  --repo PATH           Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} -m "add foo"
  ${COMMAND_NAME:-$SCRIPT_NAME} --message "refactor bar"
  ${COMMAND_NAME:-$SCRIPT_NAME} --squash -m "collapse and checkpoint"
  ${COMMAND_NAME:-$SCRIPT_NAME}           # opens editor

EOF
}

main() {
  local message=''
  local squash=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--message)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        message="$2"
        shift 2
        ;;
      --message=*)
        message="${1#--message=}"
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      --squash)
        squash=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        usage >&2; exit 1
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  # Resolve current branch
  local task_file bookmark
  { read -r task_file; read -r bookmark; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")

  # Precondition: must be on a task or project branch
  if [[ -z "$bookmark" ]]; then
    _ui__log "Error: not on a task or project branch."
    exit 1
  fi

  # Precondition: verify bookmark exists
  if ! _task__check_branch_exists "$repo" "$bookmark"; then
    _ui__log "Error: bookmark '$bookmark' not found in repository."
    exit 1
  fi

  # Get current worktree
  local current_worktree
  current_worktree="$(_worktree__resolve_current "$repo")"

  # Read task title from task file frontmatter
  local task_file_content task_title
  task_file_content="$(_task__read_file "$repo" "$bookmark" "$task_file")" || true
  task_title="$(_frontmatter__parse_quoted_field "$task_file_content" "title")"

  # Derive task ID (bookmark name without prefix) for display
  local task_id="$bookmark"

  # Commits already recorded on this branch's line since the bookmark last
  # moved: everything from the bookmark up to the commit the working copy sits
  # on, the bookmark itself excluded.
  local wc_parent intermediates intermediate_count
  wc_parent="$(_worktree__resolve_working_copy_parent "$current_worktree")"
  intermediates="$(_task__list_commits_since_branch "$repo" "$bookmark" "$wc_parent")" || true
  intermediate_count="$(printf '%s\n' "$intermediates" | grep -c . || true)"

  # Get message from editor if not provided
  if [[ -z "$message" ]]; then
    # When the range since the bookmark holds exactly one commit, prefill the
    # editor with the first line of that commit's description instead of the
    # task title.
    local default_message="$task_title" single_desc
    if [[ "$intermediate_count" -eq 1 ]]; then
      single_desc="$(_task__read_commit_message "$repo" "$intermediates")"
      single_desc="${single_desc%%$'\n'*}"
      if [[ -n "$single_desc" ]]; then
        default_message="$single_desc"
      fi
    fi

    local template
    template="$(printf '%s\n\n# Task: %s\n# An empty message cancels the checkpoint.' \
      "$default_message" "$task_id")"
    message="$(_ui__prompt <<< "$template")" || exit 1
    if [[ -z "$message" ]]; then
      _ui__log "Checkpoint cancelled."
      exit 1
    fi
  fi

  # Build full commit message
  local full_msg
  full_msg="$(_commit__format_message "task" "checkpoint" "$bookmark" "$message")"

  # Precondition: the working-copy commit must not carry a bookmark. A
  # checkpoint records the working copy as a NEW commit on top of the branch;
  # if the working copy were itself a branch tip there would be nothing above
  # the tip to record, and the capture would amend that branch instead.
  _worktree__ensure_working_copy "$repo" || exit 1

  # Pre-checkpoint hook (blocking)
  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  _hook__run "$repo" "pre-checkpoint" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_MESSAGE=${message}"

  # With --squash, fold every commit recorded since the bookmark into the
  # working copy first, so the single commit created below carries all of it.
  # Nothing to fold means an ordinary checkpoint.
  if [[ "$squash" == true && "$intermediate_count" -gt 0 ]]; then
    local -a squash_sources=()
    local squash_source
    while IFS= read -r squash_source; do
      [[ -n "$squash_source" ]] && squash_sources+=("$squash_source")
    done <<< "$intermediates"
    _worktree__squash_into_working_copy "$current_worktree" "${squash_sources[@]}"
  fi

  # Record the working copy (works for empty or non-empty WC)
  _worktree__commit_working_copy "$current_worktree" "$full_msg"

  # Get new commit ID — the commit just recorded is what the working copy now
  # sits on
  local new_commit
  new_commit="$(_worktree__resolve_working_copy_parent "$current_worktree")"

  # Advance bookmark
  _task__advance_branch "$repo" "$bookmark" "$new_commit"

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$bookmark"

  _ui__log "Checkpoint: $bookmark → ${new_commit:0:8}"

  # Post-checkpoint hook (non-blocking)
  _hook__run "$repo" "post-checkpoint" false "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_MESSAGE=${message}" \
    "TT_COMMIT=${new_commit}"
}

main "$@"
