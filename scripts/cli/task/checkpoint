#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task checkpoint — record current state and advance the task bookmark.
#
# Usage:
#   checkpoint [--message <message>] [--squash] [--repo PATH]
#
# Options:
#   -m, --message <msg>  Commit message (skips editor prompt).
#   --squash             Squash all commits since the last bookmark into a single checkpoint commit.
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--message <message>] [--squash] [--repo PATH]

Record the current state of work by creating a named commit and advancing the task bookmark.

Options:
  -m, --message <msg>   Commit message (skips editor prompt).
  --squash              Squash all commits since the last bookmark into a single checkpoint commit.
  --repo PATH           Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} -m "add foo"
  ${COMMAND_NAME:-$SCRIPT_NAME} --message "refactor bar"
  ${COMMAND_NAME:-$SCRIPT_NAME} --squash -m "collapse and checkpoint"
  ${COMMAND_NAME:-$SCRIPT_NAME}           # opens editor

EOF
}

main() {
  local message=''
  local squash=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--message)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        message="$2"
        shift 2
        ;;
      --message=*)
        message="${1#--message=}"
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      --squash)
        squash=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        usage >&2; exit 1
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(get_workspace_dir "$repo")" || true

  # Resolve current branch
  local current_rev task_file bookmark
  { read -r current_rev; read -r task_file; read -r bookmark; } < <(resolve_current "$repo" "$task_prefix" "$project_prefix")

  # Precondition: must be on a task or project branch
  if [[ -z "$bookmark" ]]; then
    log "Error: not on a task or project branch."
    exit 1
  fi

  # Precondition: verify bookmark exists
  if ! jj -R "$repo" log -r "$bookmark" --no-graph -T '' 2>/dev/null; then
    log "Error: bookmark '$bookmark' not found in repository."
    exit 1
  fi

  # Get current worktree
  local current_worktree
  current_worktree="$(resolve_current_worktree "$repo")"

  # Read task title from task file frontmatter
  local task_file_content task_title
  task_file_content="$(jj_show_at_revision "$repo" "$bookmark" "$task_file")" || true
  task_title="$(parse_quoted_frontmatter_field "$task_file_content" "title")"

  # Derive task ID (bookmark name without prefix) for display
  local task_id="$bookmark"

  # Get message from editor if not provided
  if [[ -z "$message" ]]; then
    local template
    template="$(printf '%s\n\n# Task: %s\n# An empty message cancels the checkpoint.' \
      "$task_title" "$task_id")"
    message="$(prompt <<< "$template")" || exit 1
    if [[ -z "$message" ]]; then
      log "Checkpoint cancelled."
      exit 1
    fi
  fi

  # Build full commit message
  local full_msg
  full_msg="$(format_commit_message "task" "checkpoint" "$bookmark" "$message")"

  # Pre-checkpoint hook (blocking)
  # Begin transaction (records before-op for undo)
  tt_begin_transaction "$repo"

  run_hook "$repo" "pre-checkpoint" true "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_MESSAGE=${message}"

  # Create commit (works for empty or non-empty WC)
  if [[ "$squash" == true ]]; then
    # Count commits strictly between bookmark and @- (exclusive of bookmark, exclusive of @)
    local intermediate_count
    intermediate_count="$(jj -R "$repo" log \
      -r "${bookmark}::@- ~ ${bookmark}" \
      --no-graph -T 'commit_id ++ "\n"' 2>/dev/null | wc -l | tr -d ' ')"

    if [[ "$intermediate_count" -gt 0 ]]; then
      # Squash all intermediate commits into @, setting the checkpoint message
      jj -R "$repo" squash \
        --from "${bookmark}::@- ~ ${bookmark}" \
        --into @ \
        -m "$full_msg"
      # @ now has the right content and description; just open a new WC
      jj -R "$repo" new
    else
      # Nothing to squash — behave like normal checkpoint
      jj -R "$repo" commit -m "$full_msg"
    fi
  else
    jj -R "$repo" commit -m "$full_msg"
  fi

  # Get new commit ID
  local new_commit
  new_commit="$(jj -R "$repo" log -r '@-' --no-graph -T 'commit_id.short(8)')"

  # Advance bookmark
  jj -R "$repo" bookmark set "$bookmark" -r '@-'

  # Commit transaction (records after-op for undo)
  tt_commit_transaction "$repo"

  log "Checkpoint: $bookmark → $new_commit"

  # Post-checkpoint hook (non-blocking)
  run_hook "$repo" "post-checkpoint" false "$current_worktree" "${workspace_dir:-}" \
    "TT_TASK_ID=$bookmark" \
    "TT_TASK_BRANCH=$bookmark" \
    "TT_MESSAGE=${message}" \
    "TT_COMMIT=${new_commit}"
}

main "$@"
