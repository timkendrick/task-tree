#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task tree — Generate and print the project todo list (bootstrap)
#
# Full list: tasks grouped by project; optional filtering.
# Focused list: current task and its ancestors only.
#
# Usage:
#   list [--project <project-id>]... [--detached]     # selected projects, +detached if --detached
#   list [--all]                                     # all projects + detached
#   list --focus                                     # current task chain only
#
# Options:
#   --project ID    Filter to specific project(s) (repeatable)
#   --detached      Add detached (orphaned) section to current selection
#   --all           Show all projects and detached section
#   --focus         Show current task and ancestors only (exclusive with other options)
#   --repo PATH     Repository root (overrides TT_REPO; default: find .jj)
#

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [options...]

Generate and print the project todo list.

Options:
  --project ID    Include specific project(s) (repeatable)
  --detached      Add detached (orphaned) tasks to selection
  --all           Show all projects and detached section
  --focus         Show current task and ancestors only
  --repo PATH     Repository root (overrides TT_REPO; default: find .jj)
  -h, --help      Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}                                    # all projects
  ${COMMAND_NAME:-$SCRIPT_NAME} --project project/main-abc12345    # one project
  ${COMMAND_NAME:-$SCRIPT_NAME} --detached                         # all projects + detached
  ${COMMAND_NAME:-$SCRIPT_NAME} --all                              # all projects + detached
  ${COMMAND_NAME:-$SCRIPT_NAME} --focus                            # current task chain

EOF
}

# Parse YAML-like frontmatter: extract title, status, and subtask lines.
# Usage: parse_frontmatter CONTENT
# Outputs to stdout, one line per extracted value:
#   title:TITLE
#   status:STATUS
#   subtask:CHECKBOX TASK_ID [TITLE]
#   subtask:...
parse_frontmatter() {
  local content="${1:-}"
  printf '%s' "$content" | awk '
    /^---$/ { in_fm = !in_fm; next }
    in_fm && /^title:[ \t]*/ {
      sub(/^title:[ \t]*/, "")
      gsub(/^["'\'']|["'\'']$/, "")
      print "title:" $0
      next
    }
    in_fm && /^status:[ \t]*/ {
      sub(/^status:[ \t]*/, "")
      print "status:" $0
      next
    }
    in_fm && /^subtask:[ \t]*\[[ x\-]\]/ {
      sub(/^subtask:[ \t]*/, "")
      cb = substr($0, 1, 3)
      rest = substr($0, 5)
      sub(/^[ \t]+/, "", rest)
      id = rest
      sub(/[ \t].*$/, "", id)
      sub(/^[^ \t]+[ \t]*/, "", rest)
      print "subtask:" cb " " id " " rest
      next
    }
  '
}

# Usage: branch_suffix BRANCH TASK_PREFIX PROJECT_PREFIX
# Outputs the slug-hex part of a task or project branch name.
# Returns 1 if BRANCH is neither a task nor a project branch.
branch_suffix() {
  local branch="$1" task_prefix="$2" project_prefix="$3"
  if is_task_branch "$branch" "$task_prefix"; then
    printf '%s' "${branch#"$task_prefix"}"
  elif is_project_branch "$branch" "$project_prefix"; then
    printf '%s' "${branch#"$project_prefix"}"
  else
    return 1
  fi
}

# Usage: get_metadata_from_content CONTENT [FALLBACK_CHECKBOX] [FALLBACK_TITLE]
# Get checkbox and title from a task file's content string.
# When CONTENT is empty (the task file could not be read at any revision), falls
# back to the checkbox/title recorded in the parent's subtask: entry.
get_metadata_from_content() {
  local content="$1"
  local fallback_checkbox="${2:-}"
  local fallback_title="${3:-}"

  if [[ -z "$content" ]]; then
    printf '%s|%s' "${fallback_checkbox:-[ ]}" "${fallback_title:-(no title)}"
    return 0
  fi

  local title=''
  local status='TODO'
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    case "$line" in
      title:*) title="${line#title:}" ;;
      status:*) status="${line#status:}" ;;
    esac
  done < <(parse_frontmatter "$content") || true
  title="${title#"${title%%[![:space:]]*}"}"
  title="${title%"${title##*[![:space:]]}"}"
  [[ -z "$title" ]] && title='(no title)'
  printf '%s|%s' "$(status_to_checkbox "$status")" "$title"
}

# Usage: get_subtask_entries CONTENT
# Outputs one line per subtask: CHECKBOX|TASK_ID|TITLE
get_subtask_entries() {
  local content="$1"
  parse_frontmatter "$content" | awk -F: '
    $1 == "subtask" {
      rest = $2
      sub(/^[ \t]+/, "", rest)
      cb = substr(rest, 1, 3)
      rest = substr(rest, 5)
      sub(/^[ \t]+/, "", rest)
      id = rest
      sub(/[ \t].*$/, "", id)
      title = rest
      sub(/^[^ \t]+[ \t]*/, "", title)
      if (title == "") title = "(no title)"
      print cb "|" id "|" title
    }
  '
}

# Emit a single task line. INDENT is spaces (e.g. "" or "   ").
# Optional 5th arg: current_task_id — when matches task_id, wrap link and title in **bold**.
emit_task_line() {
  local indent="$1"
  local checkbox="$2"
  local task_id="$3"
  local title="$4"
  local current_task_id="${5:-}"
  local task_prefix="$6"
  local project_prefix="$7"
  local suffix
  suffix="$(branch_suffix "$task_id" "$task_prefix" "$project_prefix")" || suffix="$task_id"
  local task_path
  task_path="$(task_file_path "$suffix")"
  if [[ -n "$current_task_id" && "$task_id" == "$current_task_id" ]]; then
    printf '%s- %s **[%s](%s) %s**\n' "$indent" "$checkbox" "$task_id" "$task_path" "$title"
  else
    printf '%s- %s [%s](%s) %s\n' "$indent" "$checkbox" "$task_id" "$task_path" "$title"
  fi
}

# Recursively emit task tree.
# Optional: focus_chain (newline-sep root..current), focus_index (0-based).
# When focus_chain is set, only recurses into the child matching chain[focus_index+1];
# at the leaf (current task), recurses into all children.
emit_tree() {
  local repo="$1"
  local branch="$2"
  local task_id="$3"
  local indent="$4"
  local task_prefix="$5"
  local project_prefix="$6"
  local merged_map="$7"  # newline-sep "TASK_ID:BRANCH"
  local current_task_id="${8:-}"
  local focus_chain="${9:-}"
  local focus_index="${10:-0}"
  local fallback_checkbox="${11:-}"
  local fallback_title="${12:-}"

  local suffix
  suffix="$(branch_suffix "$task_id" "$task_prefix" "$project_prefix")" || suffix="$task_id"
  local path
  path="$(task_file_path "$suffix")"

  local source_branch="$branch"
  local merged_line
  merged_line="$(printf '%s' "$merged_map" | grep -E "^${task_id}:" | head -1)" || true
  if [[ -n "$merged_line" ]]; then
    source_branch="${merged_line#*:}"
  fi

  local content
  content="$(jj_show_at_revision "$repo" "$source_branch" "$path")" || true

  local checkbox title
  local meta
  meta="$(get_metadata_from_content "$content" "$fallback_checkbox" "$fallback_title")"
  checkbox="${meta%%|*}"
  title="${meta#*|}"

  emit_task_line "$indent" "$checkbox" "$task_id" "$title" "$current_task_id" "$task_prefix" "$project_prefix"

  local child_indent="${indent}   "
  local subs_output
  subs_output="$(get_subtask_entries "$content")" || true

  local next_in_chain=''
  local chain_count=0
  if [[ -n "$focus_chain" ]]; then
    chain_count="$(printf '%s' "$focus_chain" | grep -c . 2>/dev/null || true)"
    if [[ "$((focus_index + 1))" -lt "$chain_count" ]]; then
      next_in_chain="$(printf '%s' "$focus_chain" | sed -n "$((focus_index + 2))p")"
    fi
  fi

  while IFS='|' read -r sub_cb sub_id sub_title; do
    [[ -z "$sub_id" ]] && continue
    if [[ -n "$focus_chain" ]]; then
      if [[ -n "$next_in_chain" ]]; then
        [[ "$sub_id" != "$next_in_chain" ]] && continue
      fi
    fi
    local child_branch="$sub_id"
    local child_merged
    child_merged="$(printf '%s' "$merged_map" | grep -E "^${sub_id}:" | head -1)" || true
    [[ -n "$child_merged" ]] && child_branch="${child_merged#*:}"
    emit_tree "$repo" "$child_branch" "$sub_id" "$child_indent" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id" "$focus_chain" "$((focus_index + 1))" "$sub_cb" "$sub_title"
  done <<< "$subs_output" || true
}

# Usage: build_subtask_index REPO BRANCHES TASK_PREFIX PROJECT_PREFIX
# Reads each branch's own task file exactly once and emits one line per
# subtask: entry found, in branch order:
#   CHILD_ID<TAB>CHECKBOX<TAB>OWNER_BRANCH
build_subtask_index() {
  local repo="$1" branches="$2" task_prefix="$3" project_prefix="$4"
  local branch suffix path content
  for branch in $branches; do
    [[ -z "$branch" ]] && continue
    suffix="$(branch_suffix "$branch" "$task_prefix" "$project_prefix")" || continue
    path="$(task_file_path "$suffix")"
    content="$(jj_show_at_revision "$repo" "$branch" "$path")" || continue
    [[ -z "$content" ]] && continue
    while IFS='|' read -r cb id _title; do
      [[ -z "$id" ]] && continue
      printf '%s\t%s\t%s\n' "$id" "$cb" "$branch"
    done < <(get_subtask_entries "$content")
  done
}

# Usage: merged_map_from_index SUBTASK_INDEX
# Checked-in tasks only: the branch they were merged into is authoritative.
# Outputs newline-separated "TASK_ID:BRANCH", first owning branch wins.
merged_map_from_index() {
  printf '%s\n' "$1" | awk -F'\t' '$2 == "[x]" && !seen[$1]++ { print $1 ":" $3 }'
}

# Usage: parent_map_from_index SUBTASK_INDEX
# Any checkbox state: child -> owning parent branch, for the focus chain walk.
# Outputs newline-separated "TASK_ID<TAB>PARENT_BRANCH", first owning branch wins.
parent_map_from_index() {
  printf '%s\n' "$1" | awk -F'\t' '!seen[$1]++ { print $1 "\t" $3 }'
}

# Collect all task IDs reachable from the given roots (project branches).
collect_task_ids() {
  local repo="$1"
  local roots="$2"
  local seen=""
  local to_visit="$roots"
  local merged_map="$3"
  local task_prefix="$4"
  local project_prefix="$5"

  while [[ -n "$to_visit" ]]; do
    local current
    current="$(printf '%s' "$to_visit" | head -1)"
    to_visit="$(printf '%s' "$to_visit" | tail -n +2)"
    [[ -z "$current" ]] && continue
    if printf '%s' "$seen" | grep -qFx "$current"; then
      continue
    fi
    seen="${seen}${current}"$'\n'

    local source_branch="$current"
    local merged_line
    merged_line="$(printf '%s' "$merged_map" | grep -E "^${current}:" | head -1)" || true
    [[ -n "$merged_line" ]] && source_branch="${merged_line#*:}"

    local suffix
    suffix="$(branch_suffix "$current" "$task_prefix" "$project_prefix")" || continue
    local path
    path="$(task_file_path "$suffix")"
    local content
    content="$(jj_show_at_revision "$repo" "$source_branch" "$path")" || true
    local subs
    subs="$(get_subtask_entries "$content" | cut -d'|' -f2)"
    for sub in $subs; do
      [[ -z "$sub" ]] && continue
      to_visit="${to_visit}${sub}"$'\n'
    done
  done
  printf '%s' "$seen"
}

main() {
  local -a filter_projects=()
  local show_detached=false
  local show_all=false
  local focus=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        filter_projects+=("$2")
        shift 2
        ;;
      --detached)
        show_detached=true
        shift
        ;;
      --all)
        show_all=true
        shift
        ;;
      --focus)
        focus=true
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  local jj_opts=(-R "$repo")
  local all_bookmarks
  all_bookmarks="$(jj "${jj_opts[@]}" log -r 'bookmarks()' -T 'local_bookmarks.map(|b| b.name()).join(",") ++ "\n"' --no-graph 2>/dev/null)" || true
  local project_branches=''
  local task_branches=''
  while IFS= read -r b; do
    [[ -z "$b" ]] && continue
    if is_project_branch "$b" "$project_prefix"; then
      project_branches="${project_branches}${b}"$'\n'
    elif is_task_branch "$b" "$task_prefix"; then
      task_branches="${task_branches}${b}"$'\n'
    fi
  done <<< "$all_bookmarks" || true
  project_branches="$(printf '%s' "$project_branches" | sort -u)"
  task_branches="$(printf '%s' "$task_branches" | sort -u)"
  local all_task_project_branches="${project_branches}"$'\n'"${task_branches}"

  # Index every branch's subtask: entries once, then derive both maps from it.
  # This replaces per-task-ID scans over every branch, which were quadratic.
  local subtask_index merged_map parent_map
  subtask_index="$(build_subtask_index "$repo" "$all_task_project_branches" \
    "$task_prefix" "$project_prefix")"
  merged_map="$(merged_map_from_index "$subtask_index")"
  parent_map="$(parent_map_from_index "$subtask_index")"

  local current_bookmark
  current_bookmark="$(resolve_current_bookmark "$repo" "$task_prefix" "$project_prefix")"
  local current_task_id=''
  if [[ -n "$current_bookmark" ]] && { is_task_branch "$current_bookmark" "$task_prefix" || is_project_branch "$current_bookmark" "$project_prefix"; }; then
    current_task_id="$current_bookmark"
  fi

  if [[ "$focus" == true ]]; then
    if [[ -z "$current_bookmark" ]]; then
      log "Error: Not on a task or project branch. Cannot show focused list."
      exit 1
    fi
    if ! is_task_branch "$current_bookmark" "$task_prefix" && ! is_project_branch "$current_bookmark" "$project_prefix"; then
      log "Error: Current branch '$current_bookmark' is not a task or project branch. Cannot show focused list."
      exit 1
    fi

    # Walk up parent chain
    local chain="$current_bookmark"
    local current="$current_bookmark"
    while true; do
      local parent
      parent="$(printf '%s' "$parent_map" | awk -F'\t' -v id="$current" \
        '$1 == id { print $2; exit }')"
      [[ -z "$parent" ]] && break
      # Guard against a cycle in malformed subtask metadata.
      if printf '%s' "$chain" | grep -qFx "$parent"; then
        log "Warning: Cycle detected in task hierarchy at '$parent'; stopping ancestor walk."
        break
      fi
      chain="${parent}"$'\n'"${chain}"
      current="$parent"
    done

    local root
    root="$(printf '%s' "$chain" | head -1)"
    emit_tree "$repo" "$root" "$root" "" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id" "$chain" "0"
    exit 0
  fi

  # Full list
  local projects_to_show=''
  if [[ ${#filter_projects[@]} -gt 0 ]]; then
    for p in "${filter_projects[@]}"; do
      if printf '%s' "$project_branches" | grep -qx "$p"; then
        projects_to_show="${projects_to_show}${p}"$'\n'
      fi
    done
  elif [[ "$show_all" == true ]]; then
    projects_to_show="$project_branches"
    show_detached=true
  else
    projects_to_show="$project_branches"
  fi

  if [[ -z "$projects_to_show" ]] && [[ ${#filter_projects[@]} -eq 0 ]]; then
    log "No projects found."
    exit 0
  fi

  if [[ -z "$projects_to_show" ]] && [[ ${#filter_projects[@]} -gt 0 ]]; then
    log "No matching projects found."
    exit 0
  fi

  local reachable_ids=''
  for p in $projects_to_show; do
    [[ -z "$p" ]] && continue
    reachable_ids="${reachable_ids}${p}"$'\n'
  done
  reachable_ids="$(collect_task_ids "$repo" "$projects_to_show" "$merged_map" \
    "$task_prefix" "$project_prefix")"

  for p in $projects_to_show; do
    [[ -z "$p" ]] && continue
    emit_tree "$repo" "$p" "$p" "" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id"
  done

  if [[ "$show_detached" == true ]]; then
    local orphaned=''
    for tb in $task_branches; do
      [[ -z "$tb" ]] && continue
      if ! printf '%s' "$reachable_ids" | grep -qx "$tb"; then
        orphaned="${orphaned}${tb}"$'\n'
      fi
    done
    if [[ -n "$orphaned" ]]; then
      printf '\nOrphaned tasks:\n\n'
      for o in $orphaned; do
        [[ -z "$o" ]] && continue
        local o_merged
        o_merged="$(printf '%s' "$merged_map" | grep -E "^${o}:" | head -1)" || true
        o_merged="${o_merged#*:}"
        [[ -z "$o_merged" ]] && o_merged="$o"
        emit_tree "$repo" "$o_merged" "$o" "" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id"
      done
    fi
  fi
}

main "$@"
