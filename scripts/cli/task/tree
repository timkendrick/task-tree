#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task tree — Generate and print the project todo list (bootstrap)
#
# Full list: tasks grouped by project; optional filtering.
# Focused list: current task and its ancestors only.
#
# Usage:
#   list [--project <project-id>]... [--detached]     # selected projects, +detached if --detached
#   list [--all]                                     # all projects + detached
#   list --focus                                     # current task chain only
#
# Options:
#   --project ID    Filter to specific project(s) (repeatable)
#   --detached      Add detached (orphaned) section to current selection
#   --all           Show all projects and detached section
#   --focus         Show current task and ancestors only (exclusive with other options)
#   --repo PATH     Repository root (overrides TT_REPO; default: find .jj)
#

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [options...]

Generate and print the project todo list.

Options:
  --project ID    Include specific project(s) (repeatable)
  --detached      Add detached (orphaned) tasks to selection
  --all           Show all projects and detached section
  --focus         Show current task and ancestors only
  --repo PATH     Repository root (overrides TT_REPO; default: find .jj)
  -h, --help      Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}                                    # all projects
  ${COMMAND_NAME:-$SCRIPT_NAME} --project project/main-abc12345    # one project
  ${COMMAND_NAME:-$SCRIPT_NAME} --detached                         # all projects + detached
  ${COMMAND_NAME:-$SCRIPT_NAME} --all                              # all projects + detached
  ${COMMAND_NAME:-$SCRIPT_NAME} --focus                            # current task chain

EOF
}


# Usage: format_metadata TITLE STATUS
# Prints "CHECKBOX|TITLE" for a task's decoded title and status. An empty status
# (e.g. the task file could not be read at any revision) renders as [?].
format_metadata() {
  local title="$1" status="$2"
  title="${title#"${title%%[![:space:]]*}"}"
  title="${title%"${title##*[![:space:]]}"}"
  [[ -z "$title" ]] && title='(no title)'
  printf '%s|%s' "$(_format__status_checkbox "$status")" "$title"
}

# Usage: format_subtask_entries < ENTRIES
# Reads raw subtask entries, one per line, and outputs one line per
# well-formed entry: CHECKBOX|TASK_ID|TITLE
format_subtask_entries() {
  awk '
    /^\[[ x\-]\]/ {
      cb = substr($0, 1, 3)
      rest = substr($0, 4)
      sub(/^[ \t]+/, "", rest)
      id = rest
      sub(/[ \t].*$/, "", id)
      title = rest
      sub(/^[^ \t]+[ \t]*/, "", title)
      if (title == "") title = "(no title)"
      print cb "|" id "|" title
    }
  '
}

# Usage: read_subtask_entries REPO REV TASK_ID TASK_PREFIX PROJECT_PREFIX
# Outputs one CHECKBOX|TASK_ID|TITLE line per subtask entry of TASK_ID's task
# file at REV. Returns 1 (nothing printed) when the file cannot be read.
read_subtask_entries() {
  local fields
  fields="$(_task__read_fields "$1" "$2" "$3" "$4" "$5" 'subtask[]')" || return 1
  local subtask_count subtask subtasks=() i
  { IFS= read -r subtask_count
    for (( i = 0; i < subtask_count; i++ )); do
      IFS= read -r subtask; subtasks+=("$subtask")
    done
  } <<< "$fields" || true
  printf '%s\n' ${subtasks[@]+"${subtasks[@]}"} | format_subtask_entries
}

# Emit a single task line. INDENT is spaces (e.g. "" or "   ").
# Optional 5th arg: current_task_id — when matches task_id, wrap link and title in **bold**.
emit_task_line() {
  local indent="$1"
  local checkbox="$2"
  local task_id="$3"
  local title="$4"
  local current_task_id="${5:-}"
  local task_prefix="$6"
  local project_prefix="$7"
  local suffix
  suffix="$(_task__resolve_suffix "$task_id" "$task_prefix" "$project_prefix")" || suffix="$task_id"
  local task_path
  task_path="$(_path__task_file "$suffix")"
  if [[ -n "$current_task_id" && "$task_id" == "$current_task_id" ]]; then
    printf '%s- %s **[%s](%s) %s**\n' "$indent" "$checkbox" "$task_id" "$task_path" "$title"
  else
    printf '%s- %s [%s](%s) %s\n' "$indent" "$checkbox" "$task_id" "$task_path" "$title"
  fi
}

# Recursively emit task tree.
# Optional: focus_chain (newline-sep root..current), focus_index (0-based).
# When focus_chain is set, only recurses into the child matching chain[focus_index+1];
# at the leaf (current task), recurses into all children.
emit_tree() {
  local repo="$1"
  local branch="$2"
  local task_id="$3"
  local indent="$4"
  local task_prefix="$5"
  local project_prefix="$6"
  local merged_map="$7"  # newline-sep "TASK_ID:BRANCH"
  local current_task_id="${8:-}"
  local focus_chain="${9:-}"
  local focus_index="${10:-0}"

  local source_branch="$branch"
  local merged_line
  merged_line="$(_string__first_line "$(printf '%s' "$merged_map" | grep -E "^${task_id}:" || true)")"
  if [[ -n "$merged_line" ]]; then
    source_branch="${merged_line#*:}"
  fi

  local fields title='' status='' subtask_count=0 subtask subtasks=() i
  fields="$(_task__read_fields "$repo" "$source_branch" "$task_id" \
    "$task_prefix" "$project_prefix" title status 'subtask[]')" || fields=''
  { IFS= read -r title; IFS= read -r status; IFS= read -r subtask_count
    for (( i = 0; i < subtask_count; i++ )); do
      IFS= read -r subtask; subtasks+=("$subtask")
    done
  } <<< "$fields" || true

  local checkbox meta
  meta="$(format_metadata "$title" "$status")"
  checkbox="${meta%%|*}"
  title="${meta#*|}"

  emit_task_line "$indent" "$checkbox" "$task_id" "$title" "$current_task_id" "$task_prefix" "$project_prefix"

  local child_indent="${indent}   "
  local subs_output
  subs_output="$(printf '%s\n' ${subtasks[@]+"${subtasks[@]}"} | format_subtask_entries)"

  local next_in_chain=''
  local chain_count=0
  if [[ -n "$focus_chain" ]]; then
    chain_count="$(printf '%s' "$focus_chain" | grep -c . 2>/dev/null || true)"
    if [[ "$((focus_index + 1))" -lt "$chain_count" ]]; then
      next_in_chain="$(printf '%s' "$focus_chain" | sed -n "$((focus_index + 2))p")"
    fi
  fi

  while IFS='|' read -r _ sub_id _; do
    [[ -z "$sub_id" ]] && continue
    if [[ -n "$focus_chain" ]]; then
      if [[ -n "$next_in_chain" ]]; then
        [[ "$sub_id" != "$next_in_chain" ]] && continue
      fi
    fi
    local child_branch="$sub_id"
    local child_merged
    child_merged="$(_string__first_line "$(printf '%s' "$merged_map" | grep -E "^${sub_id}:" || true)")"
    [[ -n "$child_merged" ]] && child_branch="${child_merged#*:}"
    emit_tree "$repo" "$child_branch" "$sub_id" "$child_indent" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id" "$focus_chain" "$((focus_index + 1))"
  done <<< "$subs_output" || true
}

# Usage: build_subtask_index REPO BRANCHES TASK_PREFIX PROJECT_PREFIX
# Reads each branch's own task file exactly once and emits one line per
# subtask: entry found, in branch order:
#   CHILD_ID<TAB>CHECKBOX<TAB>OWNER_BRANCH
build_subtask_index() {
  local repo="$1" branches="$2" task_prefix="$3" project_prefix="$4"
  local branch entries
  for branch in $branches; do
    [[ -z "$branch" ]] && continue
    entries="$(read_subtask_entries "$repo" "$branch" "$branch" \
      "$task_prefix" "$project_prefix")" || continue
    while IFS='|' read -r cb id _title; do
      [[ -z "$id" ]] && continue
      printf '%s\t%s\t%s\n' "$id" "$cb" "$branch"
    done <<< "$entries"
  done
}

# Usage: merged_map_from_index SUBTASK_INDEX
# Checked-in tasks only: the branch they were merged into is authoritative.
# Outputs newline-separated "TASK_ID:BRANCH", first owning branch wins.
merged_map_from_index() {
  printf '%s\n' "$1" | awk -F'\t' '$2 == "[x]" && !seen[$1]++ { print $1 ":" $3 }'
}

# Usage: parent_map_from_index SUBTASK_INDEX
# Any checkbox state: child -> owning parent branch, for the focus chain walk.
# Outputs newline-separated "TASK_ID<TAB>PARENT_BRANCH", first owning branch wins.
parent_map_from_index() {
  printf '%s\n' "$1" | awk -F'\t' '!seen[$1]++ { print $1 "\t" $3 }'
}

# Collect all task IDs reachable from the given roots (project branches).
collect_task_ids() {
  local repo="$1"
  local roots="$2"
  local seen=""
  local to_visit="$roots"
  local merged_map="$3"
  local task_prefix="$4"
  local project_prefix="$5"

  while [[ -n "$to_visit" ]]; do
    local current
    current="$(_string__first_line "$to_visit")"
    to_visit="$(printf '%s' "$to_visit" | tail -n +2)"
    [[ -z "$current" ]] && continue
    if printf '%s' "$seen" | grep -qFx "$current"; then
      continue
    fi
    seen="${seen}${current}"$'\n'

    local source_branch="$current"
    local merged_line
    merged_line="$(_string__first_line "$(printf '%s' "$merged_map" | grep -E "^${current}:" || true)")"
    [[ -n "$merged_line" ]] && source_branch="${merged_line#*:}"

    _task__resolve_file "$current" "$task_prefix" "$project_prefix" >/dev/null || continue
    local entries subs
    entries="$(read_subtask_entries "$repo" "$source_branch" "$current" \
      "$task_prefix" "$project_prefix")" || entries=''
    subs="$(printf '%s\n' "$entries" | cut -d'|' -f2)"
    for sub in $subs; do
      [[ -z "$sub" ]] && continue
      to_visit="${to_visit}${sub}"$'\n'
    done
  done
  printf '%s' "$seen"
}

main() {
  local -a filter_projects=()
  local show_detached=false
  local show_all=false
  local focus=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        filter_projects+=("$2")
        shift 2
        ;;
      --detached)
        show_detached=true
        shift
        ;;
      --all)
        show_all=true
        shift
        ;;
      --focus)
        focus=true
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  local all_bookmarks
  all_bookmarks="$(_task__list_branch_names "$repo")" || true
  local project_branches=''
  local task_branches=''
  while IFS= read -r b; do
    [[ -z "$b" ]] && continue
    if _task__check_is_project_branch "$b" "$project_prefix"; then
      project_branches="${project_branches}${b}"$'\n'
    elif _task__check_is_task_branch "$b" "$task_prefix"; then
      task_branches="${task_branches}${b}"$'\n'
    fi
  done <<< "$all_bookmarks" || true
  project_branches="$(printf '%s' "$project_branches" | sort -u)"
  task_branches="$(printf '%s' "$task_branches" | sort -u)"
  local all_task_project_branches="${project_branches}"$'\n'"${task_branches}"

  # Index every branch's subtask: entries once, then derive both maps from it.
  # This replaces per-task-ID scans over every branch, which were quadratic.
  local subtask_index merged_map parent_map
  subtask_index="$(build_subtask_index "$repo" "$all_task_project_branches" \
    "$task_prefix" "$project_prefix")"
  merged_map="$(merged_map_from_index "$subtask_index")"
  parent_map="$(parent_map_from_index "$subtask_index")"

  local current_bookmark
  current_bookmark="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
  local current_task_id=''
  if [[ -n "$current_bookmark" ]] && { _task__check_is_task_branch "$current_bookmark" "$task_prefix" || _task__check_is_project_branch "$current_bookmark" "$project_prefix"; }; then
    current_task_id="$current_bookmark"
  fi

  if [[ "$focus" == true ]]; then
    if [[ -z "$current_bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch. Cannot show focused list."
      exit 1
    fi
    if ! _task__check_is_task_branch "$current_bookmark" "$task_prefix" && ! _task__check_is_project_branch "$current_bookmark" "$project_prefix"; then
      _ui__log "Error: Current branch '$current_bookmark' is not a task or project branch. Cannot show focused list."
      exit 1
    fi

    # Walk up parent chain
    local chain="$current_bookmark"
    local current="$current_bookmark"
    while true; do
      local parent
      parent="$(printf '%s' "$parent_map" | awk -F'\t' -v id="$current" \
        '$1 == id { print $2; exit }')"
      [[ -z "$parent" ]] && break
      # Guard against a cycle in malformed subtask metadata.
      if printf '%s' "$chain" | grep -qFx "$parent"; then
        _ui__log "Warning: Cycle detected in task hierarchy at '$parent'; stopping ancestor walk."
        break
      fi
      chain="${parent}"$'\n'"${chain}"
      current="$parent"
    done

    local root
    root="$(_string__first_line "$chain")"
    emit_tree "$repo" "$root" "$root" "" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id" "$chain" "0"
    exit 0
  fi

  # Full list
  local projects_to_show=''
  if [[ ${#filter_projects[@]} -gt 0 ]]; then
    for p in "${filter_projects[@]}"; do
      if printf '%s' "$project_branches" | grep -qx "$p"; then
        projects_to_show="${projects_to_show}${p}"$'\n'
      fi
    done
  elif [[ "$show_all" == true ]]; then
    projects_to_show="$project_branches"
    show_detached=true
  else
    projects_to_show="$project_branches"
  fi

  if [[ -z "$projects_to_show" ]] && [[ ${#filter_projects[@]} -eq 0 ]]; then
    _ui__log "No projects found."
    exit 0
  fi

  if [[ -z "$projects_to_show" ]] && [[ ${#filter_projects[@]} -gt 0 ]]; then
    _ui__log "No matching projects found."
    exit 0
  fi

  local reachable_ids=''
  for p in $projects_to_show; do
    [[ -z "$p" ]] && continue
    reachable_ids="${reachable_ids}${p}"$'\n'
  done
  reachable_ids="$(collect_task_ids "$repo" "$projects_to_show" "$merged_map" \
    "$task_prefix" "$project_prefix")"

  for p in $projects_to_show; do
    [[ -z "$p" ]] && continue
    emit_tree "$repo" "$p" "$p" "" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id"
  done

  if [[ "$show_detached" == true ]]; then
    local orphaned=''
    for tb in $task_branches; do
      [[ -z "$tb" ]] && continue
      if ! printf '%s' "$reachable_ids" | grep -qx "$tb"; then
        orphaned="${orphaned}${tb}"$'\n'
      fi
    done
    if [[ -n "$orphaned" ]]; then
      printf '\nOrphaned tasks:\n\n'
      for o in $orphaned; do
        [[ -z "$o" ]] && continue
        local o_merged
        o_merged="$(_string__first_line "$(printf '%s' "$merged_map" | grep -E "^${o}:" || true)")"
        o_merged="${o_merged#*:}"
        [[ -z "$o_merged" ]] && o_merged="$o"
        emit_tree "$repo" "$o_merged" "$o" "" "$task_prefix" "$project_prefix" "$merged_map" "$current_task_id"
      done
    fi
  fi
}

main "$@"
