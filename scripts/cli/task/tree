#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task tree — Print the project todo list (bootstrap)
#
# Full list: tasks grouped by project; optional filtering.
# Focused list: current task and its ancestors only.
#
# Usage:
#   tree [--project <project-id>]... [--detached]     # selected projects, +detached if --detached
#   tree [--all]                                     # all projects + detached
#   tree --focus                                     # current task chain only
#
# Options:
#   --project ID    Filter to specific project(s) (repeatable)
#   --detached      Add detached (orphaned) section to current selection
#   --all           Show all projects and detached section
#   --focus         Show current task and ancestors only (exclusive with other options)
#   --repo PATH     Repository root (overrides TT_REPO; default: find .jj)
#

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [options...]

Generate and print the project todo list.

Options:
  --project ID    Include specific project(s) (repeatable)
  --detached      Add detached (orphaned) tasks to selection
  --all           Show all projects and detached section
  --focus         Show current task and ancestors only
  --repo PATH     Repository root (overrides TT_REPO; default: find .jj)
  -h, --help      Show this help

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}                                    # all projects
  ${COMMAND_NAME:-$SCRIPT_NAME} --project project/main-abc12345    # one project
  ${COMMAND_NAME:-$SCRIPT_NAME} --detached                         # all projects + detached
  ${COMMAND_NAME:-$SCRIPT_NAME} --all                              # all projects + detached
  ${COMMAND_NAME:-$SCRIPT_NAME} --focus                            # current task chain

EOF
}

# Usage: layout_tree MODE CURRENT PROJECTS SHOW_DETACHED < INDEX
# Walks the task index (_task__build_index) and prints the todo list layout,
# one record per line with fields separated by the unit separator (<US>,
# \037):
#   task<US>DEPTH<US>ID<US>PATH<US>STATUS<US>TITLE   one task line, in display order
#   heading<US>TEXT                                  a section heading
#   message<US>TEXT                                  a diagnostic for stderr
# MODE 'full' shows the projects named in PROJECTS (space-separated; all
# bookmarked projects when empty), then the orphaned tasks when SHOW_DETACHED
# is 1. An orphaned task is a bookmarked task that no bookmarked project
# reaches through subtask entries. MODE 'focus' shows the chain of ancestors of CURRENT, then CURRENT
# with all of its descendants.
layout_tree() {
  awk -v mode="$1" -v current="$2" -v project_filter="$3" -v show_detached="$4" '
    BEGIN { FS = "\t"; US = "\037" }
    $1 == "task" {
      order[++task_count] = $2
      kind[$2] = $3; has_branch[$2] = $4; path[$2] = $5
      status[$2] = $7; title[$2] = $8
      next
    }
    $1 == "subtask" {
      n = ++child_count[$2]
      child[$2, n] = $4
      if (!($4 in parent)) parent[$4] = $2
      next
    }

    function emit(id, depth) {
      print "task" US depth US id US path[id] US status[id] US title[id]
      shown[id] = 1
    }

    # Prints the subtree of id. A subtask that is already on the path from the
    # root is skipped, so a cycle in the subtask entries cannot recurse forever.
    # With a focus chain, only the chain member is followed above its last
    # element.
    function emit_subtree(id, depth,   n, subtask) {
      emit(id, depth)
      on_path[id] = 1
      for (n = 1; n <= child_count[id]; n++) {
        subtask = child[id, n]
        if (subtask in on_path) continue
        if (depth + 1 < chain_length && subtask != chain[depth + 2]) continue
        emit_subtree(subtask, depth + 1)
      }
      delete on_path[id]
    }

    function mark_reachable(id,   n) {
      if (id in reachable) return
      reachable[id] = 1
      for (n = 1; n <= child_count[id]; n++) mark_reachable(child[id, n])
    }

    function is_bookmarked_project(id) {
      return (id in kind) && kind[id] == "project" && has_branch[id] == 1
    }

    function layout_focus(   id, length_up, i) {
      id = current
      ancestors[1] = id
      length_up = 1
      on_chain[id] = 1
      while (id in parent) {
        id = parent[id]
        if (id in on_chain) {
          print "message" US "Warning: Cycle detected in task hierarchy at '\''" id "'\''; stopping ancestor walk."
          break
        }
        on_chain[id] = 1
        ancestors[++length_up] = id
      }
      chain_length = length_up
      for (i = 1; i <= length_up; i++) chain[i] = ancestors[length_up - i + 1]
      emit_subtree(chain[1], 0)
    }

    function layout_full(   i, id, project_count, orphan_count, wanted, wanted_count) {
      chain_length = 0
      if (project_filter != "") {
        wanted_count = split(project_filter, wanted, " ")
        for (i = 1; i <= wanted_count; i++) {
          if (is_bookmarked_project(wanted[i])) projects[++project_count] = wanted[i]
        }
        if (project_count == 0) {
          print "message" US "No matching projects found."
          return
        }
      } else {
        for (i = 1; i <= task_count; i++) {
          if (is_bookmarked_project(order[i])) projects[++project_count] = order[i]
        }
        if (project_count == 0) {
          print "message" US "No projects found."
          return
        }
      }
      for (i = 1; i <= project_count; i++) emit_subtree(projects[i], 0)
      if (!show_detached) return

      for (i = 1; i <= task_count; i++) {
        if (is_bookmarked_project(order[i])) mark_reachable(order[i])
      }
      for (i = 1; i <= task_count; i++) {
        id = order[i]
        if (kind[id] == "task" && has_branch[id] == 1 && !(id in reachable)) {
          orphans[++orphan_count] = id
        }
      }
      if (orphan_count == 0) return
      print "heading" US "Orphaned tasks:"
      # An orphan that another task lists appears in that task subtree, so
      # only unlisted orphans start a subtree. Orphans that list each other in
      # a cycle have no such root, and start one each in turn.
      for (i = 1; i <= orphan_count; i++) {
        if (!(orphans[i] in parent)) emit_subtree(orphans[i], 0)
      }
      for (i = 1; i <= orphan_count; i++) {
        if (!(orphans[i] in shown)) emit_subtree(orphans[i], 0)
      }
    }

    END {
      if (mode == "focus") layout_focus()
      else layout_full()
    }
  '
}

# Usage: render_tree CURRENT < LAYOUT
# Prints the todo list markdown for the records layout_tree prints. The line of
# task CURRENT is bold.
render_tree() {
  local current="$1"
  local record type fields depth id path status title indent checkbox i
  while IFS= read -r record; do
    type="${record%%$'\037'*}"
    fields="${record#*$'\037'}"
    case "$type" in
      message)
        _ui__log "$fields"
        ;;
      heading)
        printf '\n%s\n\n' "$fields"
        ;;
      task)
        IFS=$'\037' read -r depth id path status title <<< "$fields"
        indent=''
        for (( i = 0; i < depth; i++ )); do indent+='   '; done
        checkbox="$(_format__status_checkbox "$status")"
        title="${title#"${title%%[![:space:]]*}"}"
        title="${title%"${title##*[![:space:]]}"}"
        [[ -n "$title" ]] || title='(no title)'
        if [[ "$id" == "$current" ]]; then
          printf '%s- %s **[%s](%s) %s**\n' "$indent" "$checkbox" "$id" "$path" "$title"
        else
          printf '%s- %s [%s](%s) %s\n' "$indent" "$checkbox" "$id" "$path" "$title"
        fi
        ;;
    esac
  done
}

main() {
  local -a filter_projects=()
  local show_detached=0
  local show_all=false
  local focus=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        filter_projects+=("$2")
        shift 2
        ;;
      --detached)
        show_detached=1
        shift
        ;;
      --all)
        show_all=true
        shift
        ;;
      --focus)
        focus=true
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage >&2; exit 1
        ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  local current_bookmark
  current_bookmark="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
  local current_task_id=''
  if [[ -n "$current_bookmark" ]] && { _task__check_is_task_branch "$current_bookmark" "$task_prefix" || _task__check_is_project_branch "$current_bookmark" "$project_prefix"; }; then
    current_task_id="$current_bookmark"
  fi

  local mode='full'
  if [[ "$focus" == true ]]; then
    if [[ -z "$current_bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch. Cannot show focused list."
      exit 1
    fi
    if [[ -z "$current_task_id" ]]; then
      _ui__log "Error: Current branch '$current_bookmark' is not a task or project branch. Cannot show focused list."
      exit 1
    fi
    mode='focus'
  fi

  local index
  index="$(_task__build_index "$repo" "$task_prefix" "$project_prefix")" || {
    _ui__log "Error: Cannot read the task index."
    exit 1
  }

  local project_filter=''
  if [[ ${#filter_projects[@]} -gt 0 ]]; then
    project_filter="${filter_projects[*]}"
  elif [[ "$show_all" == true ]]; then
    show_detached=1
  fi

  printf '%s\n' "$index" \
    | layout_tree "$mode" "$current_task_id" "$project_filter" "$show_detached" \
    | render_tree "$current_task_id"
}

main "$@"
