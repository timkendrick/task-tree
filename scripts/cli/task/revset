#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task revset — Print a revision range for a task's unmerged commits.
#
# Usage: revset [--task <task-id>] [--git] [--repo PATH] [-h|--help]

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [--task <task-id>] [--all] [--git] [--repo PATH]

Print a revision range covering all unmerged commits on a task branch since
it diverged from its parent branch.

Without --task, uses the current task and includes any trailing commits
beyond the task bookmark (up to @ if working copy is non-empty, or @- if
empty).

With --task, the range covers only the task bookmark itself.

With --all, prints the task's complete range instead: the union of every
prior check-in range plus the current unmerged range. Only task branches are
supported (not project branches).

Options:
  --task ID    Task branch name (default: current task).
  --all        Print the task's complete range (all check-ins plus unmerged work).
  --git        Output an immutable commit-ID range (<from>..<to>) instead of
               the version-control system's own range expression.
               With --all, prints one immutable range per line.
  --repo PATH  Repository root (overrides TT_REPO; default: find .jj).
  -h, --help   Show this help.

EOF
}

# Usage: print_all_ranges REPO TASK_ID PARENT_BOOKMARK UPPER_BOUND FORMAT
# Prints the task's complete range in FORMAT ('native' or 'git'), one line per
# connected component with 'git' and a single combined line with 'native'.
#
# Only 'native' combines: the union is written as parenthesized ranges joined
# by '|', which the native form understands as one selection covering all the
# components at once. There is no equivalent for an immutable commit-ID range,
# so 'git' emits the components separately and leaves combining to the caller.
print_all_ranges() {
  local repo="$1" task_id="$2" parent_bookmark="$3" upper_bound="$4" format="$5"

  local records
  records="$(_task__get_full_range_records "$repo" "$task_id" "$parent_bookmark" "$upper_bound")" || exit 1

  local base tip _kind _order _ts range joined=''
  while IFS=$'\t' read -r base tip _kind _order _ts; do
    [[ -z "$base" ]] && continue
    range="$(_task__format_range "$repo" "$format" "$base" "$tip")" || {
      _ui__log "Error: Could not resolve range '$base' to '$tip'."
      exit 1
    }
    if [[ "$format" == 'git' ]]; then
      printf '%s\n' "$range"
    elif [[ -z "$joined" ]]; then
      joined="(${range})"
    else
      joined="${joined} | (${range})"
    fi
  done <<< "$records"

  if [[ "$format" != 'git' ]]; then
    printf '%s\n' "$joined"
  fi
}

main() {
  local task_id_arg='' repo='' git_mode=false all_mode=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id_arg="$2"; shift 2 ;;
      --all) all_mode=true; shift ;;
      --git) git_mode=true; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) usage >&2; exit 1 ;;
      *)  usage >&2; exit 1 ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local context exit_code=0
  context="$(_task__get_range_context "$repo" "$task_id_arg")" || exit_code=$?
  [[ $exit_code -ne 0 ]] && exit $exit_code

  local task_id parent_bookmark upper_bound
  IFS=$'\t' read -r task_id parent_bookmark upper_bound <<< "$context"

  # --git selects an immutable commit-ID range; without it the range is printed
  # in the version-control system's own notation, so each form's syntax stays
  # owned by the VCS layer rather than being spelled out here.
  local format='native'
  if "$git_mode"; then
    format='git'
  fi

  if "$all_mode"; then
    local task_prefix
    task_prefix="$(_workspace__get_task_prefix "$repo")"
    if ! _task__check_is_task_branch "$task_id" "$task_prefix"; then
      _ui__log "Error: --all does not support project branches."
      exit 1
    fi
    print_all_ranges "$repo" "$task_id" "$parent_bookmark" "$upper_bound" "$format"
    exit 0
  fi

  # Build the range. The native form keeps the symbolic endpoints, which stay
  # correct as the branches move; the immutable form starts from the fork point
  # because a bookmark name is not a commit ID the range can be pinned to.
  local from_rev="$parent_bookmark"
  if [[ "$format" == 'git' ]]; then
    from_rev="$(_task__resolve_fork_point "$repo" "$parent_bookmark" "$upper_bound")" || exit 1
  fi

  _task__format_range "$repo" "$format" "$from_rev" "$upper_bound" || {
    _ui__log "Error: Could not resolve revision '$upper_bound'."
    exit 1
  }
}

main "$@"
