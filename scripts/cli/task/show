#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task show — Show the metadata and direct child tasks of the current task
#                (default) or the given task.
#
# Usage:
#   show [<task-id>] [--repo PATH] [--expand-context] [-h|--help]
#
# Options:
#   <task-id>          Task ID (branch name) to show. Default: current task.
#   --repo PATH        Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   --expand-context   Expand and show full content of context files.
#   -h, --help         Show this help.

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--repo PATH] [--expand-context]

Show the metadata and direct child tasks of the current task (default)
or the given task. Reads from the correct branch per the "where to read"
rule: merged tasks are read from the parent branch; ongoing tasks are
read from their own branch.

Options:
  <task-id>          Task branch name to show (default: current task).
  --repo PATH        Repository root (overrides TT_REPO; default: find .jj).
  --expand-context   Expand and show full content of context files.
  -h, --help         Show this help.

EOF
}

main() {
  local task_id_arg=''
  local repo=''
  local expand_context=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      --expand-context)
        expand_context=true; shift ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # --- Resolve branch and task file ---
  #
  # Two distinct concepts:
  #   task_id  — the logical ID of the task being shown (used in headers and
  #               parent-lookup).  For an explicit arg this is task_id_arg;
  #               for the implicit case it is the current branch.
  #   branch   — the canonical branch to *read from* ("where to read" rule).
  #               For an ongoing task branch == task_id.  For a completed
  #               (checked-in) task, _task__find_branch returns the parent
  #               branch that received the checkin, so branch != task_id.
  local branch task_file task_id

  if [[ -z "$task_id_arg" ]]; then
    # No task-id: use current branch
    { read -r task_file; read -r branch; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")

    if [[ -z "$branch" ]]; then
      _ui__log "Error: Not on a task or project branch."
      exit 1
    fi
    task_id="$branch"
  else
    task_id="$task_id_arg"
    # Explicit task-id: find its canonical branch via "where to read" rule.
    # For a merged/completed task _task__find_branch returns the parent
    # branch (the one that received the checkin).  The task *file path* is
    # always derived from task_id_arg, not from the canonical branch.
    if ! branch="$(_task__find_branch "$repo" "$task_id_arg" "$task_prefix" "$project_prefix")"; then
      _ui__log "Error: Could not locate branch for task '$task_id_arg'."
      exit 1
    fi
    task_file="$(_task__resolve_file "$task_id_arg" "$task_prefix" "$project_prefix")" || {
      _ui__log "Error: Cannot derive task file path for '$task_id_arg'."
      exit 1
    }
  fi

  # --- Read task fields and body ---
  local fields
  if ! fields="$(_task__read_fields "$repo" "$branch" "$task_id" "$task_prefix" "$project_prefix" \
    title status 'subtask[]' 'context[]' 'label[]' '...')"; then
    _ui__log "Error: Could not read task file '$task_file' from '$branch'."
    exit 1
  fi

  local title status subtask_count context_count label_count entry i body=''
  local subtasks='' contexts='' labels=''
  { IFS= read -r title; IFS= read -r status
    IFS= read -r subtask_count
    for (( i = 0; i < subtask_count; i++ )); do IFS= read -r entry; subtasks+="$entry"$'\n'; done
    IFS= read -r context_count
    for (( i = 0; i < context_count; i++ )); do IFS= read -r entry; contexts+="$entry"$'\n'; done
    IFS= read -r label_count
    for (( i = 0; i < label_count; i++ )); do IFS= read -r entry; labels+="$entry"$'\n'; done
    IFS= read -r -d '' body
  } <<< "$fields" || true
  body="${body%$'\n'}"
  [[ -z "$status" ]] && status="TODO"
  subtasks="${subtasks%$'\n'}"
  contexts="${contexts%$'\n'}"
  labels="$(printf '%s' "$labels" | paste -sd ',' -)"

  body="$(_string__trim_text "$body")"

  # --- Find parent (optional; omitted for parentless/project tasks) ---
  # Use task_id (the logical task ID), not branch (the canonical read branch),
  # so that for completed tasks we find the task's own parent, not the
  # grandparent (which is what we'd get if we searched for the parent of the
  # already-merged parent branch).
  local parent_branch
  parent_branch="$(_task__find_parent_branch "$repo" "$task_id" "$task_prefix" "$project_prefix" 2>/dev/null)" || parent_branch=""

  # --- Print header block ---
  local -a header=(task "$task_id")
  [[ -n "$parent_branch" ]] && header+=(parent "$parent_branch")
  header+=(status "$status" title "$title")
  [[ -n "$labels" ]] && header+=(labels "$labels")
  _format__aligned_block "${header[@]}"

  # --- Print subtasks section ---
  printf '\n'
  if [[ -n "$subtasks" ]]; then
    printf 'Subtasks:\n'
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local checkbox subtask_id subtask_status subtask_title=""
      subtask_id="${line:4}"
      local subtask_branch
      if subtask_branch="$(_task__find_branch "$repo" "$subtask_id" "$task_prefix" "$project_prefix" 2>/dev/null)"; then
        local subtask_fields
        subtask_fields="$(_task__read_fields "$repo" "$subtask_branch" "$subtask_id" \
          "$task_prefix" "$project_prefix" status title)" || subtask_fields=''
        { IFS= read -r subtask_status; IFS= read -r subtask_title; } <<< "$subtask_fields" || true
      fi
      [[ -z "$subtask_status" ]] && subtask_status="TODO"
      checkbox="$(_format__status_checkbox "$subtask_status")"
      if [[ -n "$subtask_title" ]]; then
        printf -- '- %s %s  %s\n' "$checkbox" "$subtask_id" "$subtask_title"
      else
        printf -- '- %s %s\n' "$checkbox" "$subtask_id"
      fi
    done <<< "$subtasks"
  else
    printf '[No subtasks]\n'
  fi
  printf '\n'
  printf -- '---\n'

  # --- Print context section ---
  printf '\n'
  if [[ -n "$contexts" ]]; then
    printf 'Context:\n'
    while IFS= read -r ctx_id; do
      [[ -z "$ctx_id" ]] && continue
      local ctx_title
      ctx_title="$(_task__read_context_fields "$repo" "$branch" "$task_id" "$ctx_id" \
        "$task_prefix" "$project_prefix" title)" || ctx_title=''
      if [[ -n "$ctx_title" ]]; then
        printf -- '- %s (%s)\n' "$ctx_title" "$ctx_id"
      else
        printf -- '- %s\n' "$ctx_id"
      fi
    done <<< "$contexts"
  else
    printf '[No context files]\n'
  fi
  printf '\n'
  printf -- '---\n'

  # --- Print body section ---
  printf '\n'
  if [[ -n "$body" ]]; then
    printf '%s\n' "$body"
  else
    printf '[No description]\n'
  fi
  printf '\n'

  # --- Print expanded context files (if requested) ---
  if [[ "$expand_context" == true ]]; then
    if [[ -n "$contexts" ]]; then
      while IFS= read -r ctx_id; do
        [[ -z "$ctx_id" ]] && continue
        _task__format_context "$repo" "$branch" "$task_id" "$ctx_id" \
          "$task_prefix" "$project_prefix" || true
      done <<< "$contexts"
    fi
  fi
}

main "$@"
