#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../../lib/common.sh
. "$SCRIPT_DIR/../../lib/common.sh"

# tt task context list — List context IDs for a task.
#
# Usage: list [<task-id>] [--task <task-id>] [--repo PATH] [-h|--help]
#
# Environment variables:
#   COMMAND_NAME - Command prefix (e.g., "task context") set by parent dispatcher

readonly SCRIPT_NAME="${COMMAND_NAME:+$COMMAND_NAME }${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--task <task-id>] [--repo PATH]

List the context IDs for the provided task (defaulting to current task) to stdout.

If the task has no context files, nothing is printed and the command exits successfully.

Options:
  <task-id>           Task to list context from (alternative to --task).
  --task TASK_ID      Task to list context from (default: current task).
                      --task takes precedence over the positional argument.
  --repo PATH         Repository root (overrides TT_REPO; default: find .jj).
  -h, --help          Show this help.

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME}
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345
  ${COMMAND_NAME:-$SCRIPT_NAME} --task task/foo-abc12345

EOF
}

main() {
  local task_id_arg=''
  local repo=''
  local positional_task_id=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id_arg="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -n "$positional_task_id" ]]; then
          usage >&2; exit 1
        fi
        positional_task_id="$1"; shift ;;
    esac
  done

  # --task takes precedence over positional argument
  local task_id="${task_id_arg:-$positional_task_id}"

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve task branch and suffix
  local branch task_suffix

  if [[ -n "$task_id" ]]; then
    branch="$task_id"
    if ! _task__check_branch_exists "$repo" "$branch"; then
      _ui__log "Error: Branch '$branch' not found in repository."
      exit 1
    fi
    if _task__check_is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    elif _task__check_is_project_branch "$branch" "$project_prefix"; then
      task_suffix="${branch#$project_prefix}"
    else
      _ui__log "Error: '$task_id' is not a task or project branch."
      exit 1
    fi
  else
    branch="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$branch" ]]; then
      _ui__log "Error: Not on a task or project branch. Use --task to specify."
      exit 1
    fi
    if _task__check_is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    else
      task_suffix="${branch#$project_prefix}"
    fi
  fi

  # Apply "where to read" rule: use _task__find_branch to locate canonical branch
  local read_branch
  if ! read_branch="$(_task__find_branch "$repo" "$branch" "$task_prefix" "$project_prefix")"; then
    _ui__log "Error: Could not locate branch for task '$branch'."
    exit 1
  fi

  # Read task file from canonical branch
  local task_file
  task_file="$(_path__task_file "$task_suffix")"
  local task_content
  if ! task_content="$(_task__read_file "$repo" "$read_branch" "$task_file")"; then
    _ui__log "Error: Could not read task file '$task_file' from '$read_branch'."
    exit 1
  fi

  # Parse context IDs from task frontmatter and output them (one per line)
  # Exit 0 even if no context IDs found (silent success)
  printf '%s' "$task_content" | awk '
    /^---$/ { n++; next }
    n==1 && /^context:/ {
      sub(/^context:[[:space:]]*/, "")
      print
    }
  '
}

main "$@"
