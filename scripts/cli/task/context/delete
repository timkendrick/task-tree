#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../lib/common.sh
. "$SCRIPT_DIR/../../lib/common.sh"

# tt task context delete — Delete a context file from a task.
#
# Usage:
#   delete <context-id> [--task <task-id>] [--repo PATH] [-h|--help]
#
# Options:
#   <context-id>         Context ID to delete (e.g. context/foo-abc12345).
#   --task TASK_ID       Task to delete context from (default: current task).
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   -h, --help           Show this help.
#
# The task need not be checked out: the deletion is committed directly onto
# the task branch, leaving the working copy unchanged.
#
# Environment variables:
#   COMMAND_NAME - Command prefix (e.g., "task context") set by parent dispatcher

readonly SCRIPT_NAME="${COMMAND_NAME:+$COMMAND_NAME }${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} <context-id> [--task <task-id>] [--repo PATH]

Delete a context file from the specified task (default: current task).

Removes both the context file and the corresponding 'context:' entry from
the task's frontmatter, and updates the task's 'updated' timestamp.

The task need not be checked out: the deletion is committed directly onto
the task branch, leaving the working copy unchanged.

Arguments:
  <context-id>          Context ID to delete (e.g. context/foo-abc12345).

Options:
  --task TASK_ID       Task to delete context from (default: current task).
  --repo PATH          Repository root (overrides TT_REPO; default: find .jj).
  -h, --help           Show this help.

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} context/oauth-notes-abc12345
  ${COMMAND_NAME:-$SCRIPT_NAME} context/oauth-notes-abc12345 --task task/foo-abc12345

EOF
}

main() {
  local ctx_id_arg=''
  local task_id_arg=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id_arg="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -n "$ctx_id_arg" ]]; then
          usage >&2; exit 1
        fi
        ctx_id_arg="$1"; shift ;;
    esac
  done

  # Require context ID argument
  if [[ -z "$ctx_id_arg" ]]; then
    usage >&2; exit 1
  fi

  # Validate context ID format (must start with "context/")
  if [[ "$ctx_id_arg" != context/* ]]; then
    _ui__log "Error: Context ID must start with 'context/': $ctx_id_arg"
    exit 1
  fi

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve task branch and suffix
  local branch task_suffix

  if [[ -n "$task_id_arg" ]]; then
    branch="$task_id_arg"
    if ! _task__check_branch_exists "$repo" "$branch"; then
      _ui__log "Error: Branch '$branch' not found in repository."
      exit 1
    fi
    if _task__check_is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    elif _task__check_is_project_branch "$branch" "$project_prefix"; then
      task_suffix="${branch#$project_prefix}"
    else
      _ui__log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    fi
  else
    branch="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$branch" ]]; then
      _ui__log "Error: Not on a task or project branch. Use --task to specify."
      exit 1
    fi
    if _task__check_is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    else
      task_suffix="${branch#$project_prefix}"
    fi
  fi

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1

  # Read the task file from the task's own branch, so tasks that are not checked
  # out anywhere can still be edited.
  local task_file task_content
  task_file="$(_path__task_file "$task_suffix")"
  task_content="$(_task__read_file "$repo" "$branch" "$task_file")" || {
    _ui__log "Error: Could not read task file '$task_file' from branch '$branch'."
    exit 1
  }

  # Parse context IDs from task frontmatter
  local -a all_ctx_ids=()
  while IFS= read -r ctx_id; do
    [[ -z "$ctx_id" ]] && continue
    all_ctx_ids+=("$ctx_id")
  done < <(printf '%s' "$task_content" | awk '
    /^---$/ { n++; next }
    n==1 && /^context:/ {
      sub(/^context:[[:space:]]*/, "")
      print
    }
  ') || true

  # Validate requested context ID exists
  local found=false
  for known in "${all_ctx_ids[@]:-}"; do
    if [[ "$known" == "$ctx_id_arg" ]]; then
      found=true
      break
    fi
  done

  if [[ "$found" == false ]]; then
    _ui__log "Error: Context ID '$ctx_id_arg' not found in task '$branch'."
    exit 1
  fi

  # Read the context file to get its title for the commit message
  local ctx_file ctx_content ctx_title
  ctx_file="$(_path__task_context "$task_suffix" "$ctx_id_arg")"
  ctx_content="$(_task__read_file "$repo" "$branch" "$ctx_file")" || {
    _ui__log "Error: Could not read context file '$ctx_file' from branch '$branch'."
    exit 1
  }
  ctx_title="$(_frontmatter__parse_quoted_field "$ctx_content" "title")"

  if [[ -z "$ctx_title" ]]; then
    ctx_title="(untitled)"
  fi

  # Generate current timestamp for updated field
  local new_timestamp
  new_timestamp="$(_string__generate_timestamp)"

  # Remove context entry from task frontmatter and update 'updated' timestamp
  local updated_task_content
  updated_task_content="$(printf '%s' "$task_content" | awk -v ctx="$ctx_id_arg" -v ts="$new_timestamp" '
    /^---$/ { sep++; if (sep == 2) { print "---"; next } }
    /^context:/ && sep == 1 { val = $0; sub(/^context:[[:space:]]*/, "", val); if (val == ctx) next }
    /^updated:/ && sep == 1 { print "updated: " ts; next }
    { print }
  ')"

  # Writer invoked by _task__commit_on_branch with the staging root: rewrites
  # the task file without the deleted context entry. The context file itself
  # is removed via the --delete flag on the commit call.
  ctx_delete_writer() {
    local root="$1"
    printf '%s\n' "$updated_task_content" > "$root/$task_file"
  }

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  _task__commit_on_branch "$repo" "$branch" \
    "$(_commit__format_message "task" "context:delete" "$branch" "$ctx_title")" \
    --modify "$task_file" --delete "$ctx_file" -- ctx_delete_writer >/dev/null

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$branch"

  _ui__log "Deleted context: $ctx_id_arg"
}

main "$@"
