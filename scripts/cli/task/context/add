#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../../lib/common.sh
. "$SCRIPT_DIR/../../lib/common.sh"

# tt task context add — Create a standalone context file for a task.
#
# Usage:
#   add [<task-id>] [--title <title>] [--slug <slug>] [--repo PATH]
#
# Options:
#   <task-id>            Task branch to add context to (default: current branch).
#   --title TITLE        Context file title (prompted if missing and interactive).
#   --slug SLUG          Context slug (derived from title if not given).
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#
# The task need not be checked out: the context is committed directly onto the
# task branch, leaving the working copy unchanged.
#
# Environment variables:
#   COMMAND_NAME - Command prefix (e.g., "task context") set by parent dispatcher

readonly SCRIPT_NAME="${COMMAND_NAME:+$COMMAND_NAME }${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--title TITLE] [--slug SLUG]
                      [--repo PATH] [--workspace-dir PATH]

Create a standalone context file for the current task (or <task-id>).

A context file is a dated freeform markdown file stored alongside the task
at .tt/task/<task-slug>/context/<ctx-slug>-<hex>.md. It is referenced in the
task's frontmatter via a "context: context/<ctx-slug>-<hex>" entry.

The task need not be checked out: the context is committed directly onto the
task branch, leaving the working copy unchanged.

Context body is read from stdin (via pipe or redirect) if stdin is not a terminal;
otherwise an editor is opened for body input.

Options:
  <task-id>             Task branch to add context to (default: current branch).
  --title TITLE         Context file title (prompted if missing and interactive).
  --slug SLUG           Context file slug (derived from title if not given).
  --repo PATH           Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
  --workspace-dir PATH  Virtual project dir. Overrides workspace_dir in .tt/config.toml.

Examples:
  # Pipe a file directly
  cat ./plan.md | tt task context add --title "Implementation plan"

  # Redirect from file
  tt task context add --title "Implementation plan" < ./plan.md

  # Interactive (no redirect) — opens editor as before
  tt task context add --title "Implementation plan"

EOF
}

main() {
  local ctx_title=''
  local ctx_slug=''
  local task_id_arg=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        ctx_title="$2"; shift 2 ;;
      --slug)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        ctx_slug="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help)
        usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  # Resolve current branch and task file
  local task_file task_suffix bookmark

  if [[ -n "$task_id_arg" ]]; then
    bookmark="$task_id_arg"
    local suffix
    if _task__check_is_task_branch "$bookmark" "$task_prefix"; then
      suffix="${bookmark#$task_prefix}"
    elif _task__check_is_project_branch "$bookmark" "$project_prefix"; then
      suffix="${bookmark#$project_prefix}"
    else
      _ui__log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    fi
    if ! _task__check_branch_exists "$repo" "$bookmark"; then
      _ui__log "Error: Branch '$bookmark' not found in repository."
      exit 1
    fi
    task_suffix="$suffix"
    task_file="$(_path__task_file "$suffix")"
  else
    { read -r task_file; read -r bookmark; } < <(_task__resolve_current "$repo" "$task_prefix" "$project_prefix")
    if [[ -z "$bookmark" ]]; then
      _ui__log "Error: not on a task or project branch."
      exit 1
    fi
    if _task__check_is_task_branch "$bookmark" "$task_prefix"; then
      task_suffix="${bookmark#$task_prefix}"
    else
      task_suffix="${bookmark#$project_prefix}"
    fi
  fi

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1
  _worktree__ensure_canonical_current "$repo" || exit 1

  # Prompt for title if not provided
  if [[ -z "$ctx_title" ]]; then
    if [[ -t 0 ]]; then
      read -e -p "Enter a context title: " ctx_title
    fi
    if [[ -z "$ctx_title" ]]; then
      _ui__log "Error: Context title is required (use --title or enter when prompted)"
      exit 1
    fi
  fi

  # Derive slug from title if not explicitly provided
  if [[ -z "$ctx_slug" ]]; then
    local default_slug
    default_slug="$(_string__to_slug "$ctx_title")"
    if [[ -z "$default_slug" ]]; then
      _ui__log "Error: Could not generate slug from title: $ctx_title"
      exit 1
    fi
    if [[ -t 0 ]]; then
      # Interactive: prompt for slug (consistent with task creation)
      local prompted_slug
      read -e -p "Enter a context identifier (defaults to $default_slug): " prompted_slug
      ctx_slug="${prompted_slug:-$default_slug}"
    else
      ctx_slug="$default_slug"
    fi
  fi
  if ! _string__validate_slug "$ctx_slug"; then
    exit 1
  fi

  # Acquire body text
  local body=''
  if [[ -t 0 ]]; then
    # Interactive: open editor for body
    local raw
    raw="$(_ui__prompt_raw </dev/null)" || {
      _ui__log "Error: Editor exited with non-zero status."
      exit 1
    }
    body="$raw"
  else
    # Read from stdin (pipe or redirect)
    body="$(</dev/stdin)"
  fi

  # Check if body is empty (only whitespace)
  if [[ ! "$body" =~ [^[:space:]] ]]; then
    _ui__log "Error: Context body is empty."
    exit 1
  fi

  # Generate context ID
  local ctx_hex
  ctx_hex="$(_string__generate_hex)"
  local ctx_id="context/${ctx_slug}-${ctx_hex}"
  local ctx_file
  ctx_file="$(_path__task_context "$task_suffix" "$ctx_id")"
  local ctx_ts
  ctx_ts="$(_string__generate_timestamp)"

  # Verify the task file exists on the target branch (it may not be checked out)
  if ! _task__read_file "$repo" "$bookmark" "$task_file" >/dev/null; then
    _ui__log "Error: task file not found on branch '$bookmark': $task_file"
    exit 1
  fi

  # Writer invoked by _task__commit_on_branch with the staging root: writes the
  # new context file and records it in the task file's frontmatter.
  ctx_add_writer() {
    local root="$1"
    mkdir -p "$(_path__dirname "$root/$ctx_file")"
    _frontmatter__write_context_file "$root/$ctx_file" "$ctx_title" "$body" "$ctx_ts" "$ctx_ts"
    # Add context reference to task file frontmatter and update 'updated' timestamp
    _frontmatter__append_context "$root/$task_file" "$ctx_id"
    _frontmatter__update_timestamp "$root/$task_file" "$ctx_ts"
  }

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  _task__commit_on_branch "$repo" "$bookmark" \
    "$(_commit__format_message "task" "context:add" "$bookmark" "$ctx_title")" \
    --modify "$task_file" -- ctx_add_writer >/dev/null

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$bookmark"

  _ui__log "Added context: $ctx_id ($bookmark)"
  printf '%s\n' "$ctx_id"
}

main "$@"
