#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../lib/common.sh
. "$SCRIPT_DIR/../../lib/common.sh"

# tt task context add — Create a standalone context file for a task.
#
# Usage:
#   add [<task-id>] [--title <title>] [--slug <slug>]
#       [--worktree=<path>] [--repo PATH]
#
# Options:
#   <task-id>            Task branch to add context to (default: current branch).
#   --title TITLE        Context file title (prompted if missing and interactive).
#   --slug SLUG          Context slug (derived from title if not given).
#   --worktree=<path>    Worktree to use when task has multiple worktrees.
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#
# Environment variables:
#   COMMAND_NAME - Command prefix (e.g., "task context") set by parent dispatcher

readonly SCRIPT_NAME="${COMMAND_NAME:+$COMMAND_NAME }${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<task-id>] [--title TITLE] [--slug SLUG]
                      [--worktree=<path>] [--repo PATH] [--workspace-dir PATH]

Create a standalone context file for the current task (or <task-id>).

A context file is a dated freeform markdown file stored alongside the task
at .tt/task/<task-slug>/context/<ctx-slug>-<hex>.md. It is referenced in the
task's frontmatter via a "context: context/<ctx-slug>-<hex>" entry.

Context body is read from stdin (via pipe or redirect) if stdin is not a terminal;
otherwise an editor is opened for body input.

Options:
  <task-id>             Task branch to add context to (default: current branch).
  --title TITLE         Context file title (prompted if missing and interactive).
  --slug SLUG           Context file slug (derived from title if not given).
  --worktree=<path>     Worktree to use when task has multiple worktrees.
  --repo PATH           Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
  --workspace-dir PATH  Virtual project dir. Overrides workspace_dir in .tt/config.toml.

Examples:
  # Pipe a file directly
  cat ./plan.md | tt task context add --title "Implementation plan"

  # Redirect from file
  tt task context add --title "Implementation plan" < ./plan.md

  # Interactive (no redirect) — opens editor as before
  tt task context add --title "Implementation plan"

EOF
}

main() {
  local ctx_title=''
  local ctx_slug=''
  local task_id_arg=''
  local worktree_arg=''
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        ctx_title="$2"; shift 2 ;;
      --slug)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        ctx_slug="$2"; shift 2 ;;
      --worktree=*) worktree_arg="${1#--worktree=}"; shift ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help)
        usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$task_id_arg" ]]; then
          task_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(get_workspace_dir "$repo")" || true

  # Resolve current branch and task file
  local task_file task_suffix bookmark

  if [[ -n "$task_id_arg" ]]; then
    bookmark="$task_id_arg"
    local suffix
    if is_task_branch "$bookmark" "$task_prefix"; then
      suffix="${bookmark#$task_prefix}"
    elif is_project_branch "$bookmark" "$project_prefix"; then
      suffix="${bookmark#$project_prefix}"
    else
      log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    fi
    if ! jj -R "$repo" log -r "$bookmark" --no-graph -T '' 2>/dev/null; then
      log "Error: Branch '$bookmark' not found in repository."
      exit 1
    fi
    task_suffix="$suffix"
    task_file="$(task_file_path "$suffix")"
  else
    local resolve_output
    resolve_output="$(resolve_current "$repo" "$task_prefix" "$project_prefix")"
    task_file="$(printf '%s' "$resolve_output" | sed -n '2p')"
    bookmark="$(printf '%s' "$resolve_output" | sed -n '3p')"
    if [[ -z "$bookmark" ]]; then
      log "Error: not on a task or project branch."
      exit 1
    fi
    if is_task_branch "$bookmark" "$task_prefix"; then
      task_suffix="${bookmark#$task_prefix}"
    else
      task_suffix="${bookmark#$project_prefix}"
    fi
  fi

  # Resolve target worktree
  local current_worktree target_worktree
  current_worktree="$(resolve_current_worktree "$repo")"

  local found_worktrees wt_count
  found_worktrees="$(find_worktrees_for_branch "$repo" "$bookmark" "$task_prefix" "$project_prefix")"
  wt_count="$(printf '%s' "$found_worktrees" | grep -c . 2>/dev/null || true)"

  if [[ -n "$task_id_arg" && "$wt_count" -eq 0 ]]; then
    # No dedicated worktree; only safe if we're already on this branch
    local current_bookmark
    current_bookmark="$(resolve_current "$repo" "$task_prefix" "$project_prefix" | sed -n '3p')"
    if [[ "$current_bookmark" != "$bookmark" ]]; then
      log "Error: No worktree found for '$bookmark'. Check it out first with:"
      log "  tt task checkout $bookmark --worktree"
      exit 1
    fi
    target_worktree="$current_worktree"
  else
    if ! target_worktree="$(resolve_task_worktree "$repo" "$bookmark" "$task_prefix" "$project_prefix" \
        "$current_worktree" "$worktree_arg")"; then
      exit 1
    fi
  fi

  # Precondition: WC must be clean (we'll commit after writing the context file)
  if ! is_wc_clean "$target_worktree"; then
    log "Error: Working copy has uncommitted changes. Commit or discard first."
    exit 1
  fi

  # Prompt for title if not provided
  if [[ -z "$ctx_title" ]]; then
    if [[ -t 0 ]]; then
      read -e -p "Enter a context title: " ctx_title
    fi
    if [[ -z "$ctx_title" ]]; then
      log "Error: Context title is required (use --title or enter when prompted)"
      exit 1
    fi
  fi

  # Derive slug from title if not explicitly provided
  if [[ -z "$ctx_slug" ]]; then
    local default_slug
    default_slug="$(title_to_slug "$ctx_title")"
    if [[ -z "$default_slug" ]]; then
      log "Error: Could not generate slug from title: $ctx_title"
      exit 1
    fi
    if [[ -t 0 ]]; then
      # Interactive: prompt for slug (consistent with task creation)
      local prompted_slug
      read -e -p "Enter a context identifier (defaults to $default_slug): " prompted_slug
      ctx_slug="${prompted_slug:-$default_slug}"
    else
      ctx_slug="$default_slug"
    fi
  fi
  if ! validate_slug "$ctx_slug"; then
    exit 1
  fi

  # Acquire body text
  local body=''
  if [[ -t 0 ]]; then
    # Interactive: open editor for body
    local raw
    raw="$(prompt_raw </dev/null)" || {
      log "Error: Editor exited with non-zero status."
      exit 1
    }
    body="$raw"
  else
    # Read from stdin (pipe or redirect)
    body="$(cat)"
  fi

  # Check if body is empty (only whitespace)
  if [[ ! "$body" =~ [^[:space:]] ]]; then
    log "Error: Context body is empty."
    exit 1
  fi

  # Generate context ID
  local ctx_hex
  ctx_hex="$(generate_hex)"
  local ctx_id="context/${ctx_slug}-${ctx_hex}"
  local ctx_file
  ctx_file="$(task_context_path "$task_suffix" "$ctx_id")"
  local ctx_ts
  ctx_ts="$(generate_timestamp)"

  # Resolve context file path on disk
  local task_file_path_on_disk="$target_worktree/$task_file"
  if [[ ! -f "$task_file_path_on_disk" ]]; then
    log "Error: task file not found: $task_file_path_on_disk"
    exit 1
  fi

  # Determine if we need a cross-branch commit (must resolve BEFORE starting
  # the transaction, since resolve_current may trigger a jj snapshot)
  local current_bookmark
  current_bookmark="$(resolve_current "$repo" "$task_prefix" "$project_prefix" | sed -n '3p')"

  # Begin transaction (records before-op for undo) BEFORE any filesystem writes,
  # so the before-op matches the previous command's after-op in the history chain.
  tt_begin_transaction "$repo"

  # Create context directory
  local ctx_dir
  ctx_dir="$(dirname "$target_worktree/$ctx_file")"
  mkdir -p "$ctx_dir"

  # Write context file
  {
    printf -- '---\n'
    printf 'title: "%s"\n' "${ctx_title//\"/\\\"}"
    printf 'created: %s\n' "$ctx_ts"
    printf 'updated: %s\n' "$ctx_ts"
    printf -- '---\n'
    printf '%s\n' "$body"
  } > "$target_worktree/$ctx_file"

  # Add context reference to task file frontmatter and update 'updated' timestamp
  append_frontmatter_context "$task_file_path_on_disk" "$ctx_id"
  update_frontmatter_timestamp "$task_file_path_on_disk" "$ctx_ts"

  if [[ "$target_worktree" == "$current_worktree" && "$current_bookmark" != "$bookmark" ]]; then
    # Cross-branch: need to use jj edit + commit sequence
    local original_parent_rev
    original_parent_rev="$(jj -R "$repo" log -r '@-' --no-graph -T 'commit_id' 2>/dev/null)"

    # Files were already written to the filesystem (since target_worktree == current_worktree
    # but on a different branch — this shouldn't normally happen since we checked worktrees above)
    jj -R "$repo" commit -m "$(format_commit_message "task" "context:add" "$bookmark" "$ctx_title")"
    jj -R "$repo" bookmark set "$bookmark" -r '@-'
    jj -R "$repo" new -r "$original_parent_rev"
  else
    # Same branch: commit normally
    jj -R "$target_worktree" commit -m "$(format_commit_message "task" "context:add" "$bookmark" "$ctx_title")"
    jj -R "$target_worktree" bookmark set "$bookmark" -r '@-'
  fi

  # Commit transaction (records after-op for undo)
  tt_commit_transaction "$repo"

  log "Added context: $ctx_id ($bookmark)"
  printf '%s\n' "$ctx_id"
}

main "$@"
