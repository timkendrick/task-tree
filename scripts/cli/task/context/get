#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../lib/common.sh
. "$SCRIPT_DIR/../../lib/common.sh"

# tt task context get — Print the raw contents of context file(s) for a task.
#
# Usage:
#   get [<context-id> [...]] [--task <task-id>] [--repo PATH] [-h|--help]
#
# Options:
#   <context-id>...      Context IDs to retrieve (default: all context files).
#   --task <task-id>     Task to read context from (default: current task).
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   -h, --help           Show this help.
#
# Environment variables:
#   COMMAND_NAME - Command prefix (e.g., "task context") set by parent dispatcher

readonly SCRIPT_NAME="${COMMAND_NAME:+$COMMAND_NAME }${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<context-id> [...]] [--task <task-id>] [--repo PATH]

Print the raw contents of context file(s) for a task to stdout.

If one or more <context-id> arguments are provided, only those context files
are printed (in the order specified). Otherwise all context files attached to
the task are printed, in declaration order.

The output is the raw file contents including frontmatter. When multiple
context files are printed they are concatenated directly with no separator.

Options:
  <context-id>...      Context IDs to retrieve (e.g. context/foo-abc12345).
  --task TASK_ID       Task branch to read context from (default: current task).
  --repo PATH          Repository root (overrides TT_REPO; default: find .jj).
  -h, --help           Show this help.

Examples:
  ${SCRIPT_NAME}
  ${SCRIPT_NAME} context/oauth-notes-abc12345
  ${SCRIPT_NAME} context/oauth-notes-abc12345 context/api-design-deadbeef
  ${SCRIPT_NAME} --task task/foo-abc12345

EOF
}

main() {
  local task_id_arg=''
  local repo=''
  local -a ctx_id_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        task_id_arg="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        ctx_id_args+=("$1"); shift ;;
    esac
  done

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Resolve task branch and suffix
  local branch task_suffix

  if [[ -n "$task_id_arg" ]]; then
    branch="$task_id_arg"
    if ! jj -R "$repo" --ignore-working-copy log -r "$branch" --no-graph -T '' 2>/dev/null; then
      log "Error: Branch '$branch' not found in repository."
      exit 1
    fi
    if is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    elif is_project_branch "$branch" "$project_prefix"; then
      task_suffix="${branch#$project_prefix}"
    else
      log "Error: '$task_id_arg' is not a task or project branch."
      exit 1
    fi
  else
    local resolve_output
    resolve_output="$(resolve_current "$repo" "$task_prefix" "$project_prefix")"
    branch="$(printf '%s' "$resolve_output" | sed -n '3p')"
    if [[ -z "$branch" ]]; then
      log "Error: Not on a task or project branch. Use --task to specify."
      exit 1
    fi
    if is_task_branch "$branch" "$task_prefix"; then
      task_suffix="${branch#$task_prefix}"
    else
      task_suffix="${branch#$project_prefix}"
    fi
  fi

  # Apply "where to read" rule: use find_branch_for_task to locate canonical branch
  local read_branch
  if ! read_branch="$(find_branch_for_task "$repo" "$branch" "$task_prefix" "$project_prefix")"; then
    log "Error: Could not locate branch for task '$branch'."
    exit 1
  fi

  # Read task file from canonical branch
  local task_file
  task_file="$(task_file_path "$task_suffix")"
  local task_content
  if ! task_content="$(jj_show_at_revision "$repo" "$read_branch" "$task_file")"; then
    log "Error: Could not read task file '$task_file' from '$read_branch'."
    exit 1
  fi

  # Parse context IDs from task frontmatter
  local -a all_ctx_ids=()
  while IFS= read -r ctx_id; do
    [[ -z "$ctx_id" ]] && continue
    all_ctx_ids+=("$ctx_id")
  done < <(printf '%s' "$task_content" | awk '
    /^---$/ { n++; next }
    n==1 && /^context:/ {
      sub(/^context:[[:space:]]*/, "")
      print
    }
  ')

  if [[ ${#all_ctx_ids[@]} -eq 0 ]]; then
    log "Error: Task '$branch' has no context files."
    exit 1
  fi

  # Determine which context IDs to output
  local -a target_ids=()

  if [[ ${#ctx_id_args[@]} -eq 0 ]]; then
    target_ids=("${all_ctx_ids[@]}")
  else
    # Validate each requested ID exists in the task
    for requested in "${ctx_id_args[@]}"; do
      local found=false
      for known in "${all_ctx_ids[@]}"; do
        if [[ "$known" == "$requested" ]]; then
          found=true
          break
        fi
      done
      if [[ "$found" == false ]]; then
        log "Error: Context ID '$requested' not found in task '$branch'."
        log "Available context IDs:"
        for known in "${all_ctx_ids[@]}"; do
          log "  $known"
        done
        exit 1
      fi
      target_ids+=("$requested")
    done
  fi

  # Output each context file
  for ctx_id in "${target_ids[@]}"; do
    local ctx_file
    ctx_file="$(task_context_path "$task_suffix" "$ctx_id")"
    local ctx_content
    if ! ctx_content="$(jj_show_at_revision "$repo" "$read_branch" "$ctx_file")"; then
      log "Error: Could not read context file '$ctx_file' from '$read_branch'."
      exit 1
    fi
    printf '%s\n' "$ctx_content"
  done
}

main "$@"
