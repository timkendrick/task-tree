#!/usr/bin/env bash
set -euo pipefail

# tt task context — Dispatcher for context subcommands
#
# Subcommands are located in the same directory:
#   scripts/cli/task/context/<subcommand>
#
# Usage:
#   tt task context add --title "Research" --body "..."
#   tt task context get context/research-abc123
#   tt task context list
#   tt task context delete context/research-abc123
#
# Environment variables set for subcommands:
#   COMMAND_NAME - The command prefix (e.g., "task context")

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
readonly SCRIPT_NAME="${0##*/}"

log() {
  printf '%s\n' "$*" >&2
}

usage() {
  local exit_code="${1:-1}"
  cat >&2 <<EOF
Usage: tt task context <subcommand> [args...]

Subcommands for managing context files attached to tasks.

Available subcommands:
  add     Create a new context file for a task
  get     Get the contents of a context file
  list    List all context IDs for a task
  delete  Delete a context file from a task

Examples:
  tt task context add --title "Research notes" --body "Findings..."
  tt task context get context/research-abc123
  tt task context list
  tt task context delete context/research-abc123

EOF
  exit "$exit_code"
}

main() {
  if [[ $# -ge 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
    usage 0
  fi

  if [[ $# -eq 0 ]]; then
    log "Error: tt task context requires a subcommand"
    usage
  fi

  local subcommand="$1"
  shift

  local subcommand_script="$SCRIPT_DIR/$subcommand"

  if [[ ! -f "$subcommand_script" ]] || [[ ! -x "$subcommand_script" ]]; then
    log "tt: context subcommand not found: $subcommand"
    exit 1
  fi

  # Pass COMMAND_NAME prefix for proper usage messages
  # This allows subcommands to show "tt task context add" instead of just "add"
  export COMMAND_NAME="task context"

  exec "$subcommand_script" "$@"
}

main "$@"