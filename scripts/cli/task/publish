#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task publish — Merge a project branch's work into an external target branch.
#
# Usage:
#   publish [<project-id>] --target <branch> [-m <message>]
#           [--changelog [--changelog-depth <n>]] [--rebase | --merge] [--force]
#           [--repo PATH] [--workspace-dir PATH]
#
# Options:
#   <project-id>            Project branch to publish (default: current branch).
#   --target <branch>       Target branch to publish into (required).
#   -m, --message <msg>     Publish commit message (skips editor prompt).
#   --changelog             Append a change summary to the commit message.
#   --changelog-depth <n>   Levels of subtask to summarize (requires --changelog).
#   --rebase                Rebase project onto target before publishing.
#   --merge                 Merge target into project before publishing.
#   --force                 Proceed even if conflicts occur.
#   --repo PATH             Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   --workspace-dir PATH    Virtual project dir.

readonly SCRIPT_NAME="${0##*/}"

# Header introducing the change summary appended to the publish commit message.
readonly CHANGE_SUMMARY_HEADER='Change summary:'

# Stands in for the change summary when nothing was checked in since the target.
readonly NO_CHANGES_PLACEHOLDER='No code changes'

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<project-id>] --target <branch> [options...]

Merge a project branch's work into an external target branch (e.g. main).
Removes task scaffolding files (.tt/task/) from the delivery branch.
Stays on the project branch after publishing (no workspace switch).

Prompts for the publish commit message in an editor unless --message is given.
An empty message cancels the publish.

Options:
  <project-id>              Project branch to publish (default: current branch).
  --target <branch>         Target branch to publish into (required).
  -m, --message <msg>       Publish commit message (skips editor prompt).
  --changelog               Append a summary of the changes since the target
                            branch to the commit message.
  --changelog-depth <n>     Levels of subtask to summarize (requires --changelog;
                            default: every level).
  --rebase                  Rebase project onto target before publishing.
  --merge                   Merge target into project before publishing.
  --force                   Proceed despite conflicts.
  --repo PATH               Repository root (overrides TT_REPO; default: find .jj).
  --workspace-dir PATH      Virtual project dir.
  -h, --help                Show this help.

EOF
}

# Usage: build_change_summary REPO PROJECT_ID TARGET [DEPTH]
#
# Prints the change summary section for the work on PROJECT_ID since it last
# diverged from TARGET: a leading blank line, the header, a blank line, then the
# changelog ($NO_CHANGES_PLACEHOLDER when there is nothing to report).
#
# The leading newline is the blank line separating the section from the message
# above it, so callers append the section to a message not ending in a newline.
#
# Exit 1: the changelog could not be generated.
build_change_summary() {
  local repo="$1" project_id="$2" target="$3" depth="${4:-}"

  local -a depth_args=()
  [[ -n "$depth" ]] && depth_args=(--depth "$depth")

  local changelog
  changelog="$("$SCRIPT_DIR/changelog" \
    --task "$project_id" \
    --since "$target" \
    ${depth_args[@]+"${depth_args[@]}"} \
    --repo "$repo")" || return 1

  [[ -z "$changelog" ]] && changelog="$NO_CHANGES_PLACEHOLDER"

  printf '\n%s\n\n%s\n' "$CHANGE_SUMMARY_HEADER" "$changelog"
}

# Usage: build_message_template PROJECT_ID TARGET CHANGE_SUMMARY
#
# Prints the editor template: an empty message area, the change summary section
# when one was generated, then hint lines that the editor prompt strips.
build_message_template() {
  local project_id="$1" target="$2" change_summary="$3"

  printf '\n'
  [[ -n "$change_summary" ]] && printf '%s\n' "$change_summary"
  printf '\n# Project: %s\n# Target: %s\n# An empty message cancels the publish.\n' \
    "$project_id" "$target"
}

main() {
  local strategy=''
  local force=false
  local target=''
  local project_id_arg=''
  local repo=''
  local message=''
  local message_provided=false
  local changelog=false
  local changelog_depth=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rebase)
        [[ -n "$strategy" && "$strategy" != rebase ]] && { usage >&2; exit 1; }
        strategy='rebase'; shift ;;
      --merge)
        [[ -n "$strategy" && "$strategy" != merge ]] && { usage >&2; exit 1; }
        strategy='merge'; shift ;;
      --force)      force=true; shift ;;
      --target)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        target="$2"; shift 2 ;;
      -m|--message)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        message="$2"; message_provided=true; shift 2 ;;
      --changelog)  changelog=true; shift ;;
      --changelog-depth)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        [[ "$2" =~ ^[0-9]+$ ]] || { usage >&2; exit 1; }
        changelog_depth="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$project_id_arg" ]]; then
          project_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  # --target is required
  if [[ -z "$target" ]]; then
    usage >&2; exit 1
  fi

  # A depth is only meaningful when a change summary is being generated.
  if [[ -n "$changelog_depth" && "$changelog" != true ]]; then
    usage >&2; exit 1
  fi

  repo="$(resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(get_task_prefix "$repo")"
  project_prefix="$(get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(get_workspace_dir "$repo")" || true

  local current_worktree
  current_worktree="$(resolve_current_worktree "$repo")"

  # --- Resolve project branch ---
  local child_bookmark child_slug

  if [[ -n "$project_id_arg" ]]; then
    child_bookmark="$project_id_arg"
    if ! is_project_branch "$child_bookmark" "$project_prefix"; then
      log "Error: '$project_id_arg' is not a project branch."
      log "  Use 'tt task checkin' to check in task branches."
      exit 1
    fi
    if ! jj -R "$repo" log -r "$child_bookmark" --no-graph -T '' 2>/dev/null; then
      log "Error: Branch '$child_bookmark' not found in repository."
      exit 1
    fi
    child_slug="${child_bookmark#"$project_prefix"}"
  else
    child_bookmark="$(resolve_current_bookmark "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$child_bookmark" ]]; then
      log "Error: Not on a task or project branch."
      exit 1
    fi
    if ! is_project_branch "$child_bookmark" "$project_prefix"; then
      log "Error: 'tt task publish' requires a project branch."
      log "  Current branch '$child_bookmark' is a task branch."
      log "  Use 'tt task checkin' to check in task branches."
      exit 1
    fi
    child_slug="${child_bookmark#"$project_prefix"}"
  fi

  local task_id="$child_bookmark"

  # --- Validate target branch exists ---
  if ! jj -R "$repo" log -r "$target" --no-graph -T '' 2>/dev/null; then
    log "Error: --target '$target' not found in repository."
    exit 1
  fi

  # --- Check WC clean ---
  if ! is_wc_clean "$current_worktree"; then
    log "Error: Working copy has uncommitted changes. Commit or discard first."
    exit 1
  fi

  # --- Read task title from project branch ---
  local task_file task_content task_title
  task_file="$(task_file_path "$child_slug")"
  task_content="$(jj_show_at_revision "$repo" "$child_bookmark" "$task_file")" || true
  task_title="$(parse_quoted_frontmatter_field "$task_content" "title" 2>/dev/null)" || task_title="$child_bookmark"

  # --- Optional: rebase/merge propagation from target ---
  if [[ -n "$strategy" ]]; then
    log "Propagating target ($strategy) into project before publishing..."
    "$SCRIPT_DIR/propagate" \
      --from "$target" \
      --to "$child_bookmark" \
      --"$strategy" \
      ${force:+--force} \
      --repo "$repo"
    if ! is_wc_clean "$current_worktree"; then
      log "Error: Working copy not clean after propagation."
      exit 1
    fi
  fi

  # --- Resolve the publish commit message ---
  # Resolved after any propagation, so the change summary reports exactly the
  # history being published, and before the transaction opens, so an empty or
  # abandoned message leaves no VCS state to unwind.
  local change_summary=''
  if [[ "$changelog" == true ]]; then
    change_summary="$(build_change_summary \
      "$repo" "$child_bookmark" "$target" "$changelog_depth")" || {
      log "Error: Could not summarize '$child_bookmark' since '$target'."
      exit 1
    }
  fi

  if [[ "$message_provided" == true ]]; then
    if [[ -n "$change_summary" ]]; then
      message="${message}"$'\n'"${change_summary}"
    fi
  else
    local template
    template="$(build_message_template "$child_bookmark" "$target" "$change_summary")"
    message="$(prompt <<< "$template")" || exit 1
  fi

  if [[ -z "$message" ]]; then
    log "Publish cancelled."
    exit 1
  fi

  # Begin transaction (records before-op for undo)
  tt_begin_transaction "$repo"

  log "Publishing: $child_bookmark -> $target"

  # --- Determine target workspace ---
  local target_ws
  local worktrees
  worktrees="$(find_worktrees_for_branch "$repo" "$target" "$task_prefix" "$project_prefix")"
  local wt_count
  wt_count="$(printf '%s' "$worktrees" | grep -c . 2>/dev/null || true)"

  case "$wt_count" in
    0) target_ws="$repo" ;;
    1) target_ws="$worktrees" ;;
    *)
      log "Error: Multiple workspaces found for target '$target'."
      printf '%s\n' "$worktrees" | while IFS= read -r p; do log "  $p"; done
      exit 1
      ;;
  esac

  # --- Create handoff commit ---
  # New WC branching from project bookmark (stages files for handoff)
  jj -R "$target_ws" new "$child_bookmark"

  # Project publish: remove TASK.md symlink and .tt/task/ directory.
  # Task files are development-only scaffolding; they must not land on the
  # delivery branch. .tt/config.toml is kept (workspace configuration).
  rm -f "$target_ws/TASK.md"
  rm -rf "$target_ws/$(task_root_path)"

  # Commit the handoff (project bookmark does NOT advance)
  jj -R "$target_ws" commit -m "$(format_commit_message "task" "handoff" "$task_id" "$task_title")"
  local handoff_commit
  handoff_commit="$(jj -R "$target_ws" log -r '@-' --no-graph -T 'commit_id')"

  # --- Create merge commit and advance target bookmark ---
  jj -R "$target_ws" new "$target" "$handoff_commit"

  # Check for conflicts (unless --force)
  # On conflict, exit 1 triggers the ERR trap → tt_rollback_transaction →
  # jj op restore, which cleanly reverts all jj operations in this transaction.
  if [[ "$force" != true ]] && has_conflicts "$target_ws" "@"; then
    log "Error: Merge conflicts detected. Resolve conflicts or use --force."
    exit 1
  fi

  jj -R "$target_ws" describe -m "$(format_commit_message "task" "publish" "$task_id" "$message")"
  jj -R "$target_ws" bookmark set "$target" -r '@'

  # After publish, return to the project branch.
  jj -R "$target_ws" new "$child_bookmark"

  # Commit transaction (records after-op for undo)
  tt_commit_transaction "$repo"

  log "Published: $child_bookmark -> $target"
}

main "$@"
