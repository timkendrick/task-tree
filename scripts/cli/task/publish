#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task publish — Merge a project branch's work into an external target branch.
#
# Usage:
#   publish [<project-id>] --target <branch> [-m <message>]
#           [--changelog [--changelog-depth <n>]] [--force]
#           [--repo PATH] [--workspace-dir PATH]
#
# Options:
#   <project-id>            Project branch to publish (default: current branch).
#   --target <branch>       Target branch to publish into (required).
#   -m, --message <msg>     Publish commit message (skips editor prompt; required when stdin is
#                           not a terminal). An empty message cancels the publish.
#   --changelog             Append a change summary to the commit message.
#   --changelog-depth <n>   Levels of subtask to summarize (requires --changelog).
#   --force                 Proceed even if conflicts occur.
#   --repo PATH             Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).
#   --workspace-dir PATH    Virtual project dir.

readonly SCRIPT_NAME="${0##*/}"

# Header introducing the change summary appended to the publish commit message.
readonly CHANGE_SUMMARY_HEADER='Change summary:'

# Stands in for the change summary when nothing was checked in since the target.
readonly NO_CHANGES_PLACEHOLDER='No code changes'

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} [<project-id>] --target <branch> [options...]

Merge a project branch's work into an external target branch (e.g. main).
Removes task scaffolding files (.tt/task/) from the delivery branch.
Stays on the project branch after publishing (no workspace switch).

Prompts for the publish commit message in an editor unless --message is given.
When stdin is not a terminal, --message is required. An empty message cancels
the publish.

Options:
  <project-id>              Project branch to publish (default: current branch).
  --target <branch>         Target branch to publish into (required).
  -m, --message <msg>       Publish commit message (skips editor prompt).
  --changelog               Append a summary of the changes since the target
                            branch to the commit message.
  --changelog-depth <n>     Levels of subtask to summarize (requires --changelog;
                            default: every level).
  --force                   Proceed despite conflicts.
  --repo PATH               Repository root (overrides TT_REPO; default: find .jj).
  --workspace-dir PATH      Virtual project dir.
  -h, --help                Show this help.

EOF
}

# Usage: build_change_summary REPO PROJECT_ID TARGET [DEPTH]
#
# Prints the change summary section for the work on PROJECT_ID since it last
# diverged from TARGET: a leading blank line, the header, a blank line, then the
# changelog ($NO_CHANGES_PLACEHOLDER when there is nothing to report).
#
# The leading newline is the blank line separating the section from the message
# above it, so callers append the section to a message not ending in a newline.
#
# Exit 1: the changelog could not be generated.
build_change_summary() {
  local repo="$1" project_id="$2" target="$3" depth="${4:-}"

  local -a depth_args=()
  [[ -n "$depth" ]] && depth_args=(--depth "$depth")

  local changelog
  changelog="$("$SCRIPT_DIR/changelog" \
    --task "$project_id" \
    --since "$target" \
    ${depth_args[@]+"${depth_args[@]}"} \
    --repo "$repo")" || return 1

  [[ -z "$changelog" ]] && changelog="$NO_CHANGES_PLACEHOLDER"

  printf '\n%s\n\n%s\n' "$CHANGE_SUMMARY_HEADER" "$changelog"
}

# Usage: build_message_template PROJECT_ID TARGET CHANGE_SUMMARY
#
# Prints the editor template: an empty message area, the change summary section
# when one was generated, then hint lines that the editor prompt strips.
build_message_template() {
  local project_id="$1" target="$2" change_summary="$3"

  printf '\n'
  [[ -n "$change_summary" ]] && printf '%s\n' "$change_summary"
  printf '\n# Project: %s\n# Target: %s\n# An empty message cancels the publish.\n' \
    "$project_id" "$target"
}

main() {
  local force=false
  local target=''
  local project_id_arg=''
  local repo=''
  local message=''
  local message_provided=false
  local include_changelog=false
  local changelog_depth=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)      force=true; shift ;;
      --target)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        target="$2"; shift 2 ;;
      -m|--message)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        message="$2"; message_provided=true; shift 2 ;;
      --changelog)  include_changelog=true; shift ;;
      --changelog-depth)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        [[ "$2" =~ ^[0-9]+$ ]] || { usage >&2; exit 1; }
        changelog_depth="$2"; shift 2 ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*)
        usage >&2; exit 1 ;;
      *)
        if [[ -z "$project_id_arg" ]]; then
          project_id_arg="$1"; shift
        else
          usage >&2; exit 1
        fi ;;
    esac
  done

  # --target is required
  if [[ -z "$target" ]]; then
    usage >&2; exit 1
  fi

  # A depth is only meaningful when a change summary is being generated.
  if [[ -n "$changelog_depth" && "$include_changelog" != true ]]; then
    usage >&2; exit 1
  fi

  if [[ "$message_provided" == false && ! -t 0 ]]; then
    _ui__log "Error: cannot open an editor for the publish message: stdin is not a terminal. Pass --message <msg>."
    exit 1
  fi

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  # --- Resolve project branch ---
  local child_bookmark

  if [[ -n "$project_id_arg" ]]; then
    child_bookmark="$project_id_arg"
    if ! _task__check_is_project_branch "$child_bookmark" "$project_prefix"; then
      _ui__log "Error: '$project_id_arg' is not a project branch."
      _ui__log "  Use 'tt task checkin' to check in task branches."
      exit 1
    fi
    if ! _task__check_branch_exists "$repo" "$child_bookmark"; then
      _ui__log "Error: Branch '$child_bookmark' not found in repository."
      exit 1
    fi
  else
    child_bookmark="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
    if [[ -z "$child_bookmark" ]]; then
      _ui__log "Error: Not on a task or project branch."
      exit 1
    fi
    if ! _task__check_is_project_branch "$child_bookmark" "$project_prefix"; then
      _ui__log "Error: 'tt task publish' requires a project branch."
      _ui__log "  Current branch '$child_bookmark' is a task branch."
      _ui__log "  Use 'tt task checkin' to check in task branches."
      exit 1
    fi
  fi

  local task_id="$child_bookmark"

  # --- Validate target branch exists ---
  if ! _task__check_branch_exists "$repo" "$target"; then
    _ui__log "Error: --target '$target' not found in repository."
    exit 1
  fi

  # No clean-working-copy precondition: publish writes nothing through any
  # working copy and validates no unmerged range, so uncommitted changes in
  # the invoking worktree are simply left alone.

  # --- Read task title from project branch ---
  local task_title
  task_title="$(_task__read_title "$repo" "$child_bookmark" "$child_bookmark" \
    "$task_prefix" "$project_prefix")" || task_title=''

  # --- Resolve the publish commit message ---
  # Resolved before the transaction opens, so an empty or abandoned message
  # leaves no VCS state to unwind.
  local change_summary=''
  if [[ "$include_changelog" == true ]]; then
    change_summary="$(build_change_summary \
      "$repo" "$child_bookmark" "$target" "$changelog_depth")" || {
      _ui__log "Error: Could not summarize '$child_bookmark' since '$target'."
      exit 1
    }
  fi

  if [[ "$message_provided" == true ]]; then
    if [[ -n "$change_summary" ]]; then
      message="${message}"$'\n'"${change_summary}"
    fi
  else
    local template
    template="$(build_message_template "$child_bookmark" "$target" "$change_summary")"
    message="$(_ui__prompt <<< "$template")" || exit 1
  fi

  if [[ -z "$message" ]]; then
    _ui__log "Publish canceled: no message provided."
    exit 1
  fi

  # Precondition: the working-copy commit must not carry a bookmark
  _worktree__ensure_working_copy "$repo" || exit 1
  _worktree__ensure_canonical_current "$repo" || exit 1

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  _ui__log "Publishing: $child_bookmark -> $target"

  # Pin the target tip: it anchors the merge's first parent and the worktree
  # reattachment below.
  local old_target_tip
  old_target_tip="$(_task__resolve_revision "$repo" "$target")" || {
    _ui__log "Error: Could not resolve branch '$target'."
    exit 1
  }

  # Writer invoked by _task__commit_handoff with the staging root. The publish
  # handoff carries only deletions (declared via the delete flags below), so
  # nothing is staged.
  publish_handoff_writer() {
    :
  }

  # --- Create the handoff commit (project bookmark does NOT advance) ---
  # Project publish: remove the repo-root TASK.md symlink and the .tt/task/
  # tree. Task files are development-only scaffolding; they must not land on
  # the delivery branch. .tt/config.toml is kept (workspace configuration).
  local handoff_commit
  handoff_commit="$(_task__commit_handoff "$repo" "$child_bookmark" \
    "$(_commit__format_message "task" "handoff" "$task_id" "$task_title")" \
    --delete "$TT_TASK_SYMLINK_FILENAME" \
    --delete-prefix "$(_path__task_root)" \
    -- publish_handoff_writer)"

  # --- Create the merge commit and advance the target bookmark ---
  # Parents: target tip first, handoff second (the order full-range discovery
  # relies on). The merge carries no file writes of its own.
  local merge_commit
  merge_commit="$(_task__merge_branch "$repo" \
    "$(_commit__format_message "task" "publish" "$task_id" "$message")" \
    "$old_target_tip" "$handoff_commit")"

  # Check for conflicts (unless --force)
  # Exiting here leaves the transaction open, so its abort trap rolls back to
  # the before-op state, cleanly reverting this transaction's writes.
  if [[ "$force" != true ]] && _task__check_conflicts "$repo" "$merge_commit"; then
    _ui__log "Error: Merge conflicts detected. Resolve conflicts or use --force."
    exit 1
  fi

  # Follow the advance with the current worktree only when it sits on the
  # TARGET branch (a worktree on the project branch — typically the one this
  # command runs from — stays put: publish affects the target branch, not the
  # invoking worktree).
  _worktree__reattach_current "$repo" "$target" \
    "$old_target_tip" "$merge_commit"

  _task__advance_branch "$repo" "$target" "$merge_commit"

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  _worktree__report_unsynced "$repo" "$target"

  _ui__log "Published: $child_bookmark -> $target"
}

main "$@"
