#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"

# tt task checkout — switch to a task or project branch.
#
# Working-copy-bound: a checkout exists to put a working copy on a branch, so
# unlike the commands that write their branch bare it creates worktrees and
# moves working copies. Every VCS operation therefore goes through the
# working-copy-bound facades in lib/worktree.sh, which take the worktree root
# explicitly — the target worktree here is not necessarily the one the command
# was invoked from.
#
# Checking out a task whose status is TODO (never checked out) or DONE (completed)
# creates a [tt:task:<task-id>:checkout] commit setting status to IN-PROGRESS and
# advances the task bookmark. Reopening a DONE task appends this commit to the task's
# existing branch; no parent changes are pulled in unless --rebase/--merge is given.
#
# Usage:
#   checkout <task-id> [--worktree[=<path>] [--switch]] [--rebase | --merge] [--force] [--repo PATH]
#
# Options:
#   <task-id>            Task or project ID (required)
#   --worktree[=<path>]  Use or create a dedicated workspace for this task.
#                        Without =<path>, derives path from <workspace-dir>/<task-id>.
#   --switch             (only with --worktree) Also update the HEAD symlink to the new
#                        worktree. Without this flag, HEAD is not updated when --worktree
#                        is used.
#   --rebase             Rebase the task onto its parent's tip before checking out.
#   --merge              Merge the parent's tip into the task before checking out.
#   --force              Proceed even if the target workspace has local changes.
#   --repo PATH          Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

readonly SCRIPT_NAME="${0##*/}"

usage() {
  cat <<EOF
Usage: ${COMMAND_NAME:-$SCRIPT_NAME} <task-id> [--worktree[=<path>] [--switch]] [--rebase | --merge] [--force] [--repo PATH]

Switch to the given task or project branch.

Arguments:
  <task-id>  Task or project ID (e.g. task/foo-abc12345, project/bar-deadbeef)

Options:
  --worktree[=<path>]  Use or create a dedicated workspace for this task.
                        If no path given, defaults to <workspace-dir>/<task-id>
                        (resolved from the .tt/workspace symlink).
  --switch              (only with --worktree) Also update the HEAD symlink to the
                        new worktree. Without this flag, HEAD is not updated when
                        --worktree is used.
  --rebase              Rebase the task onto its parent's current tip before
                        checking out. Not valid for project branches.
  --merge               Merge the parent's current tip into the task before
                        checking out. Not valid for project branches.
  --force               Proceed even if the target workspace has local changes.
  --repo PATH           Repository root (overrides TT_REPO; default: walk up from CWD to find .jj).

Examples:
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345 --worktree
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345 --worktree --switch
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345 --worktree=/path/to/workspace
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345 --rebase
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345 --merge
  ${COMMAND_NAME:-$SCRIPT_NAME} task/foo-abc12345 --force

EOF
}

main() {
  local task_id=''
  local worktree_flag=false
  local worktree_path=''
  local explicit_path=false
  local switch_flag=false
  local strategy=''
  local force=false
  local repo=''

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worktree)
        worktree_flag=true
        shift
        ;;
      --worktree=*)
        worktree_flag=true
        worktree_path="${1#--worktree=}"
        explicit_path=true
        shift
        ;;
      --switch)
        switch_flag=true
        shift
        ;;
      --rebase)
        [[ -n "$strategy" && "$strategy" != rebase ]] && { usage >&2; exit 1; }
        strategy='rebase'
        shift
        ;;
      --merge)
        [[ -n "$strategy" && "$strategy" != merge ]] && { usage >&2; exit 1; }
        strategy='merge'
        shift
        ;;
      --force)
        force=true
        shift
        ;;
      --repo)
        [[ $# -lt 2 ]] && { usage >&2; exit 1; }
        repo="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        usage >&2; exit 1
        ;;
      *)
        if [[ -z "$task_id" ]]; then
          task_id="$1"
          shift
        else
          usage >&2; exit 1
        fi
        ;;
    esac
  done

  if [[ -z "$task_id" ]]; then
    usage >&2; exit 1
  fi

  if [[ "$switch_flag" == true && "$worktree_flag" != true ]]; then
    usage >&2; exit 1
  fi

  repo="$(_workspace__resolve_repo "$repo")"

  local task_prefix project_prefix
  task_prefix="$(_workspace__get_task_prefix "$repo")"
  project_prefix="$(_workspace__get_project_prefix "$repo")"

  # Validate task_id format
  if ! _task__check_is_task_branch "$task_id" "$task_prefix" && ! _task__check_is_project_branch "$task_id" "$project_prefix"; then
    _ui__log "Error: '$task_id' is not a recognized task or project ID"
    _ui__log "  Expected prefix '$task_prefix' or '$project_prefix' with 8-hex suffix"
    exit 1
  fi

  # --rebase/--merge pull changes from the parent branch; project branches have no parent.
  if [[ -n "$strategy" ]] && _task__check_is_project_branch "$task_id" "$project_prefix"; then
    _ui__log "Error: --rebase/--merge require a task branch."
    _ui__log "  '$task_id' is a project branch and has no parent."
    exit 1
  fi

  # Verify bookmark exists
  if ! _task__check_branch_exists "$repo" "$task_id"; then
    _ui__log "Error: Task '$task_id' not found in repository"
    exit 1
  fi

  # Derive slug and task file path
  local task_slug task_file
  if _task__check_is_task_branch "$task_id" "$task_prefix"; then
    task_slug="${task_id#"$task_prefix"}"
  else
    task_slug="${task_id#"$project_prefix"}"
  fi
  task_file="$(_path__task_file "$task_slug")"

  # Resolve workspace dir via .tt/workspace symlink
  local workspace_dir
  workspace_dir="$(_workspace__get_dir "$repo")" || true

  # Resolve current worktree and bookmark for hook env vars
  local current_worktree previous_task_id previous_task_branch
  current_worktree="$(_worktree__resolve_current "$repo")"
  previous_task_id="$(_task__resolve_current_branch "$repo" "$task_prefix" "$project_prefix")"
  previous_task_branch="$previous_task_id"

  # Determine target worktree and whether it's being created fresh
  local target_worktree new_worktree=false

  if [[ "$worktree_flag" == true ]]; then
    # --worktree: determine workspace path
    if [[ -z "$worktree_path" ]]; then
      # Use _worktree__find_for_branch to locate any existing workspace for this task
      local existing_worktrees worktree_count
      existing_worktrees="$(_worktree__find_for_branch "$repo" "$task_id" "$task_prefix" "$project_prefix")"
      worktree_count="$(printf '%s' "$existing_worktrees" | grep -c . 2>/dev/null || true)"
      if [[ "$worktree_count" -gt 1 ]]; then
        _ui__log "Error: Multiple workspaces found for '$task_id'; specify --worktree=<path>:"
        printf '%s' "$existing_worktrees" | while IFS= read -r p; do _ui__log "  $p"; done
        exit 1
      elif [[ "$worktree_count" -eq 1 ]]; then
        worktree_path="$existing_worktrees"
        _ui__log "Found existing workspace: $worktree_path"
      else
        # No existing workspace found; derive conventional path
        if [[ -z "$workspace_dir" ]]; then
          _ui__log "Error: --worktree requires a workspace dir or an explicit path (--worktree=<path>)"
          _ui__log "  Run 'tt workspace init' to create the .tt/workspace symlink."
          exit 1
        fi
        worktree_path="${workspace_dir}/${task_id}"
      fi
    fi

    # When --worktree=<path> was explicitly given, verify it doesn't
    # conflict with an existing workspace at a different path.
    if [[ "$explicit_path" == true ]]; then
      local existing_wts
      existing_wts="$(_worktree__find_for_branch "$repo" "$task_id" "$task_prefix" "$project_prefix")"
      if [[ -n "$existing_wts" ]]; then
        local normalized_worktree match_found=false
        normalized_worktree="$(realpath "$worktree_path" 2>/dev/null || echo "$worktree_path")"
        while IFS= read -r existing_path; do
          [[ -z "$existing_path" ]] && continue
          local normalized_existing
          normalized_existing="$(realpath "$existing_path")"
          if [[ "$normalized_worktree" == "$normalized_existing" ]]; then
            match_found=true
            break
          fi
        done <<< "$existing_wts"
        if [[ "$match_found" != true ]]; then
          local first_existing
          first_existing="$(printf '%s' "$existing_wts" | head -1)"
          _ui__log "Error: Task '$task_id' already has a workspace at '$first_existing'."
          _ui__log "  Multiple worktrees per task are not supported."
          exit 1
        fi
      fi
    fi

    target_worktree="$worktree_path"

    if [[ -d "$target_worktree" && ( -d "$target_worktree/.jj" || -L "$target_worktree/.jj" ) ]]; then
      # Existing workspace: check for local changes
      if ! _worktree__check_clean "$target_worktree"; then
        if [[ "$force" != true ]]; then
          _ui__log "Error: Workspace '$target_worktree' has uncommitted changes."
          _ui__log "  Commit or discard changes first, or use --force to proceed anyway."
          exit 1
        fi
        _ui__log "Warning: Workspace has uncommitted changes (proceeding due to --force)."
      fi
      _ui__log "Using existing workspace: $target_worktree"
    else
      new_worktree=true
      mkdir -p "$(dirname "$target_worktree")"
    fi
  else
    # No --worktree: use current workspace
    target_worktree="$current_worktree"
    if ! _worktree__check_clean "$target_worktree"; then
      if [[ "$force" != true ]]; then
        _ui__log "Error: Working copy has uncommitted changes."
        _ui__log "  Commit or discard changes first, or use --force to proceed anyway."
        exit 1
      fi
      _ui__log "Warning: Working copy has uncommitted changes (proceeding due to --force)."
    fi
  fi

  # Precondition: the working-copy commit of the worktree this command was
  # invoked from must not carry a bookmark. The transaction below snapshots
  # that working copy, and a bookmark sitting on it would follow the snapshot,
  # absorbing whatever is uncommitted there into the branch it names.
  _worktree__ensure_working_copy "$repo" || exit 1

  # Begin transaction (records before-op for undo)
  _history__begin_transaction "$repo"

  # --- Optional: rebase/merge parent into this task before checking out ---
  # Runs inside the transaction so a propagation failure rolls the whole command back.
  if [[ -n "$strategy" ]]; then
    local parent_bookmark
    parent_bookmark="$(_task__find_parent_branch "$repo" "$task_id" "$task_prefix" "$project_prefix")" || {
      local rc=$?
      [[ $rc -eq 1 ]] && _ui__log "Error: No parent branch found containing subtask entry for '$task_id'."
      exit 1
    }

    _ui__log "Propagating parent ($strategy) into task before checkout..."
    "$SCRIPT_DIR/propagate" \
      --from "$parent_bookmark" \
      --to "$task_id" \
      --"$strategy" \
      --repo "$repo"

    # If the working copy was clean going in, it must still be clean. Skipped under
    # --force, where a dirty working copy was explicitly permitted up front, and for
    # brand-new worktrees, which do not exist on disk yet.
    if [[ "$force" != true ]] && [[ "$new_worktree" != true ]] && ! _worktree__check_clean "$target_worktree"; then
      _ui__log "Error: Working copy not clean after propagation."
      exit 1
    fi
  fi

  # Read task frontmatter from the bookmark (after any propagation, so the values
  # reflect the branch's current tip).
  local task_file_content task_title task_status
  task_file_content="$(_task__read_file "$repo" "$task_id" "$task_file")" || true
  task_title="$(_frontmatter__parse_quoted_field "$task_file_content" "title")"
  task_status="$(_frontmatter__parse_field "$task_file_content" "status")"

  # Determine if a status-updating checkout commit is needed.
  # Status TODO means the task hasn't been initialized via checkout yet.
  # (TASK.md may exist on the branch via ancestor inheritance but point to a different task.)
  # Status DONE means the task was completed and is now being reopened: the commit returns
  # the task to IN-PROGRESS on its existing branch. Nothing is pulled from the parent branch
  # (use --rebase/--merge for that).
  local needs_begin=false
  local reopening=false
  if [[ "$task_status" == "TODO" ]]; then
    needs_begin=true
  elif [[ "$task_status" == "DONE" ]]; then
    needs_begin=true
    reopening=true
  fi

  # Perform the checkout
  if [[ "$new_worktree" == true ]]; then
    _ui__log "Creating workspace: $target_worktree"
    _worktree__create "$repo" "$task_id" "$target_worktree" "$task_id"
    # Plant .tt/workspace symlink in the new worktree.
    # Note: history lives in the canonical repo only.
    mkdir -p "$target_worktree/$(_path__metadata)"
    if [[ -L "$repo/$(_path__metadata 'workspace')" ]]; then
      _workspace__set_dir "$target_worktree" "$(_workspace__get_dir "$repo")"
    fi
  else
    # Existing workspace — the dedicated one under --worktree, otherwise the
    # one this command runs in: move its working copy to a new commit on top
    # of the task bookmark.
    _worktree__start_working_copy "$target_worktree" "$task_id"
  fi

  # Create the checkout commit (first checkout, or reopening a completed task)
  if [[ "$needs_begin" == true ]]; then
    if [[ "$reopening" == true ]]; then
      _ui__log "Reopening completed task: $task_id"
    else
      _ui__log "Initializing task: $task_id"
    fi

    # Create TASK.md symlink in the worktree root (idempotent when reopening)
    local task_file_rel
    task_file_rel="$(_path__task_file "$task_slug")"
    ln -sf "$task_file_rel" "$target_worktree/$TT_TASK_SYMLINK_FILENAME"
    _ui__log "Created $TT_TASK_SYMLINK_FILENAME -> $task_file_rel"

    # Update status to IN-PROGRESS in the task file
    local tmpfile
    tmpfile="$(mktemp)"
    awk '
      /^---$/ { n++; print; next }
      n == 1 && /^status:/ { print "status: IN-PROGRESS"; next }
      { print }
    ' "$target_worktree/$task_file" > "$tmpfile"
    mv "$tmpfile" "$target_worktree/$task_file"

    # Record the status change as the checkout commit — which leaves a clean
    # working copy on top of it — then advance the bookmark onto that commit,
    # named by the ID it resolved to rather than by the working copy's position.
    _worktree__commit_working_copy "$target_worktree" \
      "$(_commit__format_message "task" "checkout" "$task_id" "$task_title")"
    local checkout_commit
    checkout_commit="$(_worktree__resolve_working_copy_parent "$target_worktree")"
    _task__advance_branch "$repo" "$task_id" "$checkout_commit"
  fi

  # Update HEAD symlink and fire post-checkout hook.
  # With --worktree without --switch: run hooks but skip HEAD update.
  if [[ "$worktree_flag" != true || "$switch_flag" == true ]]; then
    _worktree__switch "$repo" "${workspace_dir:-}" "$task_id" \
      "$target_worktree" "$current_worktree" "$previous_task_id"
  else
    _hook__run "$repo" "pre-checkout" true "$current_worktree" "${workspace_dir:-}" \
      "TT_TASK_ID=$task_id" "TT_TASK_BRANCH=$task_id" \
      "TT_PREVIOUS_TASK_ID=${previous_task_id}" "TT_PREVIOUS_TASK_BRANCH=${previous_task_branch}"
    # (no HEAD update)
    _hook__run "$repo" "post-checkout" false "$target_worktree" "${workspace_dir:-}" \
      "TT_TASK_ID=$task_id" "TT_TASK_BRANCH=$task_id" \
      "TT_PREVIOUS_TASK_ID=${previous_task_id}" "TT_PREVIOUS_TASK_BRANCH=${previous_task_branch}"
  fi

  # Run setup hook for new worktrees (optional / non-blocking)
  if [[ "$new_worktree" == true ]]; then
    _hook__run "$repo" "setup" false "$target_worktree" "${workspace_dir:-}" \
      "TT_TASK_ID=$task_id" \
      "TT_BRANCH=$task_id"
  fi

  # Commit transaction (records after-op for undo)
  _history__commit_transaction "$repo"

  if [[ -n "$previous_task_id" ]]; then
    _ui__log "  Switched from: $previous_task_id"
  fi
  _ui__log "Checked out: $task_id"
  if [[ "$worktree_flag" == true ]]; then
    _ui__log "  Worktree: $target_worktree"
  fi

  # Print the worktree path to stdout for piping
  printf '%s\n' "$target_worktree"
}

main "$@"
