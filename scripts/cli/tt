#!/usr/bin/env bash
set -euo pipefail

# tt — task-tree bootstrap CLI dispatcher
#
# Dynamically dispatches to nested subcommands based on filesystem structure:
#   tt <command> [<subcommand> [...]] [args...]
#
# Commands are located via the filesystem:
#   scripts/cli/<command>/<subcommand>/<...>/<executable>
#
# Directories represent namespaces, executables represent final commands.
#
# Usage:
#   tt task create --slug foo --title "Foo"
#   tt task context add --title "Research" --body "..."
#   tt project init /path/to/repo /path/to/virtual
#

readonly SCRIPT_NAME="${0##*/}"

log() {
  printf '%s\n' "$*" >&2
}

# Show help for a namespace (directory) or root
show_namespace_help() {
  local name="${1:-}"
  local dir="$2"
  local show_directories="${3:-true}"

  if [[ -z "$name" ]]; then
    cat >&2 <<EOF
Usage: ${SCRIPT_NAME} <command> [args...]

Dispatch to a tt subcommand. Commands are discovered from
the filesystem under the CLI scripts directory.

Available commands:
EOF
  else
    cat >&2 <<EOF
Usage: tt $name <subcommand> [args...]

Available subcommands:
EOF
  fi

  local found=false
  for f in "$dir"/*; do
    local item="${f##*/}"
    if [[ "$show_directories" == true && -d "$f" ]]; then
      log "  $item/"  # Directory (namespace)
      found=true
    elif [[ -f "$f" && -x "$f" ]]; then
      log "  $item"   # Executable command
      found=true
    fi
  done
  [[ "$found" == false ]] && log "  (none)"
  exit 0
}

usage() {
  local exit_code="${1:-1}"
  cat >&2 <<EOF
Usage: ${SCRIPT_NAME} <command> [args...]
   or: ${SCRIPT_NAME} <alias> [args...]

Dispatch to a tt subcommand. Commands and subcommands are discovered from
the filesystem under the CLI scripts directory.

Examples:
  ${SCRIPT_NAME} task create --slug phase-0 --title "Phase 0"
  ${SCRIPT_NAME} task context add --title "Research" --body "..."
  ${SCRIPT_NAME} project init /path/to/repo /path/to/virtual

Aliases (shorthand for common subcommands):
  ${SCRIPT_NAME} create       →  tt task create
  ${SCRIPT_NAME} checkout     →  tt task checkout
  ${SCRIPT_NAME} checkin      →  tt task checkin
  ${SCRIPT_NAME} show         →  tt task show
  ${SCRIPT_NAME} parent       →  tt task parent
  ${SCRIPT_NAME} propagate    →  tt task propagate
  ${SCRIPT_NAME} checkpoint   →  tt task checkpoint
  ${SCRIPT_NAME} complete     →  tt task complete
  ${SCRIPT_NAME} delete       →  tt task delete
  ${SCRIPT_NAME} tree         →  tt task tree
  ${SCRIPT_NAME} rename       →  tt task rename
  ${SCRIPT_NAME} move         →  tt task move
  ${SCRIPT_NAME} add-context  →  tt task context add
  ${SCRIPT_NAME} get-context  →  tt task context get
  ${SCRIPT_NAME} list-context →  tt task context list
  ${SCRIPT_NAME} delete-context → tt task context delete
  ${SCRIPT_NAME} prompt       →  tt task prompt
  ${SCRIPT_NAME} init         →  tt workspace init
  ${SCRIPT_NAME} switch       →  tt workspace switch
  ${SCRIPT_NAME} branch       →  tt workspace branch
  ${SCRIPT_NAME} worktree     →  tt workspace worktree
  ${SCRIPT_NAME} current      →  tt task current
  ${SCRIPT_NAME} edit         →  tt task edit

EOF
  exit "$exit_code"
}

main() {
  local script_dir
  script_dir="$(cd "$(dirname "$0")" && pwd)"

  # Resolve top-level aliases before dispatching
  case "${1:-}" in
    init)        set -- workspace init        "${@:2}" ;;
    switch)      set -- workspace switch      "${@:2}" ;;
    branch)      set -- workspace branch      "${@:2}" ;;
    worktree)    set -- workspace worktree    "${@:2}" ;;
    current)     set -- task     current      "${@:2}" ;;
    edit)        set -- task     edit         "${@:2}" ;;
    create)      set -- task     create       "${@:2}" ;;
    checkout)    set -- task     checkout     "${@:2}" ;;
    checkin)     set -- task     checkin      "${@:2}" ;;
    show)        set -- task     show         "${@:2}" ;;
    parent)      set -- task     parent       "${@:2}" ;;
    propagate)   set -- task     propagate    "${@:2}" ;;
    checkpoint)  set -- task     checkpoint   "${@:2}" ;;
    complete)    set -- task     complete     "${@:2}" ;;
    delete)      set -- task     delete       "${@:2}" ;;
    tree)        set -- task     tree         "${@:2}" ;;
    rename)      set -- task     rename       "${@:2}" ;;
    move)        set -- task     move         "${@:2}" ;;
    add-context)  set -- task     context add   "${@:2}" ;;
    get-context)  set -- task     context get   "${@:2}" ;;
    list-context) set -- task     context list  "${@:2}" ;;
    delete-context) set -- task context delete "${@:2}" ;;
    prompt)      set -- task     prompt       "${@:2}" ;;
  esac

  if [[ $# -ge 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
    usage 0
  fi

  if [[ $# -eq 0 ]]; then
    log "Error: ${SCRIPT_NAME} requires at least <command>"
    usage
  fi

  # Dynamic dispatch: walk the command hierarchy
  local current_path="$script_dir"
  local accumulated_name=""
  local -a command_parts=()

  # Use shift to iterate through arguments instead of indirect expansion
  while [[ $# -gt 0 ]]; do
    local arg="$1"
    shift
    local next_path="$current_path/$arg"

    if [[ -d "$next_path" ]]; then
      # Directory → continue to next level (namespace)
      if [[ -n "$accumulated_name" ]]; then
        accumulated_name="$accumulated_name $arg"
      else
        accumulated_name="$arg"
      fi
      current_path="$next_path"
      command_parts+=("$arg")
    elif [[ -f "$next_path" && -x "$next_path" ]]; then
      # Executable file → dispatch
      if [[ -n "$accumulated_name" ]]; then
        accumulated_name="$accumulated_name $arg"
      else
        accumulated_name="$arg"
      fi

      # Check if next argument is help flag for this command
      if [[ $# -ge 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
        shift
        export COMMAND_NAME="$accumulated_name"
        exec "$next_path" "$@"
      fi

      # Dispatch to the final command
      export COMMAND_NAME="$accumulated_name"
      exec "$next_path" "$@"
    else
      # Check if this is a help request for a namespace
      if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        # Show help for the current namespace
        show_namespace_help "$accumulated_name" "$current_path" "true"
        exit 0
      fi

      # Neither directory nor executable → error
      if [[ -z "$accumulated_name" ]]; then
        log "Error: ${SCRIPT_NAME}: command not found: $arg"
      else
        log "Error: ${SCRIPT_NAME}: subcommand not found: $arg"
      fi
      exit 1
    fi
  done

  # If we get here, we've exhausted all arguments and landed on a directory
  # → show namespace help
  show_namespace_help "${accumulated_name:-root}" "$current_path"
}

main "$@"