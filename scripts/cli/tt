#!/usr/bin/env bash
set -euo pipefail

# tt — task-tree bootstrap CLI dispatcher
#
# Dispatches to subcommands based on the first two arguments:
#   tt <command> <subcommand> [args...]
#
# Subcommands are located via the filesystem:
#   scripts/cli/<command>/<subcommand>
#
# Usage:
#   tt task create --slug foo --title "Foo"
#   tt project init /path/to/repo /path/to/virtual
#

readonly SCRIPT_NAME="${0##*/}"

log() {
  printf '%s\n' "$*" >&2
}

usage() {
  local exit_code="${1:-1}"
  cat >&2 <<EOF
Usage: ${SCRIPT_NAME} <command> <subcommand> [args...]
   or: ${SCRIPT_NAME} <alias> [args...]

Dispatch to a tt subcommand. Commands and subcommands are discovered from
the filesystem under the CLI scripts directory.

Examples:
  ${SCRIPT_NAME} task create --slug phase-0 --title "Phase 0"
  ${SCRIPT_NAME} project init /path/to/repo /path/to/virtual

Aliases (shorthand for common subcommands):
  ${SCRIPT_NAME} create       →  tt task create
  ${SCRIPT_NAME} checkout     →  tt task checkout
  ${SCRIPT_NAME} checkin      →  tt task checkin
  ${SCRIPT_NAME} show         →  tt task show
  ${SCRIPT_NAME} parent       →  tt task parent
  ${SCRIPT_NAME} propagate    →  tt task propagate
  ${SCRIPT_NAME} checkpoint   →  tt task checkpoint
  ${SCRIPT_NAME} complete     →  tt task complete
  ${SCRIPT_NAME} delete       →  tt task delete
  ${SCRIPT_NAME} list         →  tt task list
  ${SCRIPT_NAME} add-context  →  tt task add-context
  ${SCRIPT_NAME} switch       →  tt workspace switch

EOF
  exit "$exit_code"
}

main() {
  local script_dir
  script_dir="$(cd "$(dirname "$0")" && pwd)"

  # Resolve top-level aliases before dispatching
  case "${1:-}" in
    switch)      set -- workspace switch      "${@:2}" ;;
    create)      set -- task     create       "${@:2}" ;;
    checkout)    set -- task     checkout     "${@:2}" ;;
    checkin)     set -- task     checkin      "${@:2}" ;;
    show)        set -- task     show         "${@:2}" ;;
    parent)      set -- task     parent       "${@:2}" ;;
    propagate)   set -- task     propagate    "${@:2}" ;;
    checkpoint)  set -- task     checkpoint   "${@:2}" ;;
    complete)    set -- task     complete     "${@:2}" ;;
    delete)      set -- task     delete       "${@:2}" ;;
    list)        set -- task     list         "${@:2}" ;;
    add-context) set -- task     add-context  "${@:2}" ;;
  esac

  if [[ $# -ge 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
    usage 0
  fi

  if [[ $# -eq 0 ]]; then
    log "Error: ${SCRIPT_NAME} requires <command> and <subcommand>"
    usage
  fi

  if [[ $# -eq 1 ]] || { [[ $# -eq 2 ]] && [[ "$2" == "--help" || "$2" == "-h" ]]; }; then
    local command="$1"
    local command_dir="$script_dir/$command"

    if [[ ! -d "$command_dir" ]]; then
      log "tt: command not found: $command"
      exit 1
    fi

    log "${SCRIPT_NAME} $command <subcommand> [args...]"
    log ""
    log "Available subcommands:"
    local found=false
    for f in "$command_dir"/*; do
      if [[ -f "$f" && -x "$f" ]]; then
        log "  $(basename "$f")"
        found=true
      fi
    done
    [[ "$found" == false ]] && log "  (none)"
    exit 0
  fi

  local command="$1"
  local subcommand="$2"
  shift 2

  local command_dir="$script_dir/$command"
  local subcommand_script="$command_dir/$subcommand"

  if [[ ! -d "$command_dir" ]]; then
    log "tt: command not found: $command"
    exit 1
  fi

  if [[ ! -f "$subcommand_script" ]] || [[ ! -x "$subcommand_script" ]]; then
    log "tt: subcommand not found: $subcommand"
    exit 1
  fi

  exec "$subcommand_script" "$@"
}

main "$@"
